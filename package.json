{
  "name": "hymnal",
  "version": "0.3.0",
  "private": true,
  "description": "multilingual christian hymnal",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "build:content": "bun scripts/build-content.ts",
    "import": "bun scripts/import.ts",
    "lint:md": "markdownlint-cli2 --fix",
    "lint:ts": "biome lint --write .",
    "lint": "bun run lint:md && bun run lint:ts",
    "format:md": "prettier --write \"**/*.md\"",
    "format:ts": "biome format --write .",
    "format": "bun run format:md && bun run format:ts",
    "typecheck": "bun run tsc -b",
    "check:md": "prettier --check \"**/*.md\" && markdownlint-cli2",
    "check:ts": "biome check .",
    "check": "bun run check:md && bun run check:ts && tsc -b && vitest run",
    "cqa:fix": "bun run format && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.3.289",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "markdownlint-cli2": "^0.18.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
