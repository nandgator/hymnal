{
  "number": 1526,
  "title": "എന്നിൽ അടങ്ങാത്ത നിൻ സ്തുതി",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നിൽ അടങ്ങാത്ത നിൻ സ്തുതി",
        "ഞാനെന്നും പാടിടുമേ",
        "ഇന്നാൾ വരെയും എൻ യാത്രയിൽ",
        "നീ ചെയ്ത നന്മക്കായ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആകാശവീഥികളും",
        "സ്വർഗ്ഗാധിസ്വർഗ്ഗങ്ങളും",
        "ഭൂമിയിൽ കാണുന്നതെല്ലാം",
        "കർത്താവേ നിന്നെ വാഴ്ത്തും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കാറ്റും കൊടുങ്കാറ്റും",
        "മഞ്ഞും മഴയുമെല്ലാം",
        "ഭൂമിയിൽ കാണുന്നതെല്ലാം",
        "കർത്താവേ നിന്നെ വാഴ്ത്തും"
      ]
    }
  ],
