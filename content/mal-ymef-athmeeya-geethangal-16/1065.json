{
  "number": 1065,
  "title": "മമ കാന്തനെ ഒന്നു കാണുവാൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മമ കാന്തനെ ഒന്നു കാണുവാൻ",
        "മനം വെമ്പിടുന്നേ പ്രിയാ",
        "എന്റെ ഖേദം തീർത്തെന്നെ",
        "ചേർത്തിടുവാൻ എന്നു വന്നിടും നീ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിന്നോടൊന്നിച്ചുളള വാസമോർക്കുമ്പോൾ",
        "ഉളളം തുളളുന്നേ",
        "എന്റെ ആത്മനാഥനെ",
        "കണ്ടു നിർവൃതി പൂകിടുവതെന്നോ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മണ്മറഞ്ഞ ശുദ്ധരും ശേഷം സിദ്ധരും",
        "ഒത്തുചേരുന്നാ",
        "പൊൻപുലരി നാളിനായി",
        "കാത്തിടുന്നു ഞാൻ എന്നു വന്നിടും നീ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
