{
  "number": 1115,
  "title": "പാപത്തിൻ ഫലം നരകം...",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുരാജൻ വരുവാൻ",
        "ഇനിയൽപ്പകാലം താൻ",
        "മോക്ഷലോകം ചേർന്നിടും നാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപത്തിൻ ഫലം നരകം...",
        "ഓ! പാപി ഭയമില്ലയോ?",
        "കാണുന്നതെല്ലാം ക്ഷണികം...",
        "കാണാത്തതല്ലോ ശാശ്വതം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിന്നാത്മരക്ഷ തളളി നീ...",
        "ലോകസുഖങ്ങൾ തേടിയാൽ",
        "നിൻജീവൻ പോകും നേരത്തിൽ...",
        "ഒരു കാശുകൂടെ വരുമോ?"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലോകത്തിൻ വെറും മായയിൽ...",
        "നിൻകാലമെല്ലാം തീരുമേ",
        "ഓ! ദൈവകോപം വരും മുൻ...",
        "നിന്നേശുവിന്നരികിൽ വാ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിൻപേർക്കു രക്തനദികൾ...",
        "ഒഴുകുന്നു കാൽവറിയിൽ",
        "നിൻ പാപമെല്ലാം നീങ്ങിപ്പോം...",
        "അതിൽ സ്നാനം ചെയ്തിടുകിൽ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "മാ പാപിയായ എന്നെയും...",
        "രക്ഷിച്ചു ദൈവസുതൻ",
        "ഓ! പാപി നീയും ഓടിവാ...",
        "നിന്നെയുമവൻ ചേർത്തിടും"
      ]
    }
  ],
