{
  "number": 401,
  "title": "ഞാൻ കർത്താവിനായ് പാടും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഞാൻ കർത്താവിനായ് പാടും",
        "ജീവിച്ചിടും നാളെല്ലാം",
        "ദൈവമഹത്വം കൊണ്ടാടും",
        "കീർത്തിക്കും തൻവാത്സല്യം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഭാരമുളേളാർ മനമല്ല",
        "ദൈവാത്മാവിൻ ലക്ഷണം",
        "സാക്ഷാൽ അഭിഷിക്തർക്കെല്ലാ",
        "കാലത്തും സന്തോഷിക്കാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ദൈവമുഖത്തിൻമുമ്പാകെ",
        "വീണയാലെ സ്തുതിപ്പാൻ",
        "യേശുവിന്റെ രക്തത്താലെ",
        "എന്നെ പ്രാപ്തൻ ആക്കി താൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കേൾക്ക ദൂതന്മാരിൻ ഗാനം",
        "ബേത്ലഹേമിൻ വയലിൽ",
        "നോക്കുക പിതാവിൻ ദാനം",
        "ചേരുക സംഗീതത്തിൽ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പാലും തേനും ഒഴുകിടും",
        "നല്ലൊർ രാജ്യം എന്റേതാം",
        "ആശ്വാസങ്ങൾ നിറഞ്ഞിടും",
        "ക്രിസ്തൻ മാർവ്വെൻ പാർപ്പിടം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "പാടും ഞാൻ സന്തോഷത്താലെ",
        "ഉളളം എല്ലാം തുളളുമ്പോൾ",
        "പാടും എന്നെ അഗ്നിയാലെ",
        "ശോധന ചെയ്തിടുമ്പോൾ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "അത്തിവൃക്ഷം വാടിയാലും",
        "മുന്തിരിങ്ങാ വളളിയും",
        "ഒന്നും നൽകാതിരുന്നാലും",
        "ഞാൻ കർത്താവിൽ പുകഴും"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "എൻനിക്ഷേപം സ്വർഗ്ഗത്തിങ്കൽ",
        "ആകയാൽ ഞാൻ ഭാഗ്യവാൻ",
        "ലോകരുടെ ദുഃഖത്തിങ്കൽ",
        "എനിക്കുണ്ടോ ദുഃഖിപ്പാൻ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "ദൈവത്തിങ്കലെ സന്തോഷം",
        "ആശ്രിതരിൻ ബലമാം",
        "ആശയറ്റുപോയ ക്ലേശം",
        "ദൂരത്തെറിയുക നാം"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "ഹല്ലേലുയ്യാ ദൈവത്തിന്നും",
        "ഹല്ലേലുയ്യാ പുത്രന്നും",
        "ഹല്ലേലുയ്യാ ആത്മാവിന്നും",
        "ഇന്നും സർവ്വകാലത്തും"
      ]
    }
  ],
