{
  "number": 1177,
  "title": "നിമിഷങ്ങൾ നിമിഷങ്ങൾ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നിമിഷങ്ങൾ നിമിഷങ്ങൾ",
        "ജീവിത നിമിഷങ്ങൾ",
        "ഒഴുകുന്നു തിരികെ വരാതെവണ്ണം",
        "കനകക്കിനാവുകൾ",
        "മനതാരിൽ കണ്ടു നീ",
        "മതിമറന്നീശനെ മറന്നിടല്ലെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മനസ്സിന്റെ മണിയറ വാതിൽ തുറന്നു",
        "കരുണപ്രകാശമെ വഴിതെളിക്കൂ",
        "കനിവാർന്ന രക്ഷകൻ",
        "കരവല്ലരികൾ നീട്ടി",
        "വിരിവാർന്ന കൃപയാൽ",
        "അണയ്ക്കും നിന്നെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഇരുളിന്റെ വഴിത്താരിൽ",
        "സ്നേഹത്തിൻ ദീപം",
        "തിരുക്കൈകളാൽ തെളിയിച്ച",
        "ദേവൻ പുതുസൃഷ്ടിയാക്കിടും",
        "കളങ്കങ്ങൾ പോക്കിടും കുരിശിന്റെ",
        "നിഴലിൽ നയിക്കും നിന്നെ"
      ]
    }
  ],
