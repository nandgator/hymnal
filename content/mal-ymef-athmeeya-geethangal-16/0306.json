{
  "number": 306,
  "title": "കാൽവറിയിൽ കാണും സ്നേഹമത്ഭുതം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കാൽവറിയിൽ കാണും സ്നേഹമത്ഭുതം",
        "വർണ്ണ്യമല്ലഹോ അതെന്റെ നാവിനാൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപത്തിൽനിന്നെന്നെ",
        "വീണ്ടെടുത്ത സ്നേഹമേ",
        "പാവനനിണം ചൊരിഞ്ഞ",
        "ക്രൂശിൻ സ്നേഹമേ",
        "എൻ മനം കവർന്നു നീ അതുല്യസ്നേഹമേ",
        "മാറ്റമില്ലാ ദിവ്യസ്നേഹം എത്ര അത്ഭുതം!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീങ്ങിപ്പോകും",
        "പർവ്വതങ്ങൾ കുന്നുകളിവ",
        "കാണുമീ പ്രപഞ്ചവും ധനം മഹിമയും",
        "മർത്യസ്നേഹം മാറിടും ക്ഷണത്തിലെങ്കിലും",
        "മാറ്റമില്ലാ ദിവ്യസ്നേഹം എത്ര അത്ഭുതം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മൃത്യുവിന്റെ ബന്ധനം",
        "തകർത്ത സ്നേഹമേ",
        "ശത്രുവിന്റെ ശക്തിയെ",
        "ജയിച്ച സ്നേഹമേ",
        "മർത്യരിൽ മരണഭീതി",
        "നീക്കും സ്നേഹമേ",
        "മാറ്റമില്ലാ ദിവ്യസ്നേഹം എത്ര അത്ഭുതം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വാനമേഘേ സ്വർപ്പൂരേ",
        "കരേറിപ്പോയവൻ",
        "ഇന്നും എന്നും കൂടെയുളള",
        "നല്ല സ്നേഹിതൻ",
        "എന്നെ വേഗം ആനയിക്കും",
        "സ്വർഗ്ഗഗേഹത്തിൽ",
        "ദിവ്യസ്നേഹം എത്ര അത്ഭുതം"
      ]
    }
  ],
