{
  "number": 828,
  "title": "യേശു എന്നാശ്രയമാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു എന്നാശ്രയമാം",
        "ക്രിസ്തേശു എന്നാശ്രയമാം",
        "അവനനുഗ്രഹകരങ്ങൾ",
        "നീട്ടിയെന്നെത്തൻ",
        "അരികിലണച്ചിടുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദാഹത്തെപ്പെരുക്കും ജലമല്ലോ",
        "ഇഹലോകം കൊടുക്കും സുഖമെല്ലാം",
        "സ്നേഹത്തിന്നുറവിടമേശുവത്രേയെൻ",
        "ദാഹത്തെത്തീർക്കും ജീവജലം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വൈരികളെതിരായ് നിരന്നിടിലും",
        "മമ സ്നേഹിതരെന്നെ മറന്നിടിലും",
        "മറക്കുകിലേശു മനസ്സലിവോടെ",
        "മറച്ചിടും സ്നേഹച്ചിറകടിയിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ജഡത്തിലെ ശൂലം മാറാതാം",
        "ദൈവജനത്തിനു ശോധന തീരാതാം",
        "ബലം തരും സഹിക്കാൻ",
        "കൃപ തരുമതിനാൽ",
        "ബലഹീനതയിൽ പുകഴും ഞാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "മന്നിതിലില്ല സ്ഥിരവാസം",
        "നമുക്കുന്നത നാടാമവകാശം",
        "വന്നിടുമേശു തന്നിടുമന്നു മിന്നിടും",
        "ദേഹം തന്നുടൽപോൽ"
      ]
    }
  ],
