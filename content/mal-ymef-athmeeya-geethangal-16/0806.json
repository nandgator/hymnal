{
  "number": 806,
  "title": "എൻയേശു എനിക്കായ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻയേശു എനിക്കായ്",
        "കരുതിടുമ്പോൾ - പിന്നെ",
        "എനിക്കൊരു കുറവുമില്ലെൻ മനമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപികളിൽ പരമൻപു കലർന്നവൻ",
        "പാരിതിൽ മനുസുതനായ് വന്നവൻ",
        "ജീവനെത്തന്നവൻ ചാവിനെ വെന്നവൻ",
        "ജീവനിലുയിർത്തവൻ",
        "വൈരിയെ തകർത്തവൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കൂരിരുൾ വഴികളിലായി",
        "ഞാൻ വലയുകിൽ",
        "കൂടെയുണ്ടിനിയവനെന്നരികിൽ",
        "കന്മഷമകറ്റും കണ്ണുനീർ തുടയ്ക്കും",
        "കൈവിടാതൊടുവോളം",
        "നൽവഴിയിൽ നടത്തും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സങ്കടത്തിൽ സഖിയും",
        "സർവ്വ സഹായിയും",
        "സദ്ഗുരുനാഥനും നായകനും",
        "എൻജീവയപ്പവുമൻപെഴുമപ്പനും",
        "സർവ്വവുമെനിക്കവൻ സങ്കടമില്ലിനി"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വാനവും ഭൂമിയുമാകൃതി ചെയ്തവൻ",
        "താനെനിക്കാശ്രയം ഭയമെന്തിന്നായ്?",
        "വയലിലെ താമര വളരുവതില്ലയോ?",
        "വാനിലെപ്പറവകൾ പുലരുവതില്ലയോ?"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പിമ്പിലുളളതിനെ ഞാൻ",
        "പൂർണ്ണമായ് മറന്നും",
        "മുമ്പിലുളളതിന്നായിട്ടാഞ്ഞുകൊണ്ടും",
        "പരമവിളിയുടെ ഫലമെഴും വിരുതിനെ",
        "ക്കരുതിയെൻ ലാക്കിനെ",
        "നോക്കി ഞാനോടുമേ"
      ]
    }
  ],
