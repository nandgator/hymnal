{
  "number": 1012,
  "title": "ചേരുമുയിർപ്പിൻ പ്രഭാതേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചേരുമുയിർപ്പിൻ പ്രഭാതേ",
        "ദേഹം ദേഹികൾ തമ്മിൽ",
        "ഖേദം രോഗം മൃത്യുവില്ല ഹാ! മേലിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദേഹമൽപ്പനേരം മാത്രം",
        "മണ്ണിലുറങ്ങിടേണം",
        "കാഹളം ധ്വനിക്കുവോളം വിശ്രാമം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കല്ലറകളന്നു നൽകും",
        "സർവ്വമൃത്യരെയും ഹാ!",
        "താതൻ മാതാ മക്കൾ വീണ്ടും ചേർന്നിടും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദേഹദേഹികൾ ചേർന്നൊന്നായ്",
        "ക്രിസ്തൻ സ്വന്തഛായയിൽ",
        "തേജസ്സോടുണർന്നു വാഴും തൃപ്തരായ്"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
