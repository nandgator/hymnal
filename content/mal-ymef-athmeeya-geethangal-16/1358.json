{
  "number": 1358,
  "title": "പരമ് പിതാ കീ ഹം സ്തുതി ഗായേം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പരമ് പിതാ കീ ഹം സ്തുതി ഗായേം",
        "വോ ഹീ ഹെ ജൊ ബചാതാ ഹമേം",
        "സാരെ പാപോം കൊ കര്താ ക്ഷമാ",
        "സാരെ രോഗാം കൊ കര്താ ചംഗാ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ധന്യവാദ് ദെം ഉസ്കെ ആസനോം മെ",
        "ആനന്ദ് സെ ആയേ ഉസകെ ചരണോം മേം",
        "സംഗീത് ഗാ കർ ഖുശി സെ",
        "മുക്തി കി ചട്ടാൻ കൊ ജയ് ലല് കാരെം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വഹീ ഹമാരാ ഹെ പരമ് പിതാ",
        "തരസ് ഖാതാ ഹെ സർവ് സദാ",
        "പൂരബ് സെ പശ്ചിം ഹെ ജിത് നീ ദൂർ",
        "ഉത് നെ ഹീ ദൂർ കിയെ ഹമാരെ ഗുനാഹ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഘോസ് ലെ കൊ ബാർ ബാർ തൊഡ്കർ ഉസ്നെ",
        "ചാഹാ കി സീഖെ ഹമ് ഉഡ്നാ ഉഡ്സെ",
        "പരോം പർ ഉഠായാ ഉകാബ് കീ തരഹ്",
        "താകി ഹമ്കോ ചോട് നാ ലഗെ"
      ]
    }
  ],
