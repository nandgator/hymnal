{
  "number": 287,
  "title": "സ്തോത്രങ്ങൾ പാടി ഞാൻ വാഴ്ത്തിടുമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്തോത്രങ്ങൾ പാടി ഞാൻ വാഴ്ത്തിടുമേ",
        "ദേവാധിദേവനെ രാജാധിരാജാവെ",
        "വാഴ്ത്തി വണങ്ങിടുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അത്ഭുതനിത്യസ്നേഹം",
        "എന്നിൽ സന്തതം തന്നിടും ദൈവസ്നേഹം",
        "എന്നും മാറാത്ത ദിവ്യ സ്നേഹം",
        "എന്നിൽ വസിക്കും സ്നേഹം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജ്യോതിയായ് കാണും സ്നേഹം ഉളളിൽ",
        "ജീവൻ തന്നു എന്നെ വീണ്ടസ്നേഹം",
        "ത്യാഗം സഹിച്ച ക്രൂശിൻ സ്നേഹം",
        "ദിവ്യമധുര സ്നേഹം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മായാലോകത്തിൻ മോഹം തേടി",
        "ശാപമേറ്റ എന്നെ വീണ്ടസ്നേഹം",
        "എന്നെത്തേടിയ ദിവ്യസ്നേഹം",
        "എന്നിൽ പെരുകും സ്നേഹം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ജീവനേകിയ സ്നേഹം സർവ്വ",
        "ലോകത്തിൻ ശാപത്തെ നീക്കും സ്നേഹം",
        "ജീവശക്തിയാം ക്രൂശിൻ സ്നേഹം",
        "ഉളളം കവരും സ്നേഹം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വാക്കുമാറാത്ത സ്നേഹം തിരുവാഗ്ദത്തം",
        "തന്നെന്നെ നിർത്തും സ്നേഹം",
        "സർവ്വ വല്ലഭനാമെൻ നാഥാ!",
        "സ്തോത്രം സ്തുതി നിനക്കേ!"
      ]
    }
  ],
