{
  "number": 660,
  "title": "ഈ വഴി വളരെ ഇടുക്കം ഞെരുക്കം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കഷ്ടതകൾ തീർക്കുവാൻ",
        "സിദ്ധന്മാരെ ചേർക്കുവാൻ",
        "പെട്ടെന്നേശു വന്നിടുമേ",
        "മുട്ടുകൾ തീർത്തിടും കണ്ണുനീർ",
        "തുടയ്ക്കും ദുഃഖമെല്ലാം തീർത്തിടുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഈ വഴി വളരെ ഇടുക്കം ഞെരുക്കം",
        "ആരിതു കടന്നിടുമോ?",
        "കൂട്ടുകാർ ചുരുക്കം സഹായികൾ ചുരുക്കം",
        "ഹാ! ഇതല്ലോ മോക്ഷവഴി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആരുളളു ചാരുവാൻ എൻ",
        "മണവാളനൊഴികെ",
        "ഞെരുക്കമുളളീ മരുവിൽ",
        "ആവശ്യം വളരെ തൻ",
        "വാഗ്ദത്തം ഉണ്ടല്ലോ",
        "ആയതെല്ലാം സത്യമല്ലോ -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മരണം വരെയും തിരുരക്തത്താലും",
        "തിരുവചനം വഴിയും",
        "പരിശുദ്ധാത്മാവിലും പരിശുദ്ധമാകണം",
        "കറ തീരെ ഇല്ലാതെ -"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഞാൻ കുറയുന്നെങ്കിലോ",
        "യേശു എന്നിൽ വളരട്ടെ",
        "മഹത്വം അവനിരിക്കട്ടെ",
        "ഞാനവനായ് ചാകണം",
        "എങ്കിലോ വേണ്ടില്ല",
        "ആയിരങ്ങൾ ജീവിക്കട്ടെ -"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കണ്ണുനീരിൻ താഴ്‌വര നിന്ദകൾ കുറവില്ല",
        "എങ്കിലുമുണ്ടാശ്വാസം",
        "യേശുവിൻ സാക്ഷ്യവും സത്യവചനവും",
        "മാത്രമല്ലൊ വരുത്തുന്നിത്"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "കൂട്ടുകാർ ദുഷിക്കട്ടെ",
        "നാട്ടുകാർ പഴിക്കട്ടെ",
        "യേശു ഇന്നും ജീവിക്കുന്നു",
        "വിട്ടതും വെടിഞ്ഞതും",
        "യേശുവിൻ പ്രബോധനം",
        "അനുസരിച്ചാണല്ലോ ഞാൻ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "കൂലിക്കാരനല്ല ഞാൻ",
        "യേശുവിൻ സ്ഥാനാപതി",
        "തെരഞ്ഞെടുക്കപ്പെട്ടവൻ ഞാൻ",
        "രാജകീയ പുരോഹിതൻ",
        "വിശുദ്ധവംശക്കാരൻ ഞാൻ",
        "സ്വന്തക്കാരനാണല്ലോ ഞാൻ"
      ]
    }
  ],
