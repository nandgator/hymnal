{
  "number": 1093,
  "title": "പാടുവിൻ സഹജരേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പാടുവിൻ സഹജരേ",
        "കൂടുവിൻ കുതുകരായ്",
        "തേടുവിൻ പുതിയ സംഗീതങ്ങളെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാടുവിൻ പൊൻവീണകളെടുത്തു",
        "സംഗീതങ്ങൾ തുടങ്ങിടുവിൻ",
        "പാരിലില്ലതുപോലൊരു രക്ഷകൻ",
        "പാപികൾക്കാശ്രയമായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദേശം ദേശമായ് തേജസ്സിൻ സുവിശേഷ",
        "കാഹളം മുഴക്കിടുവിൻ",
        "യേശുരാജൻ ജയിക്കട്ടെ യെരിഹോ",
        "മതിലുകൾ വീണിടട്ടെ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഓമനപ്പുതുപുലരിയിൽ നാമിനി",
        "ചേരും തൻ സന്നിധിയിൽ",
        "കോമളമാം തിരുമുഖകാന്തിയിൽ",
        "തീരും സന്താപമെല്ലാം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഈ ദൈവം ഇന്നുമെന്നേക്കും",
        "നമ്മുടെ ദൈവമല്ലോ",
        "ജീവകാലം മുഴുവനുമവൻ നമ്മെ",
        "നൽവഴിയിൽ നടത്തും"
      ]
    }
  ],
