{
  "number": 802,
  "title": "ഇമ്പമോടേശുവിൽ തേറും",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "തേറും തേറും തേറും അന്ത്യത്തോളം",
        "ചന്തമായോർ കിരീടമുണ്ടന്ത്യം",
        "ഇമ്പമോടേശുവിൽ തേറും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇമ്പമോടേശുവിൽ തേറും",
        "അൻപോടെ സേവിക്കുമേ",
        "കൃപയിൽ ആത്മാവുറയ്ക്കും",
        "താപമോ ദൂരവേ",
        "ലഘുസങ്കടങ്ങൾ എണ്ണാ -",
        "ലോകസുഖമോ ചണ്ടിയേ!",
        "ചന്തമായോർ കിരീടമുണ്ടന്ത്യം",
        "ഇമ്പമോടേശുവിൽ തേറും -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഇമ്പമോടേശുവിൽ തേറും",
        "തന്നാശ്രയം മാത്രമേ",
        "ദേഹിക്കു നല്ലൊരാഹ്ളാദം",
        "സഹായം പൂർണ്ണമേ",
        "തേജസ്സുളേളാർ സന്തോഷമേ",
        "തേജസ്സിൻ വാഴ്ച സ്ഥാപിച്ചേ",
        "ചന്തമായോർ കിരീടമുണ്ടന്ത്യം",
        "ഇമ്പമോടേശുവിൽ തേറും -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഇമ്പമോടേശുവിൽ തേറും",
        "അമ്പരപ്പൊട്ടുമില്ലേ",
        "കമ്പം കൂടാത്തോർ വിശ്വാസം",
        "നങ്കൂരം പോലുണ്ടേ",
        "വിഷാദം ഏറെ പൊങ്ങുമേ",
        "വൈഷമ്യം നൊടി നേരമേ",
        "ചന്തമായോർ കിരീടമുണ്ടന്ത്യം",
        "ഇമ്പമോടേശുവിൽ തേറും -"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഇമ്പമോടേശുവിൽ തേറും",
        "അന്ത്യശ്വാസം പോം വരെ",
        "ശരീരം പുല്ലുപോൽ വാടും",
        "കാര്യമല്ലേതുമേ",
        "കേടുളേളാർ കൂടു വീഴ്കിലും",
        "നടുങ്ങിപ്പോകാതുണരും",
        "ചന്തമായോർ കിരീടമുണ്ടന്ത്യം",
        "ഇമ്പമോടേശുവിൽ തേറും -"
      ]
    }
  ],
