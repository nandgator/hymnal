{
  "number": 1299,
  "title": "വളരണം വളർന്നു നമ്മൾ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വളരണം വളർന്നു നമ്മൾ",
        "വലിയതാകണം",
        "വചനമെന്ന പാൽ നിരന്തരം കുടിക്കണം",
        "ക്രിസ്തുവെന്ന തലയോളം",
        "നിശ്ചയം നാം വളരണം",
        "ക്രിസ്തുവിന്റെ ദിവ്യ ഭാവം",
        "കൃത്യമായി നിറയേണം"
      ]
    }
  ],
