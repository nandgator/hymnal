{
  "number": 1577,
  "title": "എന്നേശുവേ എൻ രക്ഷകാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നേശുവേ എൻ രക്ഷകാ",
        "നീ മാത്രം നല്ലവൻ",
        "മറ്റാരെയും ഞാൻ കാണുന്നില്ല",
        "ഈ ഭൂവിൽ മിത്രമായ്",
        "ഒന്നുമാത്രം ഞാൻ അറിയുന്നു",
        "ആരെ ഞാൻ വിശ്വസിക്കുന്നു",
        "നീയെൻ ഉപനിധി അന്ത്യം വരെയും",
        "സൂക്ഷിപ്പാൻ ശക്തനും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇന്നുളള വേദന ശോധനയിൽ",
        "കൺകൾ നിറഞ്ഞിടുമ്പോൾ",
        "കണ്ണുനീർ വാർത്താരേശുവേ",
        "നിന്നിലെൻ സന്തോഷം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രോഗത്താൽ ക്ഷീണിതനായിടുമ്പോൾ",
        "ദേഹം തളർന്നിടുമ്പോൾ",
        "നിൻ കൃപയൊന്നെൻ ആശ്രയം",
        "ഹാ എന്തൊരാശ്വാസം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ സ്വന്ത സോദരർ ബന്ധുക്കൾ",
        "മാറിടും നേരമതിൽ",
        "എൻ സ്വന്തമായൊരേശുവേ",
        "നീ മാത്രം മാറാത്തവൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദുഷ്കീർത്തി ഭീഷണി അപമാനം",
        "പെരുകിടും വേളകളിൽ",
        "നിന്ദകൾ സഹിച്ചൊരേശുവേ",
        "നിന്നിലെൻ അഭിമാനം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നഷ്ടങ്ങൾ ക്ലേശങ്ങൾ സഹിച്ചു ഞാൻ",
        "പ്രിയമായ് വളർത്തിയവർ",
        "ക്രൂരമായ് മുറിവേൽപ്പിച്ചകന്നിടുമ്പോൾ",
        "പ്രിയാ നീയും കൈവിടുമോ"
      ]
    }
  ],
