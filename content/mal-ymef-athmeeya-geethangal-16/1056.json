{
  "number": 1056,
  "title": "ദൈവമങ്ങൊരുക്കിടും ഭവനമുണ്ടതിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ദൈവമങ്ങൊരുക്കിടും ഭവനമുണ്ടതിൽ",
        "താമസംകൂടാതെ ഞാനും ചേർന്നിടുമേ",
        "ദൂതസംഘം ആർത്തു പാടും",
        "പുത്തൻപാട്ടുകൾ",
        "ഞാനും ചേർന്നു",
        "ഹല്ലേലുയ്യാ ഗീതം പാടും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇന്നു ഞാൻ പോകുമീ",
        "കൂരിരുൾ പാതയിൽ",
        "എന്നുമെൻ യേശുവെ",
        "നോക്കി നോക്കി പോയിടും",
        "തീരുമെന്റെ ഭീതിയും",
        "മാറുമെൻ അനർത്ഥവും",
        "എൻ പ്രിയനെ കാണും നേരത്തിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഈ മരുയാത്രയിൽ",
        "വീണിടുന്ന വേളയിൽ",
        "യേശുവിന്റെ പൊൻകരം",
        "താങ്ങിടുന്നു നിത്യവും",
        "മാറുമെന്റെ ക്ഷീണവും",
        "തീരുമെന്റെ ക്ലേശവും",
        "സ്വന്ത വീട്ടിൽ ചേരും നാളതിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എന്തിനീ താമസം മൽ -",
        "പ്രിയൻ വന്നിടാൻ",
        "എത്രനാളീ ഭൂമിയിൽ",
        "കാത്തുകാത്തു പാർക്കണം",
        "നേരിലൊന്നു കണ്ടു എന്റെ",
        "കാന്തനോടു ചേരുവാൻ",
        "എൻമനം കൊതിച്ചു കാക്കുന്നേ"
      ]
    }
  ],
