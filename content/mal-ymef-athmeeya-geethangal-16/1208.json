{
  "number": 1208,
  "title": "കാക്കണം ദിനംതോറും",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "കാക്കണം ദിനംതോറും",
        "കരുണയിൽ നീ",
        "കാക്കണം ദിനംതോറും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാക്കണം ലോകത്തിൻ",
        "പോക്കിൽ നിന്നെന്നുടെ",
        "ലാക്കെന്നും നിന്നിലാകുവാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജോലികളിൽ മനോ -",
        "ഭാരമുണ്ടായി ഞാൻ",
        "ജോലിയിൽ മുഴുകിടാതെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നല്ല മനസ്സാക്ഷി എളളളവും വിടാ -",
        "വതല്ലാ സമയം തന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വേദവാക്യങ്ങളെ",
        "ശോധന ചെയ്യുവാൻ",
        "ആദരമരുളിയെന്നെ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "മുന്നമെ ദൈവത്തിൻ",
        "രാജ്യവും നീതിയും",
        "തന്നെയന്വേഷിച്ചിടുവാൻ"
      ]
    }
  ],
