{
  "number": 203,
  "title": "വാഴ്ത്തുവിൻ യഹോവയെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നിത്യം തന്റെ കാരുണ്യം",
        "സത്യം തന്റെ വാഗ്ദത്തം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വാഴ്ത്തുവിൻ യഹോവയെ",
        "കീർത്തിപ്പിൻ തൻ നാമത്തെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തൻ വിശുദ്ധ വചനം",
        "അന്ധതയിൽ വെളിച്ചം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പേയിൻ വാഴ്ച നീക്കുവാൻ",
        "സ്ത്രീയിൻ സന്തതി വന്നാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ചേറ്റിൽ നിന്നുയർത്തുന്നോൻ",
        "തീറ്റിപ്പോറ്റി കാക്കുന്നോൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "യിസ്രായേലിൻ കൂടെ നാം",
        "ക്രിസ്തൻ സ്വന്ത വംശമാം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "കഷ്ടനഷ്ടങ്ങളിലും",
        "രോഗശോകങ്ങളിലും"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "യേശു വീണ്ടുംവന്നിടും",
        "ക്ലേശമാകെ മാറ്റിടും"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "കേൾപ്പിൻ ചെറിയവരേ",
        "ചൊല്ലിൻ വലിയവരേ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "സർവ്വശക്തൻ ഭക്തനേ",
        "ധൈര്യമോടെ പാടുക"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "10.വന്ദിക്ക എന്നാത്മാവേ",
        "നന്ദിയോടീ ദൈവത്തെ"
      ]
    },
    {
      "id": "s11",
      "kind": "stanza",
      "label": "11",
      "lines": [
        "താതപുത്രനാത്മാവാം",
        "യഹോവയ്ക്കെൻ വന്ദനം"
      ]
    }
  ],
