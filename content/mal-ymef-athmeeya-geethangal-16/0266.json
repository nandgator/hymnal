{
  "number": 266,
  "title": "നിത്യമാം നിൻ രക്തധാര",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ധാരയായൊലിച്ച നിന്റെ",
        "ചോരയാൽ നീ താൻ",
        "പാരമാമെൻ പാതകങ്ങൾ",
        "തീരെ മായിച്ചു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നിത്യമാം നിൻ രക്തധാര",
        "സത്യമായ് കാണ്മാൻ",
        "ഇന്നു നീക്കെൻ കണ്ണിൻ മൂടി -",
        "ഒന്നാമതായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജീവബിന്ദു നിന്റെ ചോര ഏവന്നിന്നുമേ",
        "ഉറ്റക്രോധം പറ്റെത്തീർക്കും ഒറ്റമൂലി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വൻകടൽ സമാനമാകും",
        "എൻ കടങ്ങളെ",
        "പറ്റെ വറ്റിച്ചിന്നു തീർക്കും ഒറ്റത്തുള്ളി"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രക്തതുല്യമെന്റെ ദ്രോഹം രക്തധാരയാൽ",
        "വെണ്മയാക്കാമെന്ന ചൊൽ",
        "നീ ഉണ്മയാക്കി"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പാപശക്തി നീക്കുമല്ലോ",
        "നീ പകർന്ന നീർ",
        "പൂർണ്ണശുദ്ധി സാദ്ധ്യമിന്നു",
        "നിർണ്ണയം താൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "സ്തോത്രമെന്നും പാടുവാനായ്",
        "ഇത്ര യോഗ്യത തന്ന",
        "നിന്റെ വീണ്ടെടുപ്പു ഇന്നോർക്കുന്നു"
      ]
    }
  ],
