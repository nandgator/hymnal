{
  "number": 773,
  "title": "കരുതുന്നവൻ ഞാനല്ലയോ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കരുതുന്നവൻ ഞാനല്ലയോ",
        "കലങ്ങുന്നതെന്തിനു നീ",
        "കണ്ണുനീരിന്‍റെ താഴ്‌വരയിൽ",
        "കൈവിടുകയില്ല ഞാൻ നിന്നെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എന്‍റെ മഹത്വം കാണുക നീ",
        "എന്‍റെ കയ്യിൽ തരിക നിന്നെ",
        "എന്‍റെ ശക്തി ഞാൻ നിന്നിൽ",
        "പകർന്നു എന്നും നടത്തിടും കൃപയാൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എല്ലാവരും നിന്നെ മറന്നാൽ",
        "ഞാൻ നിന്നെ മറന്നിടുമോ",
        "എന്‍റെ കരത്തിൽ നിന്നെ വഹിച്ചു",
        "എന്നും നടത്തിടും ധരയിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അബ്രഹാമിന്‍റെ ദൈവമല്ലയോ",
        "അത്ഭുതം ഞാൻ ചെയ്കയില്ലയോ",
        "ചെങ്കടലിലും വഴി തുറപ്പാൻ",
        "ഞാനിന്നു ശക്തനല്ലയോ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
