{
  "number": 1252,
  "title": "മംഗളം മംഗളം മംഗളമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മംഗളം മംഗളം മംഗളമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇന്നു വിവാഹിതരാം... യ്ക്കും... നും",
        "മംഗളം നേരുന്നു ഞങ്ങളീ നൽനേരം",
        "ഭംഗമില്ലാതെ മോദാൽ",
        "ആശിഷം നൽക എന്നും യേശുനാഥാ!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജീവിതപ്പൂവാടിയിൽ",
        "മുല്ലകളാകും നിങ്ങൾ",
        "സൗരഭ്യം വീശട്ടെ! കാന്തി പരത്തട്ടെ!",
        "സൗഭാഗ്യസമ്പൂർണ്ണരായ്",
        "ആശിഷം നൽക എന്നും യേശുനാഥാ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സേവിക്ക യഹോവയെ",
        "നിങ്ങൾ കുടുംബമായി",
        "ജീവിതസാഗര വൻ തിരമാലയിൽ",
        "കൈവിടാ കർത്തനവൻ",
        "ആശിഷം നൽക എന്നും യേശുനാഥാ!"
      ]
    }
  ],
