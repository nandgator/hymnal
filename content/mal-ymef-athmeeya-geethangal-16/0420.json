{
  "number": 420,
  "title": "യേശുവിലെൻ തോഴനെ കണ്ടേൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "തുമ്പം ദുഃഖങ്ങളതിൽ",
        "ആശ്വാസം നൽകുന്നോൻ",
        "എൻഭാരമെല്ലാം ചുമക്കാ -",
        "മെന്നേറ്റതാൽ - ശാരോനിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിലെൻ തോഴനെ കണ്ടേൻ",
        "എനിക്കെല്ലാമായവനെ",
        "പതിനായിരങ്ങളിൽ ഏറ്റം സുന്ദരനെ",
        "ശാരോനിൻ പനിനീർ പുഷ്പം",
        "അവനെ ഞാൻ കണ്ടെത്തിയേ",
        "പതിനായിരങ്ങളിൽ ഏറ്റം സുന്ദരനെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ലോകരെല്ലാം കൈവെടിഞ്ഞാലും",
        "ശോകഭാരം ഏറിയാലും",
        "യേശു രക്ഷാകരൻ താങ്ങും തണലുമായ്",
        "അവനെന്നെ മറുക്കുകില്ല മൃത്യുവിലും കൈവിടില്ല",
        "അവനിഷ്ടം ഞാൻ ചെയ്തെന്നും ജീവിക്കും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മഹിമയിൽ ഞാൻ കിരീടം ചൂടി",
        "അവൻ മുഖം ഞാൻ ദർശിക്കും",
        "അങ്ങു ജീവന്റെ നദി കവിഞ്ഞൊഴുകുമേ",
        "ശാരോനിൻ പനിനീർ പുഷ്പം",
        "അവനെ ഞാൻ കണ്ടെത്തിയേ",
        "പതിനായിരങ്ങളിൽ ഏറ്റം സുന്ദരനെ"
      ]
    }
  ],
