{
  "number": 666,
  "title": "ന്യായാസനത്തിൻ മുമ്പിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ന്യായാസനത്തിൻ മുമ്പിൽ",
        "ഒരുനാളിൽ നിന്നിടുമ്പോൾ",
        "അവനവൻ ചെയ്തതിന്‌",
        "തക്കവണ്ണം ലഭിക്കും",
        "നിന്നോടുകാര്യം തീർക്കുന്ന നാളിൽ",
        "ബലപ്പെട്ടിരിക്കുമോ നിന്റെ കൈകൾ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നല്ലതോ തീയതോ എന്താകിലും",
        "ഈ ശരീരത്തിൽ നാംചെയ്തതിന്‌",
        "തക്കവണ്ണം പ്രാപിക്കേണ്ടതിന്‌",
        "ക്രിസ്തുവിൻമുമ്പാകെ വെളിപ്പെടും നാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പൊന്നു, വെളളി വിലയേറിയതാം",
        "കല്ലു,മരം, വൈക്കോൽ എന്നിവയാൽ",
        "നീ പണിയും പ്രവൃത്തികളെല്ലാം",
        "തീ തന്നെ ശോധന ചെയ്തിടുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വെന്തുപോകാത്ത പ്രവൃത്തികൾക്കു",
        "നിശ്ചയമായും ഫലം ലഭിക്കും",
        "വിതയ്ക്കുന്നതു തന്നെ നീ കൊയ്തിടും",
        "ശോധന ചെയ്യുക ഇന്നു തന്നെ"
      ]
    }
  ],
