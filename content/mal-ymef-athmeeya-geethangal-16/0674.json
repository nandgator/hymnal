{
  "number": 674,
  "title": "ഇന്നെയോളം എന്നെ നടത്തി",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഇന്നെയോളം എന്നെ നടത്തി",
        "ഇന്നെയോളം എന്നെ പുലർത്തി",
        "എന്റെ യേശു എത്ര നല്ലവൻ",
        "അവൻ എന്നെന്നും മതിയായവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്റെ പാപഭാരമെല്ലാം തന്റെ",
        "ചുമലിൽ ഏറ്റുകൊണ്ട്",
        "എനിക്കായ് കുരിശിൽ മരിച്ചു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എന്റെ ആവശ്യങ്ങളറിഞ്ഞ്",
        "ആകാശത്തിൻ കിളിവാതിൽ തുറന്ന്",
        "എല്ലാം സമൃദ്ധിയായ് നൽകിടുന്ന",
        "എന്റെ യേശു നല്ല ഇടയൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മനോഭാരത്താൽ വലഞ്ഞ്",
        "മനോവേദനയാൽ നിറഞ്ഞ്",
        "മനമുരുകി ഞാൻ കരഞ്ഞിടുമ്പോൾ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രോഗശയ്യയിലെനിക്കു വൈദ്യൻ",
        "ശോകവേളയിൽ ആശ്വാസകൻ",
        "കൊടുംവെയിലതിൽ തണലുമവൻ",
        "എന്റെ യേശു എത്ര വല്ലഭൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഒരു നാളും കൈവിടില്ല",
        "ഒരു നാളും ഉപേക്ഷിക്കില്ല",
        "ഒരുനാളും മറക്കുകില്ല",
        "എന്റെ യേശു എത്ര വിശ്വസ്തൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എന്റെ യേശു വന്നിടുമ്പോൾ",
        "തിരുമാർവ്വോടണഞ്ഞിടും ഞാൻ",
        "പോയപോൽ താൻ വേഗം വരും"
      ]
    }
  ],
