{
  "number": 584,
  "title": "രക്തം നിറഞ്ഞോരുറവ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വിശ്വാസത്താൽ ഞാൻ നോക്കുന്നു",
        "യേശുവിൻ ക്രൂശിന്മേൽ",
        "എൻ പാപമെല്ലാം ചുമന്നു",
        "ഈ എൻ ഇമ്മാനുവേൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "രക്തം നിറഞ്ഞോരുറവ",
        "ഉണ്ടല്ലോ പാപിക്കായ്",
        "വിശ്വാസത്തോടെ മുങ്ങുക",
        "എന്നാൽ നീ ശുദ്ധനായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആ കളളനു സന്തോഷമായ്",
        "യേശുവിൻ രക്തത്താൽ",
        "എനിക്കും അനുഭവമായ്",
        "ദൈവത്തിൻ കൃപയാൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യേശുവിൻ മുറിവുകളെ",
        "കണ്ടന്നു മുതൽ ഞാൻ",
        "വീണ്ടെടുക്കും തൻസ്നേഹത്തെ",
        "തുടങ്ങി സ്തുതിപ്പാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഞാൻ ജീവിക്കും നാളൊക്കെയും",
        "നിൻക്രൂശിൻ മഹത്വം",
        "ആകും എൻ പാട്ടും ധ്യാനവും",
        "ആകും എൻ പ്രസംഗം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നിൻ രക്തത്തിന്റെ ഫലമായ്",
        "ഞാൻ വാഴും സ്വർഗ്ഗത്തിൽ",
        "അവിടെയും നിൻ സ്തുതിക്കായ്",
        "ഞാൻ പാടും ഭക്തിയിൽ"
      ]
    }
  ],
