{
  "number": 1318,
  "title": "മുട്ടുകുത്തി പ്രാര്‍ത്ഥിച്ചാല്‍",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മുട്ടുകുത്തി പ്രാര്‍ത്ഥിച്ചാല്‍",
        "മുട്ടാകെ മാറിപോം",
        "പാട്ടുപാടി പ്രാര്‍ത്ഥിച്ചാല്‍",
        "പാടാകെ മാറിപോം",
        "പ്രാർത്ഥിക്കാം നമുക്കിനീം പ്രാർത്ഥിക്കാം",
        "ദാനിയേലിനെപ്പോള്‍ പ്രാർത്ഥിക്കാം",
        "പ്രവര്‍ത്തിക്കും ദൈവം നിശ്ചയം",
        "പ്രാപിക്കാം സ്വര്‍ഗ്ഗീയ നന്മകള്‍"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    }
  ],
