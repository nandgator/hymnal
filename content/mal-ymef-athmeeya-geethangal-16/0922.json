{
  "number": 922,
  "title": "ആഴത്തിൽ ആഴത്തിൽ വേരൂന്നിടാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആഴത്തിൽ ആഴത്തിൽ വേരൂന്നിടാം",
        "ഉയരത്തിൻ ഫലമാർന്നിടാം",
        "മുപ്പതും അറുപതും നൂറും മേനിയായ്",
        "വലിയൊരു വിളവേകിടാം ഹാ ഹാ ഹാ -"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വചനമായി വന്ന നാഥൻ",
        "ജീവ മുന്തിരിവളളിയായോൻ",
        "അവനോടു ചേർന്നു നാം",
        "നല്ല ഫലമേകും കൊമ്പുകളാം -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വചനത്തെ സ്നേഹിക്കേണം",
        "വചനത്തിൻ ആഴം അറിഞ്ഞിടേണം",
        "കൃപയിൽ വളർന്നിടേണം",
        "ആത്മഫലമെല്ലാം നൽകിടേണം"
      ]
    }
  ],
