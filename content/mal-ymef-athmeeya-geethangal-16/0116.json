{
  "number": 116,
  "title": "എന്നന്തരംഗമേ പാടൂ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്നന്തരംഗമേ പാടൂ",
        "പൊന്നേശുവിൻ ഗീതം",
        "എന്നെ വീണ്ട തൻ സ്നേഹത്തെ",
        "എന്നാളും കീർത്തിക്കാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആശയറ്റിട്ടാർത്തനായി",
        "ക്ലേശിച്ചുകേണു ഞാൻ",
        "ഈശാ! നീയെന്റെ പാതകം",
        "ക്രൂശിൽ വഹിച്ചു ഹാ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എന്നാധികൾ എൻ വ്യാധികൾ",
        "എല്ലാം വഹിപ്പാനായ്",
        "എല്ലായ്പ്പോഴും ചാരെയുള്ളോൻ",
        "ആശ്വാസദായകൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വിണ്ണിലെത്തും നാൾവരെയും",
        "കണ്ണീർ താഴ്വര",
        "മണ്ണിലെ വാസമെങ്കിലും",
        "പൂർണ്ണാനന്ദം നീയേ!"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എൻപേർക്കു പക്ഷവാദമായ്",
        "അൻപെഴുമാചാര്യൻ",
        "ഉന്നതത്തിൽ വാണിടുന്നു",
        "പൂർണ്ണരക്ഷകനായ്"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
