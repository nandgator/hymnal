{
  "number": 1053,
  "title": "രാജാധിരാജൻ വരുന്നിതാ തന്റെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "രാജാധിരാജൻ വരുന്നിതാ തന്റെ",
        "വിശുദ്ധന്മാരെ ചേർത്തിടുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കർത്തൻ വരവിനായ്",
        "കാത്തിരിക്കുന്നേ ഞാൻ",
        "കാരുണ്യനിധിയെ",
        "കാണുവാൻ വെമ്പുന്നേ",
        "കാലങ്ങൾ ദീർഘമാക്കല്ലേ - ഇനി",
        "കാലങ്ങൾ ദീർഘമാക്കല്ലേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വാനവും ഭൂമിയും ഒഴിഞ്ഞുപോകുമെ",
        "നിത്യരാജ്യമെനിക്കായ് നാഥനൊരുക്കുന്നേ",
        "എന്നതിൽ പൂകിടും ഞാൻ - പ്രിയ",
        "എന്നതിൽ പൂകിടും ഞാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പീഡകൾ വന്നാലും ഭയമെനിക്കില്ല",
        "പാടുകൾ സഹിച്ച",
        "ക്രിസ്തു എൻനായകൻ",
        "വൻകൃപ തന്നിടുമെ - തന്റെ",
        "വൻകൃപ തന്നിടുമെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എൻ ദേഹം രോഗത്താൽ",
        "ക്ഷയിച്ചെന്നാകിലും",
        "ദേഹസഹിതനായ് പ്രിയനെ",
        "കാണും ഞാൻ",
        "അവനെന്റെ വൈദ്യനല്ലോ - ഇന്നും",
        "അവനെന്റെ വൈദ്യനല്ലോ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സ്വർഗ്ഗീയ സീയോനിൽ",
        "പ്രിയനോടെന്നും ഞാൻ",
        "വാണിടും നാളിനായ്",
        "കാത്തിടുന്നേ പ്രിയാ",
        "ആമേൻ കർത്താവേ വരണേ - വേഗം",
        "ആമേൻ കർത്താവേ വരണേ"
      ]
    }
  ],
