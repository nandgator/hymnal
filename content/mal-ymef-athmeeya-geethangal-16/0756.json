{
  "number": 756,
  "title": "കരുതിടും കരുതിടും കരുതിടും നാഥൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കരുതിടും കരുതിടും കരുതിടും നാഥൻ",
        "കരതലത്തിൽ ചേർത്തണച്ചു",
        "കാത്തിടും നാഥൻ",
        "കഷ്ടനാളിൽ കൈവിടാതെ",
        "തന്റെ പക്ഷങ്ങൾ -",
        "ക്കുളളിലഭയം തന്നു സാധു",
        "എന്നെ കരുതിടും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മനസ്സുരുകി നീറും നേരം തഴുകിടും",
        "മനസ്സലിഞ്ഞു ഏഴയെന്നെ കരുതിടും",
        "കണ്ണുനീരെല്ലാം കർത്തൻ തുടച്ചിടും",
        "എന്റെയുളളം കുതൂഹലത്താൽ",
        "നിറഞ്ഞു കവിഞ്ഞിടും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മരണനിഴലിൻ വഴികളിൽ തുണവരും",
        "അരിഗണത്തെ ജയിച്ചിടാൻ കൃപതരും",
        "സർവ്വഭീതിയും അകലെ അകറ്റിടും",
        "എന്നെയെന്നും പരിചരിച്ചു",
        "നാഥൻ നടത്തിടും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സുഗന്ധതൈലം എന്റെ",
        "തലയിൽ പകർന്നിടും",
        "പുതിയ കൃപകൾ നാൾകൾ",
        "തോറും തുടർന്നിടും",
        "സ്തോത്രഗീതമെൻ നാവിലുയർന്നിടും",
        "എന്നും നാഥൻ പിരിഞ്ഞിടാ",
        "തെന്നരികിൽ പാർത്തിടും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പരമസീയോൻ പുരിയിൽ",
        "നാഥനൊരുക്കിടും",
        "പുതിയ വീട്ടിൽചെന്നു",
        "ഞാനും ചേർന്നിടും",
        "ദുഃഖമില്ലിനി,മരണമില്ലിനി",
        "നിത്യമോദം അനുഭവിച്ചു",
        "നിത്യം വാഴും ഞാൻ"
      ]
    }
  ],
