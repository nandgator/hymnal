{
  "number": 846,
  "title": "അനുകൂലമോ? ഉലകിൽ പ്രതികൂലമോ?",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അനുകൂലമോ? ഉലകിൽ പ്രതികൂലമോ?",
        "എനിക്കെന്തായാലും എൻ യേശു മതി"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഒരു നാളും അകലാത്ത",
        "സഖിയാണു താൻ",
        "തിരുപ്പാദം തേടും അഗതിക്കു",
        "തുണയാണു താൻ",
        "വരുമോരോ ദുഃഖങ്ങൾ ഭാരങ്ങളിൽ",
        "തെല്ലും പരിഭ്രമം വേണ്ടെനിക്കേശു മതി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദിനം തോറും കരുതുവാൻ",
        "അടുത്തുണ്ടു താൻ",
        "മനം കലങ്ങാതെ അവനി -",
        "ലെന്നവലംബമാം",
        "കനിവേറും കരങ്ങളാൽ കാത്തിടും താൻ",
        "എന്നെ പാലിപ്പാനിതു പോലെ വേറാരുളളു?"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഇരുൾ മൂടും വഴിയിൽ",
        "നല്ലൊളിയാണു താൻ",
        "പകൽ മരുഭൂവിൽ ചുടുവെയിലിൽ",
        "തണലാണു താൻ",
        "വരളുന്ന നാവിനു ജലമാണു താൻ",
        "എന്നിൽ പുതുബലം തരും",
        "ജീവവചസ്സാണു താൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഒരിക്കലെൻ പേർക്കായി മുറിവേറ്റതാം",
        "തിരുവുടൽ നേരിൽ ദർശിച്ചു",
        "വണങ്ങിടും ഞാൻ",
        "മമ കണ്ണീർ തുളളികൾ തോരുമന്നാൾ",
        "മന്നൻ മശിഹതൻ ദീപ്തിയിൽ",
        "നിത്യം വാഴും ഞാൻ"
      ]
    }
  ],
