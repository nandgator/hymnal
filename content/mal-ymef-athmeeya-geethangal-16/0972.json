{
  "number": 972,
  "title": "യഹോവ വാഴുന്നു ഭൂലോകം സകലം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യഹോവ വാഴുന്നു",
        "സന്തോഷിക്കുക നാം",
        "താൻ സത്യദൈവമാകുന്നു",
        "താൻ നിത്യരാജനും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യഹോവ വാഴുന്നു ഭൂലോകം സകലം",
        "തൻ പാദപീഠമാകുന്നു",
        "സ്വർഗ്ഗം സിംഹാസനം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യഹോവ വാഴുന്നു സ്വർ -",
        "ല്ലോകത്തിൽ എല്ലാം",
        "സദാ ഒരുങ്ങി നിൽക്കുന്നു ചെയ്‌വാൻ",
        "തൻ നിർണ്ണയം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യഹോവ വാഴുന്നു സൂര്യനും ചന്ദ്രനും",
        "തൻ ചൊൽപ്രമാണിച്ചോടുന്നു",
        "ആകാശം സർവ്വവും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "യഹോവ വാഴുന്നു കാറ്റും സമുദ്രവും",
        "തൻ വാക്കിന്നു കീഴ്പെടുന്നു",
        "പ്രപഞ്ചം ഒക്കെയും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "യഹോവ വാഴുന്നു മിന്നീടുന്നു തൻവാൾ",
        "വൻ പാറകൾ പിളരുന്നു തൻ",
        "വാക്കിൻ ശക്തിയാൽ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "യഹോവ വാഴുന്നു താൻ",
        "സാത്താൻ രാജത്വം",
        "എല്ലാം നിഷ്ഫലം ആക്കുന്നു",
        "പുത്രൻ മുഖാന്തരം"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "യഹോവ വാഴുന്നു പാപത്തിൻ",
        "വാഴ്ച താൻ",
        "ഉളളിൽനിന്നു നീക്കിടുന്നു",
        "തൻ വാഴ്ച സ്ഥാപിപ്പാൻ"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "യഹോവ വാഴുന്നു തൻ",
        "രാജ്യം ആത്മാവിൽ",
        "സന്തോഷം നീതിയാകുന്നു",
        "വിശുദ്ധ സ്നേഹത്തിൽ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "യഹോവ വാഴുന്നു തൻ",
        "സമ്മതം വിനാ",
        "നിൻ ശിരസ്സിൽ ഒർരോമവും",
        "നശിപ്പാൻ പാടില്ല"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "10 യഹോവ വാഴുന്നു തൻ",
        "ഭക്തർ നന്മക്കായ്",
        "സുഖത്തിലും ദുഃഖത്തിലും",
        "എല്ലാറ്റിലും തൻ കൈ"
      ]
    },
    {
      "id": "s11",
      "kind": "stanza",
      "label": "11",
      "lines": [
        "യഹോവ വാഴുന്നു",
        "രാജ്യവും ശക്തിയും",
        "എന്നേക്കും തന്റേതാകുന്നു",
        "എല്ലാ മഹത്വവും"
      ]
    }
  ],
