{
  "number": 1612,
  "title": "ഉണർവിൻ വരം ലഭിപ്പാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഉണർവിൻ വരം ലഭിപ്പാൻ",
        "ഞങ്ങൾ വരുന്നു തിരുസവിധേ",
        "നാഥാ... നിന്റെ വൻ കൃപകൾ",
        "ഞങ്ങൾക്കരുളൂ അനുഗ്രഹിക്കു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദേശമെല്ലാം ഉണർന്നിടുവാൻ",
        "യേശുവിനെ ഉയർത്തീടുവാൻ",
        "ആശിഷമാരി അയക്കണമേ",
        "ഈ ശിഷ്യരാം നിൻ ദാസരിൻമേൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തിരുവചനം ഘോഷിക്കുവാൻ",
        "തിരുനന്മകൾ സാക്ഷിക്കുവാൻ",
        "ഉണർവിൻ ശക്തി അയക്കണമേ",
        "ഈ ശിഷ്യരാം നിൻ ദാസരിൻമേൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തിരുനാമം പാടിടുവാൻ",
        "തിരുവചനം ധ്യാനിക്കുവാൻ",
        "ശാശ്വത ശാന്തി അയക്കണമേ",
        "ഈ ശിഷ്യരാം നിൻ ദാസരിൻമേൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വചനത്തിൻ മർമ്മങ്ങൾ വെളിപ്പെടുവാൻ",
        "തിരുഹിതം പോൽ അനുസരിപ്പാൻ",
        "സ്നേഹത്തിൻ ആത്മാവയയ്ക്കണമേ",
        "ഈ ശിഷ്യരാം നിൻ ദാസരിന്മേൽ"
      ]
    }
  ],
