{
  "number": 1045,
  "title": "കണ്ണുനീരെന്നു മാറുമോ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കണ്ണുനീരെന്നു മാറുമോ",
        "വേദനകൾ എന്നു തീരുമോ",
        "കഷ്ടപ്പാടിൻ കാലങ്ങളിൽ",
        "രക്ഷിപ്പാനായ് നീ വരണേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇഹത്തിൽ ഒന്നും ഇല്ലായേ",
        "നേടിയതെല്ലാം മിഥ്യയേ",
        "പരദേശിയാണുലകിൽ",
        "ഇവിടെന്നും അന്യനല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പരനേ വിശ്രാമ നാട്ടിൽ ഞാൻ",
        "എത്തുവാൻ വെമ്പൽകൊളളുന്നേ",
        "ലേശം താമസം വയ്ക്കല്ലേ",
        "നിൽപ്പാൻ ശക്തി തെല്ലും ഇല്ലായേ"
      ]
    }
  ],
