{
  "number": 759,
  "title": "സങ്കടത്തിൽ പരൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സങ്കടത്തിൽ പരൻ",
        "കരങ്ങളാൽ താങ്ങിടുമേ",
        "സംഭ്രമത്തിൽ തുണ",
        "നിന്നവൻ നടത്തിടുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "തിരുനിണം ചൊരിഞ്ഞു",
        "മരണത്തിൻ കരങ്ങളിൽ",
        "നിന്നെന്നെ വീണ്ടെടുത്തു",
        "പുതുജീവൻ തന്നു അനുഗ്രഹം പകർന്നു",
        "സ്വർഗ്ഗത്തിലിരുത്തിയെന്നെ -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തിരകളെൻ ജീവിതപ്പടകിൽ",
        "വന്നടിച്ചാൽ",
        "പരിഭ്രമമില്ലെനിക്കു",
        "അലകളിൻമീതെ നടന്നൊരു നാഥൻ",
        "അഭയമായുണ്ടെനിക്കു -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അവനെന്നെ ശോധന",
        "ചെയ്തിടുമെങ്കിലും",
        "പരിഭവമില്ലെനിക്കു",
        "തിരുഹിതമെന്താ - ണതുവിധമെന്നെ",
        "നടത്തിയാൽ മതിയെന്നും -"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഒടുവിലെൻ ഗുരുവിൻ",
        "അരികിൽ തൻ മഹസ്സിൽ",
        "പുതുവുടൽ ധരിച്ചണയും",
        "കൃപയുടെ നിത്യധനത്തിന്റെ വലിപ്പം",
        "പൂർണ്ണമായ് ഞാനറിയും"
      ]
    }
  ],
