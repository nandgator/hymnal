{
  "number": 139,
  "title": "എന്മനം സ്തുതിച്ചിടുമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്മനം സ്തുതിച്ചിടുമേ",
        "ദിനവും എൻപ്രാണനായകനെ",
        "വർണ്ണിച്ചു പാടിടുമേ പരനെൻ",
        "പ്രാണനെ വീണ്ടതിനാൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആശങ്കയൊന്നുമില്ല",
        "യേശുവിൻ പാത മതി",
        "ക്രൂശിലെ സ്നേഹമെന്നെ തേടി വന്നു",
        "ഇത്രമേൽ സ്നേഹിപ്പാനായ്",
        "ഇതുപോൽ എത്രപേരുണ്ടിഹത്തിൽ?"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആരെല്ലാം കൈവിട്ടാലും",
        "നിന്ദിച്ചു തള്ളിയാലും",
        "ആദരിച്ചവനെന്നെ നടത്തിടുന്നു",
        "ആമയമകറ്റിടുന്നു ശിരസ്സിൽ -",
        "ആശിഷമേകിടുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശത്രുവിൻ പാളയത്തിൽ",
        "ആയിരുന്നെന്നെയവൻ",
        "എത്രമേൽ തേടി വന്നു ജീവനേകി",
        "ശാശ്വത മാർഗ്ഗം തുറന്നെൻ ഗമനം",
        "സുസ്ഥിരമാക്കിയതാൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പ്രത്യാശ വർദ്ധിക്കുന്നു",
        "പൊൻമുഖം നേരിൽ കണ്ട്",
        "നിത്യമായ് വാഴും കാലമോർത്തിടുമ്പോൾ",
        "എന്നുള്ളം തുടിച്ചിടുന്നു ദിനവും",
        "വന്ദിച്ചിടും പരനെ"
      ]
    }
  ],
