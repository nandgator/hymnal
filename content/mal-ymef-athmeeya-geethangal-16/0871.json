{
  "number": 871,
  "title": "ഉന്നതനാം എൻ യേശുവേ",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "ഉന്നതനാം എൻ യേശുവേ",
        "നീയെനിക്കെന്നാളും",
        "ആശ്രയം നീ ആലംബം",
        "നീ സകലവും നീ മാത്രം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്നും രാവിലെ നിന്നെ കണ്ടുണരാൻ",
        "എന്നും കൃപ തരിക മന്നവനേ",
        "എന്നും നീ മാത്രം നിൻ ദയമാത്രം",
        "എന്നുമെൻ ജീവിതം ഇദ്ധരയിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഓരോ ദിനവും എന്നെ കരുതിടുന്ന",
        "നല്ലൊരു സഖിയായ് കൂടെയെന്നും",
        "നാളെന്നും നടത്തും താതനെപ്പോലെ",
        "നാഥന്റെ മാറിൽ ഞാൻ ചാരിടുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കാൽവറിയിൽ വൻ ക്രൂശതിന്മേൽ",
        "കാരുണ്യവാൻ അവൻ എനിക്കായ്",
        "കാൽകരം വിരിച്ചു ആണികൾ തറെപ്പാൻ",
        "കർത്തനവൻ തൻമകനാക്കാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എന്നു നീ വരും എന്റെ പ്രാണപ്രിയാ",
        "കാണുവാൻ കണ്ണുകൾ കൊതിച്ചിടുന്നേ",
        "എന്നെ സ്നേഹിച്ചു ജീവനും തന്ന",
        "എൻപ്രിയനെ ഞാൻ കാത്തിരിക്കും"
      ]
    }
  ],
