{
  "number": 433,
  "title": "ദൈവമെ നിൻ അറിവാലെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ദൈവജ്ഞാനം ശ്രേഷ്ടദാനം",
        "ഭക്തൻ സത്യസമ്പത്തും",
        "വാഞ്ചിക്കേണം കെഞ്ചിടേണം",
        "ക്രിസ്തുവിങ്കൽ കണ്ടെത്തും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവമെ നിൻ അറിവാലെ",
        "ഹൃദയം നിറയ്ക്കുകെ",
        "ജീവനാം നിൻ ക്രുപയാലെ",
        "ആത്മകൺ തുറക്കുകേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഒരു ബാലൻ തന്റെ പാത",
        "നിർമ്മലമാക്കിടുവാൻ",
        "കരുതേണം നിൻ പ്രമാണം",
        "കേട്ടു കാത്തു സൂക്ഷിപ്പാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തേടിയൊരു ശലോമോനും",
        "ഈ നിക്ഷേപം ദർശനേ",
        "നേടി കർത്തൻ സുപ്രസാദം",
        "കേട്ടു തൻ രഹസ്യത്തെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദൈവഭക്തിക്കടിസ്ഥാനം",
        "സത്യത്തിൻ പ്രകാശനം",
        "ജീവശക്തി അതിൻദാനം",
        "ഫലം ദിവ്യ സ്വാതന്ത്ര്യം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നടക്കുമ്പോൾ ഇടറാതെ ജ്ഞാനം",
        "കാൽകൾ സൂക്ഷിക്കും",
        "കിടക്കുമ്പോൾ കൈവിടാതെ",
        "ചുറ്റുംകാവൽ നിന്നിടും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "മണ്ണുംപൊന്നും നീങ്ങിപ്പോകും",
        "കണ്ണിൻ മോഹം വാടുമേ",
        "വിണിൻ ദാനം ആത്മജ്ഞാനം",
        "നിലനില്ക്കും എന്നുമേ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "ദൈവമെ നിൻ വെളിപ്പാടിൻ",
        "ആത്മാവിങ്ങും നല്കുകേ",
        "നിൻ പ്രകാശം അവകാശം",
        "ആക്കുവാൻ തന്നരുൾകേ"
      ]
    }
  ],
