{
  "number": 851,
  "title": "യേശു എന്നടിസ്ഥാനം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു എന്നടിസ്ഥാനം",
        "ആശയവനിലത്രേ",
        "ആശ്വാസത്തിൻ പൂർണ്ണത",
        "യേശുവിൽ കണ്ടേൻ ഞാനും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്ര മധുരമവൻ",
        "നാമമെനിക്കു പാർത്താൽ",
        "ഓർത്തുവരുന്തോറുമെ -",
        "ന്നാർത്തി മാഞ്ഞുപോകുന്നു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദുഃഖം ദാരിദ്രമെന്നി -",
        "വയ്ക്കുണ്ടോശക്തിയെന്മേൽ",
        "കൈയ്ക്കു പിടിച്ചു നട -",
        "ത്തിക്കൊണ്ടു പോകുന്നവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "രോഗമെന്നെ പിടിച്ചെൻ",
        "ദേഹം ക്ഷയിച്ചാലുമേ",
        "വേഗം വരുമെൻ നാഥൻ",
        "ദേഹം പുതുതാക്കിടാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പാപത്താലെന്നിൽ വന്ന",
        "ശാപക്കറകൾ മാറ്റി",
        "ശോഭിതനീതി വസ്ത്രം",
        "ആവരണമായ് നൽകും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വമ്പിച്ച ലോകത്തിര",
        "കമ്പം തീരുവോളവും",
        "മുമ്പും പിമ്പുമായവൻ",
        "അൻപോടെന്നെ നടത്തും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ലോകമെനിക്കു വൈരി",
        "ലോകമെന്നെ ത്യജിച്ചാൽ",
        "ശോകമെന്തെനിക്കതിൽ",
        "ഏതും ഭയപ്പെടാ ഞാൻ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "വെക്കം തൻ മണവാട്ടി",
        "ആക്കിടും എന്നെ എന്ന",
        "വാക്കുണ്ടെനിക്കു തന്റെ",
        "നീക്കമില്ല അതിനൊട്ടും"
      ]
    }
  ],
