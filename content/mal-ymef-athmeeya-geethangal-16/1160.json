{
  "number": 1160,
  "title": "ആണിപ്പാടുളളതാം പാണികൾ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആണിപ്പാടുളളതാം പാണികൾ",
        "നീട്ടിയിന്നേശു കർത്താവു നിന്നെ",
        "മാർവ്വിലണച്ചിടാൻ മാടി വിളിക്കുന്നു",
        "ആ വിളി കേൾക്കുമോ നീ?"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകയിമ്പങ്ങളിൽ",
        "ഭൂനിക്ഷേപങ്ങളിൽ",
        "നീ രസിച്ചു വസിച്ചാൽ",
        "ഇന്നു നീ രസിച്ചു വസിച്ചാൽ",
        "ശോകസമ്പൂർണ്ണമാം നിത്യനരകം",
        "നിന്നോഹരിയോർത്തുകൊൾക"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നല്ലിടയനാകും യാഹ്വയെ",
        "പിൻചെന്നാൽ",
        "അല്ലലില്ലാടുകൾക്ക് തെല്ലും",
        "അല്ലലില്ലാടുകൾക്ക്",
        "നല്ല സഖിയവൻ വല്ലഭമാർന്നതാം",
        "തോളിൽ വഹിച്ചുകൊളളും -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നിന്നുടെ പാപത്തിൻ ശിക്ഷ",
        "തൻ പുത്രന്മേൽ",
        "സ്വർഗ്ഗതാതൻ ചുമത്തി­-തന്നെ",
        "കാൽവറി ക്രൂശിൽ",
        "കൈവിട്ടഹോ നിന്റെ",
        "മരണശിക്ഷയൊഴിപ്പാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിന്നുടെയാത്മാവു പാതാളവേദനാ -",
        "മൃത്യുവെടിഞ്ഞിനിമേൽ ഘോര",
        "മൃത്യുവെടിഞ്ഞിനിമേൽ",
        "സ്വർഗ്ഗസൗഭാഗ്യമാം",
        "നിത്യജീവന്നവകാശി",
        "യാക്കിടുവാനായ് -"
      ]
    }
  ],
