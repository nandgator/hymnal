{
  "number": 1360,
  "title": "ആഹ്! വഹ് പ്യാരീ സലിബ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പസ് ന ഛോഡൂംഗാ പ്യാരീ സലീബ്",
        "ജബ് തക് ദുനിയാ മെം ഹോഗാകയാം",
        "ലിപ്ടാ രഹൂംഗാ മേം ഉസിസെ",
        "കി മസ്ലൂബ് മെം ഹെ അബ്ദി ആരാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആഹ്! വഹ് പ്യാരീ സലിബ്",
        "മുഝ് കോ ദീഖ് പഡ് തി ഹെ",
        "ഏക് പഹാഡി പർ ജോ ഖഡി ഥീ",
        "കി മസിഹ് എ മസ്ലൂബ് നേ നദാമത് ഉഠാ",
        "ഗുൻഹഗാരോം കീ ഖാതിർ ജാൻ ദീ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആഹ്! വഹ് പ്യാരീ സലീബ് ജിസ്കീ ഹോതി തഹ്കീർ",
        "ഹെ മുഝ്കോ ബേഹദ് ദില് പജീർ",
        "കി ഖുദാ കെ മഹ്ബൂബ് ഔർ ജലാലീ മസീഹ്",
        "നെ പഹുംചായാ ഉസ് കല് വരീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മേം ഉസ് പ്യാരി സലീബ് കാ രഹൂം വഫാദാർ",
        "സിപാഹീ ഹമേശാ ജരൂർ",
        "ജബ് തക് മേരാ മസിഹ് ന കരേഗാ മുത്സെ",
        "അപ്നെ അബ്ദി ജലാല് മെം മംജൂർ"
      ]
    }
  ],
