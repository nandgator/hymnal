{
  "number": 313,
  "title": "ശ്രീയേശു നാമം അതിശയ നാമം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ശ്രീയേശു നാമം അതിശയ നാമം",
        "ഏഴയെനിക്കിമ്പനാമം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപപരിഹാരാർത്ഥം പാതകരെ തേടി",
        "പാരിടത്തിൽ വന്ന നാമം",
        "പാപമറ്റ ജീവിതത്തിൻ മാതൃകയെ കാട്ടിത്തന്ന",
        "പാവനമാം പുണ്യനാമം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എണ്ണമില്ലാ പാപം എന്നിൽ നിന്നു നീക്കാൻ",
        "എന്നിൽ കനിഞ്ഞ നാമം",
        "അന്യനെന്ന മേലെഴുത്തു എന്നേക്കുമായ് മായ്ച്ചുതന്ന",
        "ഉന്നതന്‍റെ വന്ദ്യനാമ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എല്ലാ നാമത്തിലും മേലായ നാമം",
        "ഭക്തർ ജനം വാഴുത്തും നാമം",
        "എല്ലാ മുഴങ്കാലും മടങ്ങിടും തിരുമുമ്പിൽ",
        "വല്ലഭത്വം ഉളള നാമം"
      ]
    }
  ],
