{
  "number": 941,
  "title": "ക്രിസ്തേശു നായകൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ക്രിസ്തേശു നായകൻ",
        "വാനിൽ വന്നിടുമേ",
        "ദൂതരോടൊത്തു തൻ",
        "ശുദ്ധരെ ചേർക്കുവാൻ",
        "ഹാ! എത്രയാനന്ദം ഓർക്കിലെന്നുളളത്തിൽ",
        "ഹാ! എന്തു മോദമേ സ്വർഗ്ഗീയ വാസമേ!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലക്ഷ്യങ്ങളെങ്ങുമേ കാണുന്നു സോദരാ",
        "നാൾകൾ സമീപമായ്",
        "കർത്തൻ വരവിന്നായ്",
        "ഉണർന്നു ഘോഷിക്കാം",
        "വാഴ്ത്തി സ്തുതിച്ചിടാം",
        "സ്വർലോക നാഥനാം യേശു മഹേശനെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആശ്വാസമില്ലാതെ",
        "ലോകർ വലയുമ്പോൾ",
        "ആശ്വാസം നൽകിടും തൻമക്കൾക്കെന്നുമേ",
        "ആനന്ദഗാനങ്ങൾ പാടിടും ശുദ്ധരും",
        "ആനന്ദമോടവർ ചേരും തൻ സന്നിധൗ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രിസ്തേശു നാഥന്നായ്",
        "കഷ്ടം സഹിച്ചവർ",
        "തൻ തിരുനാമത്തിൽ തിന്മകളേറ്റവർ",
        "വാങ്ങും പ്രതിഫലം ദൂതർ",
        "സദസ്സതിൽ",
        "സന്തോഷപൂർണ്ണരായ് തീർന്നിടുമന്നവർ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കാഹളശബ്ദവും",
        "കേട്ടിടാൻ കാലമായ്",
        "മരിച്ചോരക്ഷണം ഉയിർക്കും തേജസ്സിൽ",
        "ചേർന്നിടും ശുദ്ധരും സ്വർഗ്ഗ കനാനതിൽ",
        "വാഴും യുഗായുഗം",
        "തേജസ്സിൽ പൂർണ്ണരായ്"
      ]
    }
  ],
