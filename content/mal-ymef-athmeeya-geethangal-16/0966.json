{
  "number": 966,
  "title": "മേഘത്തിൽ വന്നിടാറായ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മേഘത്തിൽ വന്നിടാറായ്",
        "വിണ്ണിൽ വീടുകളൊരുക്കി നാഥൻ",
        "വേഗം വന്നിടും തൻ ജനത്തിന്റെ",
        "ആധികൾ തീർത്തിടുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകം നമുക്കിന്നേകും അവൻ",
        "നാമത്താലപമാനങ്ങൾ",
        "ക്രൂശിൻ നിന്ദകൾ സഹിക്കുന്നതു",
        "നാം ധന്യമായെണ്ണിടുന്നു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വിത്തും ചുമന്നു നമ്മൾ കരഞ്ഞിന്നു",
        "വിതയ്ക്കും മന്നിൽ",
        "വീണ്ടെടുപ്പിൻ നാളുകൾ വരുമ്പോൾ",
        "ആർപ്പൊടു കൊയ്തിടും നാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വീട്ടിൽ ചേരുംവരെയും അവൻ",
        "കാത്തിടും ചിറകിൻ മറവിൽ",
        "ഭീതിയെന്നിയേ നമുക്കീയുലകിൽ",
        "അധിവസിക്കാം ദിനവും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ചേരും പുതിയ ശാലേം പുരിയിൽ",
        "നാം തന്നരികിൽ ഹാ!",
        "തീരും വിനകളഖിലം വരവിൽ",
        "തരും പ്രതിഫലം നമുക്ക്"
      ]
    }
  ],
