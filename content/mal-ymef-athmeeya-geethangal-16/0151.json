{
  "number": 151,
  "title": "സ്തുതി സ്തുതി എൻ മനമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്തുതി സ്തുതി എൻ മനമേ",
        "സ്തുതികളിലുന്നതനെ - നാഥൻ",
        "നാൾതോറും ചെയ്ത നന്മകളെയോർത്തു",
        "പാടുക നീ എന്നും മനമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അമ്മയെപ്പോലെ താതൻ",
        "താലോലിച്ചണച്ചിടുന്നു",
        "സമാധാനമായ് കിടന്നുറങ്ങാൻ",
        "തന്റെ മാർവ്വിൽ ദിനം ദിനമായി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കഷ്ടങ്ങളേറിടിലും എനിക്കേറ്റ -",
        "മടുത്ത തുണയായി",
        "ഘോരവൈരിയിൻ നടുവിലവൻ",
        "മേശ നമുക്കൊരുക്കുമല്ലോ"
      ]
    }
  ],
