{
  "number": 446,
  "title": "ലോകസുഖമോ വെളളിയോ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വചനമെന്റെ കാലിനു ദീപം",
        "വീഥിക്കത് പ്രകാശവും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകസുഖമോ വെളളിയോ",
        "പൊന്നോ ശാശ്വതമല്ലൊന്നും",
        "ആകാശം, ഭൂമി മാറിപ്പോയാലും",
        "വചനമോ സുസ്ഥിരമാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നടപ്പുകളെ നിർമ്മലമാക്കുവാൻ",
        "ബാലകർക്ക് സാദ്ധ്യമാമോ",
        "വചനംകൊണ്ട് സൂക്ഷിക്കുകിൽ",
        "സാധിച്ചിടും നിശ്ചയമായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപമെന്യേ ജീവിക്കുവാൻ",
        "വചനം ഹൃത്തിൽ സംഗ്രഹിക്ക",
        "വചനമുളളിൽ വാസം ചെയ്താൽ",
        "യാചനകൾ സാധിച്ചിടും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രോഗാതുരമാം നാളുകൾ",
        "ഭാരപ്പെടാൻ കാര്യമില്ല",
        "വചനമയച്ച് സൗഖ്യം നൽകി",
        "മാനുവേലൻ വിടുവിച്ചിടും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഇരുപുറവും മൂർച്ചയുളള",
        "വാളാണല്ലോ തിരുവചനം",
        "അസ്ഥി, സന്ധി മജ്ജകളെ",
        "തുളച്ചിടുവാൻ ശക്തമത്രേ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "തിരുവെഴുത്തു സമസ്തവും",
        "ദൈവശ്വാസീയമാണല്ലോ",
        "ഉപദേശവും ശാസനയും",
        "വചനമെന്നും നൽകിടുന്നു"
      ]
    }
  ],
