{
  "number": 510,
  "title": "എൻ യേശുവേ രക്ഷകാ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എൻ യേശുവേ രക്ഷകാ",
        "നല്ല സ്നേഹിതൻ നീ",
        "മാറാത്ത മാധുര്യവാൻ - നീയോ",
        "ഇന്നലേമിന്നും എന്നുമനന്യനായ്",
        "മന്നിലെൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എൻ വേദനവേളയിൽ",
        "നീ വരും തുണയായ്",
        "പേടിക്കയില്ലിനീ ഞാൻ - എന്നിൽ",
        "നൽകിയതെല്ലാം നന്മയിൻ",
        "കരുതൽ എന്നൊരു നാളറിയും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ ജീവിതഭാരങ്ങൾ ആരിലുമധികം",
        "നീയറിയുന്നുവല്ലോ - നാഥാ",
        "നിന്നിലല്ലാതെയാരിൽ ഞാൻ ചാരിടും",
        "നീറുന്ന ശോധനയിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഈ ലോകസാഗരത്തിൽ",
        "വൻതിരമാലകൾ",
        "ആഞ്ഞടിക്കും നേരത്തിൽ - നിന്റെ",
        "ആണികളേറ്റ പാണിയാലെന്നെ",
        "നീ അൻപോടു താങ്ങിടുന്നു"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എന്നാധികൾ തീർപ്പാൻ",
        "എന്നു നീ വരുമോ",
        "എന്നുമെന്നാശയതാം - അന്നു",
        "ഖിന്നതയകന്നു നിന്നോടുകൂടെ",
        "ഞാൻ എന്നാളും വാണിടുമേ"
      ]
    }
  ],
  "sequence": [
