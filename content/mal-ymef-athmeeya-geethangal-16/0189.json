{
  "number": 189,
  "title": "ആയിരമായിരം സ്തുതികളാൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആയിരമായിരം സ്തുതികളാൽ",
        "ആരാലും ആരാധ്യനാം",
        "യേശു എന്നെ വീണ്ടെടുപ്പാൻ",
        "ചോര ചിന്തിയതാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യാഹെൻ പാറയാം",
        "എൻ ആശ്രയമവൻ",
        "പാപക്കുഴിയിൽ നിന്നെന്നെ കരേറ്റി",
        "തന്നിലാക്കി താൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപം പോക്കിയെൻ",
        "ശാപം നീക്കി താൻ",
        "കാൽവറി ക്രൂശിലെ യാഗ -",
        "മരണത്താൽ മോചിതനായി ഞാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഇമ്പമേകുവാൻ എനിക്കായ്",
        "തുമ്പമേറ്റവൻ",
        "അൻപുള്ള നാമം ധ്യാനിച്ച് ഞാൻ",
        "എന്നും ഇമ്പമായ് പാടും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ജയിച്ച് വാഴുന്നോൻ ഇന്നുന്നതെ",
        "താതൻ വലഭാഗെ",
        "തിരിച്ചു വന്നീടും ശുദ്ധരെ ചേർക്കുവാൻ",
        "മേഘേ വേഗത്തിൽ"
      ]
    }
  ],
