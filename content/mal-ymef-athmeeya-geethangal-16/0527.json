{
  "number": 527,
  "title": "കാൽവറി മലമേൽ കാണുന്ന",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഓർത്തുപാടി സ്തുതിക്കുന്നേ",
        "നാഥനേ നിൻ സ്നേഹത്തെ",
        "നിൻകൃപകളോർത്തെന്നും",
        "വാഴ്ത്തി വണങ്ങിടുന്നേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാൽവറി മലമേൽ കാണുന്ന",
        "അൻപിൻ സ്വരൂപനാം യേശുവേ",
        "നിന്മരണം കൊണ്ടെന്റെ",
        "പാപബന്ധനം നീ നീക്കിയല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കഷ്ടതകൾ ജീവിതത്തിൽ",
        "ആഞ്ഞടിക്കും നേരത്തിൽ",
        "തുഷ്ടിയരുളും നാഥൻ എന്നെ",
        "ആശ്വസിപ്പിച്ചിടുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പൂർണ്ണമായ് സമർപ്പിക്കുന്നേ",
        "നാഥനേ എൻജീവിതത്തെ",
        "നിൻ വചനത്താലെന്നെ",
        "എന്നും ആശീർവ്വദിച്ചിടണമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കാത്തുകൺകൾ കൊതിക്കുന്നേ",
        "നാഥനേ നിൻ വരവിന്നായ്",
        "എന്നു വന്നു ചേർത്തിടും നീ",
        "എന്നെ സ്വർഗ്ഗരാജ്യേ വസിച്ചിടുവാൻ"
      ]
    }
  ],
