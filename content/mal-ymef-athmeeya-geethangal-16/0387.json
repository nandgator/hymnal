{
  "number": 387,
  "title": "നിൻ ദാനം ഞാൻ അനുഭവിച്ചു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നിൻ ദാനം ഞാൻ അനുഭവിച്ചു",
        "നിൻസ്നേഹം ഞാൻ രുചിച്ചറിഞ്ഞു",
        "യേശുവേ എൻ ദൈവമേ നീ",
        "എന്നും മതിയായവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശു എനിക്കു ചെയ്ത നന്മകൾ",
        "ഓർത്തിടുമ്പോൾ",
        "നന്ദികൊണ്ടെൻമനം പാടിടുമേ",
        "സ്തോത്രഗാനത്തിൻ പല്ലവികൾ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവമെ നിന്റെ സ്നേഹം",
        "എത്ര നാൾ തളളി നീക്കി",
        "അന്നു ഞാൻ അന്യനായ് അനാഥനായി",
        "എന്നാൽ ഇന്നോ ഞാൻ ധന്യനായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻജീവൻ പോയെന്നാലും",
        "എനിക്കതിൽ ഭാരമില്ല",
        "എന്റെ ആത്മാവിനു നിത്യജീവൻ",
        "യേശു എന്നേ ഒരുക്കിയല്ലോ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിത്യതയോർത്തിടുമ്പോൾ",
        "എൻ ഹൃത്തടമാനന്ദിക്കും",
        "സ്വർഗ്ഗീയ സന്തോഷജീവിതം",
        "വിശ്വാസക്കണ്ണാൽ",
        "ഞാൻ കണ്ടിടുന്നു"
      ]
    }
  ],
