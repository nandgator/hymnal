{
  "number": 1376,
  "title": "ചട്ടാൻ പർ ബുദ്ധിമാൻ നേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചട്ടാൻ പർ ബുദ്ധിമാൻ നേ",
        "ബനായാ അപ്നാഘർ",
        "ഔർ ജോർ കി ബാരിശ് ആഈ",
        "ജോർ കീ ബാരിശ് ആഈ",
        "ഔർ തുഫാൻ ഭീ ഉഠാ",
        "പർ ബുദ്ധിമാൻ കാ ഘർ",
        "സ്ഥിര് രഹാ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ബാലൂ പർ മുർഖ് നേ",
        "ബനായാ അപ്നാ ഘർ",
        "ഔർ ജോർ കി ബാരിശ് ആഈ",
        "ജോർ കീ ബാരിശ് ആഈ",
        "ഔർ തൂഫാൻ ഭീ ഉഠാ",
        "ഔർ മുർഖ് കാ ഘർ",
        "ഗിർ ഗയാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഹേ ലട്കേ ലട്കിയോം ഹർ",
        "സ്വർഗ് ജാനാ ചാഹോ",
        "ദിൽ അപ്നേ ക്രിസ്ത് കോ ദോ",
        "ബുദ്ധിമാൻ കേ ഘർ കീ",
        "യീശു ഹേ ചട്ടാൻ",
        "ഘർ തും ക്രിസ്ത് പർ ബനാഓ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
