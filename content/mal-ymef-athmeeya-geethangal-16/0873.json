{
  "number": 873,
  "title": "യേശു മതി എന്നേശു മതി",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മാറിടും ക്ഷോണി വൻഗിരിപോലും",
        "മാറുകില്ലവൻ ദയ ഒരുനാളും",
        "കാത്തിടും തൻകരത്താലവൻ നമ്മെ",
        "കാർമുകിൽ ഭീകരവേളകളിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശു മതി എന്നേശു മതി",
        "ശാശ്വതമായെന്നാശ്രയമായ്",
        "ആകുലമകന്നെൻ ജീവിത",
        "നൗക തുറമുഖമണയാറായല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മറന്നിടും നമ്മെ മാതാവെന്നാൽ",
        "മറക്കുകില്ലൊരിക്കലും എന്നേശു",
        "അരുളിയ വചനം ബലമേകുന്നു",
        "അനുദിന ജീവിതയാത്രയ്ക്ക്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആഴിയിലോടുമെൻ തോണിയെ നയിക്കും",
        "അഖിലാണ്ഡത്തിൻ ഉടയവനാൽ",
        "ഉയരുന്നലകളിൽ ഉടയാൻ തോണിയെ",
        "ഉടയവനൊരിക്കലും വിടുകില്ല"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഒരുക്കുവാൻ നമുക്കൊരു ഭവനം സ്വർഗ്ഗേ",
        "അരുളിയെന്നേശു പോയപ്പോൾ",
        "മറക്കുകില്ലൊരിക്കലും അവൻ വരും നമ്മെ",
        "മോഹന നാട്ടിൽ ചേർത്തിടുവാൻ"
      ]
    }
  ],
