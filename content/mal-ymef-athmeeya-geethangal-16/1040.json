{
  "number": 1040,
  "title": "മനുവേലേ, മന്നിതിലെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മനുവേലേ, മന്നിതിലെ",
        "മാലകലെ മാറുകില്ലേ",
        "മന്നവരിൽ മന്നവനായ്",
        "മന്നിടം നീ വാഴുകില്ലേ?",
        "നിന്നുദയ പൊൻപുലരി",
        "എന്നിനിയും കാണുമീ ഞാൻ",
        "അന്നുതീരും ഖിന്നതകൾ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപമെഴും പാരിടത്തെ",
        "പാവനമാം പാർപ്പിടമായ്",
        "ഭാസുരമായ് മാറ്റി ഭവാൻ",
        "ഭാഗധേയ ഭാവിതരും",
        "പാടവമായ് പാടുമന്നാൾ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിൻ ജനത്തിന്നിംഗിതങ്ങൾ",
        "ക്കിന്നിഹത്തിൽ സ്ഥാനമില്ല",
        "നിൻഹിതത്തിൽ തന്നെയെത്തിയീ",
        "ധരിത്രി കാണുമെല്ലാം",
        "ആയതിനായ് കാത്തിടുന്നേൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നല്ലതല്ലാതൊന്നുമില്ല വല്ലഭൻ",
        "നിൻ വാഴ്ച തന്നിൽ",
        "ഹല്ലേലുയ്യ, ഹല്ലേലുയ്യാ",
        "ഹല്ലേലുയ്യ ചൊല്ലുമന്നാൾ",
        "ചൊല്ലുമന്നാൾ ഹല്ലേലുയ്യാ"
      ]
    }
  ],
