{
  "number": 1606,
  "title": "പാളയത്തിൽ പുറത്തായ്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാളയത്തിൽ പുറത്തായ്",
        "തൻ നിന്ദ ചുമന്നുകൊണ്ട്",
        "സാക്ഷികളിൻ നടുവിൽ",
        "ധീരരായ് ഗമിച്ചിടാമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാടുകളേറ്റ പാവനന്റെ",
        "പാപമില്ലാത്ത പരിശുദ്ധന്റെ",
        "പാതനോക്കി ജീവിച്ചിടാം",
        "പാരിടത്തിൽ പാർക്കും നാൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപിയെ നേടിടുവാൻ ക്രൂശിൽ",
        "തൻ ജീവൻ വെച്ച",
        "രക്ഷകനാം നാഥന്റെ",
        "രക്ഷണ്യവേല ചെയ്യാം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആയിരം ആയിരങ്ങൾ",
        "പാപത്തിൽ നശിച്ചിടുമ്പോൾ",
        "ക്രൂശിൽ നിവർത്തിച്ചതാം",
        "സുവിശേഷം ഘോഷിച്ചിടാം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കർത്തൻ തൻ പേർക്കായ്",
        "ജീവനെ കളയുകിൽ",
        "നേടിടും താൻ അതിനെ",
        "പ്രാപിക്കും നിത്യ ജീവൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ലോകങ്ങൾ അവസാനിക്കും",
        "വെളിപ്പെടും തൻ തേജസ്സിൽ",
        "തൻ സിദ്ധർ വാണിടുമ",
        "തൻ കൂടെ യുഗായുഗമായ്"
      ]
    }
  ],
  "sequence": [
