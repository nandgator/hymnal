{
  "number": 1290,
  "title": "ചെറിയ കൺകൽ കാത്തുകൊൾ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചെറിയ കൺകൽ കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നല്ലതു കാണുവാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ കൺകൽ കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ചെറിയ ചെവികൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നല്ലത് കേൾക്കുവാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ ചെവികൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ചെറിയ നാവു കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നല്ലത് ചൊല്ലുവാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ നാവു കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ചെറിയ കൈകൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നല്ലത് ചെയ്യുവാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ കൈകൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ചെറിയ കാല്കൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നൽവഴിയിൽ പോകാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വാസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ കാല്കൾ കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ചെറിയ മനസ്സു കാത്തുകൊൾ",
        "കാത്തുകൊൾ",
        "നല്ലത് നിനയ്ക്കുവാൻ ഓർത്തുകൊൾ",
        "വാനത്തിൽ വസിക്കുന്ന",
        "ദൈവം നിന്നെ കാണുന്നു",
        "ചെറിയ മനസ്സു കാത്തുകൊൾ",
        "കാത്തുകൊൾ"
      ]
    }
