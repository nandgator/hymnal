{
  "number": 1572,
  "title": "യേശു രാജാ നിൻകൃപ മതിയെനിക്കു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു രാജാ നിൻകൃപ മതിയെനിക്കു",
        "നാൾതോറും നടത്തുവാൻ നീ മതിയേ",
        "രക്ഷകാ... നയിക്കണമേ",
        "നൽവരം... ഏകിടുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മരുവിൽ നീയൊരു നീരുറവ",
        "കരുതിയല്ലോ ഹാഗാറിന്നായ്",
        "കരയും നേരം കേൾക്കും താതൻ",
        "കനിയും തൻ ഹിതം പോൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അനാഥർക്കെല്ലാം നൽപിതാവാം",
        "വിധവകൾക്കു പാലകനും",
        "കാക്കും എന്നും കണ്മണിപോൽ",
        "കരുതും കർത്തനവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മന്നിലെങ്ങും ഉയർത്തിടും ഞാൻ",
        "മന്നവാ നിൻ നാമമെന്നും",
        "രക്ഷ തന്ന നാഥാ നിന്നെ",
        "വണങ്ങി കുമ്പിടുന്നേ"
      ]
    }
  ],
