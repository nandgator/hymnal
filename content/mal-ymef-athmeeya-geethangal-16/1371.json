{
  "number": 1371,
  "title": "ഛോടീ ഛോടീ ജീവൻ ഗാഡീ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഛോടീ ഛോടീ ജീവൻ ഗാഡീ",
        "ഹാഥ് സേ നഹിം ബൻതീ ഹെം",
        "ദൂർ ദൂർ വഹ് ജാതീ ഹെം",
        "കൈസി അത്ഭുത് ഗാഡീ ഹെം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദോ സ്റ്റേഷൻ ഹോതേ ഹെം",
        "സ്വർഗ് ഔർ നരക് ബോൽതെ ഹെം",
        "മാർഗ് ജോ സ്വർഗ് കോ ജാതാ ഹെ",
        "ബൈബൽ മെം വഹ് മിൽതാ ഹെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഇഞ്ചൻ ഡ്രൈവർ നഹിം ഹെ",
        "പർ ദോ പാംവ് സെ ചലതീ ഹെ",
        "മൗത് കാ ഘംടാ ബജ്താ ജബ്",
        "തബ് ഹീ ഗാഡീ രുക് തീ ഹെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "താജ് ഔർ ഝണ്ഡാ വീണാ ഭീ",
        "സ്വർഗ് മെം ഹംകൊ മിലേഗാ",
        "ഹോശാനാ ഖ്രിസ്ത് കീ ജയ്",
        "സ്തുതി കർതെ ജാവേംഗെ"
      ]
    }
  ],
