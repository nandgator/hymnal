{
  "number": 1004,
  "title": "മരണമേ വിഷമെങ്ങു? നിന്റെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മരണമേ വിഷമെങ്ങു? നിന്റെ",
        "വിജയവുമെവിടെ? എന്നേശു",
        "മരണത്തെ ജയിച്ചു",
        "തനിക്കു സ്തുതി ഹല്ലേലുയ്യാ!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "തൻക്രൂശിൽ ഞാനും ഹാ! മരിച്ചു",
        "നിത്യമാം ജീവൻ കൈവരിച്ചു",
        "തന്നിൽ ഞാൻ",
        "സർവ്വവും ലയിച്ചു ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എൻ ജീവൻ ക്രിസ്തുവിൽ ഭദ്രം മനമേ",
        "പാടുക സ്തോത്രം - എന്നഭയം",
        "തൻ കൃപമാത്രം ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വൃഥാവിലല്ല ഞാൻ ചെയ്യും പ്രയത്നം",
        "ഒടുവിൽ ഞാൻ കൊയ്യും",
        "തടയുവാനില്ലൊരു കൈയും ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പ്രത്യാശയറ്റവരെപ്പോൽ അല്ല നാം",
        "ക്രിസ്തുവിൽ മരിപ്പോർ - ഉയിർക്കും",
        "താൻ വരുമപ്പോൾ ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സ്വർലോക കാഹളം ധ്വനിക്കും",
        "മരിച്ചോ - രക്ഷണമുയിർക്കും",
        "തൻതേജസ്സക്ഷയം ധരിക്കും ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എൻ ദേഹം മണ്മയമെന്നാൽ ഇനിയും",
        "താൻ വരുമന്നാൾ - വിളങ്ങും",
        "തേജസ്സിൽ നന്നായ് ഹല്ലേലുയ്യാ"
      ]
    }
  ],
