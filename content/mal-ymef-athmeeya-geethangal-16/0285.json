{
  "number": 285,
  "title": "അളവില്ലാ സ്നേഹം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അളവില്ലാ സ്നേഹം",
        "യേശുവിൻ സ്നേഹം മാത്രം!",
        "അതിരില്ലാ സ്നേഹം കുരിശിലെ",
        "നിസ്തുല സ്നേഹം മാത്രം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപത്തിൻ പാതയിൽ ഞാൻ",
        "പോകുന്ന നേരത്തവൻ",
        "ചാരത്തണഞ്ഞു ചോരചൊരിഞ്ഞു",
        "തൻ സ്വന്തമാക്കിയെന്നെയവൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആഴിയുമാകാശവും ഊഴിയും",
        "നിർമ്മിച്ചവൻ",
        "പാപിയാമെന്നെ സ്നേഹിച്ചു ക്രൂശിൽ",
        "പ്രാണനും തന്നു രക്ഷിച്ചല്ലോ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വീഴ്ചകൾ ജീവിതത്തിൽ വന്നാലും",
        "കൈവിടാതെ",
        "രക്ഷകൻ കാത്തു നിത്യവുമെന്നെ",
        "താങ്ങി നടത്തും അത്ഭുതമായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തൻ സനേഹബന്ധത്തിൽ നിന്നെന്നെ",
        "പിൻതിരിക്കുവാൻ",
        "ആപത്തോ! വാളോ! മൃത്യുവിനാലോ!",
        "സാദ്ധ്യമല്ലെന്നും നിശ്ചയമായ്"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നാളുകൾ തീർന്നിടുമ്പോൾ",
        "നാഥനെ കണ്ടിടുമ്പോൾ",
        "തൻസ്നേഹഭാരം തിങ്ങിയെന്നുള്ളിൽ",
        "തൃപ്പാദേ വീണു ചുംബിക്കും ഞാൻ"
      ]
    }
  ],
