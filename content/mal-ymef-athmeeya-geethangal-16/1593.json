{
  "number": 1593,
  "title": "കണ്ണുനീർ മാറി വേദനകൾ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കണ്ണുനീർ മാറി വേദനകൾ",
        "എന്നു മാറുമോ?",
        "നിന്ദകൾ മാറി നല്ല ദിനം",
        "എന്നു കാണുമോ?"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഭാരം പ്രയാസം ഏറിടുമ്പോൾ",
        "നിന്റെ പൊന്മുഖം",
        "തേടി സഹായം നേടുമേ ഞാൻ",
        "പൊന്നു നാഥനേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശാശ്വതമാം എൻ പാർപ്പിടമേ",
        "അല്ലീ ഭൂമിയിൽ",
        "ഭൂതലേ ഞാനൊരു അന്യനല്ലോ",
        "യാത്ര ചെയ്യുകിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പൊൻകരം നീട്ടി താങ്ങണമേ",
        "യേശുനായകാ",
        "നിൻ തിരുമാറിൽ ചായുവോളം",
        "ഈ നിൻ ദാസനെ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
