{
  "number": 280,
  "title": "നിൻ സ്നേഹം എൻ പങ്കു",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നിൻ സ്നേഹം എൻ പങ്കു",
        "എൻ രക്ഷകനേ",
        "ആദ്യന്തമില്ലാത്തെൻ നിക്ഷേപമിതേ",
