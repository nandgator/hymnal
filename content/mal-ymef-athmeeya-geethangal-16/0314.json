{
  "number": 314,
  "title": "യേശുവിൻ നാമം ശാശ്വതനാമം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിൻ നാമം ശാശ്വതനാമം",
        "ക്ലേശമശേഷവും നീക്കും നാമം",
        "വിശ്വസിക്കുന്നവർ നാം",
        "ആശ്രയിക്കുന്നതും ആനന്ദിക്കുന്നതും",
        "ആശ്വസിക്കുന്നതുമായ നാമം",
        "അനുദിനം പുകഴ്ത്തുക നാം അ...അ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ചിന്മയനാമം നൻമയിൻ ധാമം",
        "കന്മഷക്കൂരിരുളിൻ വിരാമം",
        "മന്നിലിതിന്നു സമം",
        "ഉന്നതമാമംഗീകൃതനാമം",
        "അന്യമില്ലെന്നതു നിർണ്ണയമാം",
        "അനുദിനം പുകഴ്ത്തുക നാം അ...അ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തൻ തിരുനാമം എന്തഭിരാമം",
        "ആതുരർക്കാനന്ദമാം വിശ്രാമം",
        "ഭക്തരിന്നുൾപ്രേമം",
        "വൻതിരയേറും സിന്ധുവാം ലോകം",
        "താണ്ടുവതിന്നുതകുന്ന നാമം",
        "അനുദിനം പുകഴ്ത്തുക നാം അ...അ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഏതൊരു നാവും യേശുവിൻ നാമം",
        "ഓതിടും നാൾവരുന്നെന്തുകേമം",
        "നിരുപമം നിസ്സീമം",
        "ആരുമവൻ തൃപ്പാദപ്രണാമം",
        "ചെയ്തിടുമന്നഭിവന്ദ്യനാമം",
        "അനുദിനം പുകഴ്ത്തുക നാം അ...അ"
      ]
    }
  ],
  "sequence": [
