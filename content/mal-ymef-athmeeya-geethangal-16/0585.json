{
  "number": 585,
  "title": "യേശു മഹേശനെ ഞാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു മഹേശനെ ഞാൻ",
        "ചിന്തിപ്പതെന്നുളളത്തിന്നാനന്ദമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഈശനുടെ തിരു സന്നിധി ചേർന്നിനി",
        "വിശ്രമം ചെയ്തു തന്റെ തിരുമുഖം",
        "കാൺമതത്യാനന്ദമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വാനസൈന്യങ്ങളും മാനുഷജാലവും",
        "ഊനമില്ലാതെ നിന്നെ വർണ്ണിക്കുവാൻ",
        "സാദ്ധ്യമതാകയില്ല"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മാനുഷരക്ഷകാ നിന്നുടെ നാമംപോൽ",
        "വാനിലും ഭൂമിയിലും ഇല്ലേയൊരു",
        "നാമം നിനപ്പതിന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഉളളം നുറുങ്ങിയോർക്കുളള പ്രത്യാശയും",
        "നല്ല പ്രസാദവും നീ സർവ്വേശ്വരാ",
        "സൗമ്യതയുളളവർക്കേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എത്ര ദയാപരൻ വീഴുന്നവർക്കേശു",
        "എത്ര നല്ല ഗുണവാൻ തേടിടുന്ന",
        "മർത്യഗണങ്ങൾക്കു താൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "കണ്ടിടും മാനവർക്കെന്തൊരാഹ്ളാദം നീ",
        "ഉണ്ടോ നാവും പേനയും വർണ്ണിക്കുവാൻ",
        "ആ നല്ല സന്ദർഭത്തെ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "യേശുവിൻ സ്നേഹമതെന്തെന്നു ചൊല്ലുവാൻ",
        "ആസ്വദിച്ചോർക്കല്ലാതെ മറ്റാർക്കു -",
        "മസാദ്ധ്യമറിഞ്ഞിടുവാൻ"
      ]
    }
  ],
