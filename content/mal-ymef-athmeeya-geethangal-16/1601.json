{
  "number": 1601,
  "title": "എന്നേശു നായകനേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നെ നീ മറന്നിടാതെ",
        "എന്നെയും ചേർക്കുമല്ലോ",
        "എന്നും തുടിച്ചിടുന്നേ",
        "എൻ ദേവാ വന്നിടണേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്നേശു നായകനേ",
        "എന്നു നീ വന്നിടുമേ",
        "എന്നാധി തീർത്തിടുവാൻ",
        "എൻ പരനെ ഉലകിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഏഴയാമെന്നെ തേടിയോ",
        "എന്നെയും സ്നേഹിച്ചു നീ",
        "എന്നോടു കൂടെയെന്നും",
        "എല്ലാമായ് എന്നരികിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എന്നാളും പാടിടുവാൻ",
        "എന്നുളളം സ്തുതിച്ചിടുവാൻ",
        "എൻ പ്രിയാ എന്റെ മനം",
        "എന്നെന്നും വാഞ്ചിക്കുന്നു"
      ]
    }
  ],
