{
  "number": 899,
  "title": "സകലേശജനെ വെടിയും",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സകലേശജനെ വെടിയും",
        "നരസംഘംചുവടേ പൊടിയും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സങ്കടം നിറഞ്ഞിങ്ങമരും തൻ",
        "ജനങ്ങളെ കാത്തരുളും",
        "തുംഗതേജസ്സാ വാനിൽ വരും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സാരമായ തൻവാക്കുകൾ നിസ്സാര -",
        "മെന്നു താനേ കരുതി",
        "നേരുവിട്ടു നീ പോകുകയോ?"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നഷ്ടമേൽക്കുകിൽ നൂറുഗണം",
        "കിട്ടുമെന്നല്ല രാജ്യമതിൽ",
        "നിത്യജീവനും കിട്ടുമെന്നാൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദൈവദാസരോടിങ്ങിടയും",
        "പാപികൾ കിടന്നങ്ങലയും",
        "കോപമേറ്റശേഷം വലയും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ചൂളപോലെരിയുന്ന ദിനം",
        "കാളുമഗ്നിയായ് വന്നിടവേ",
        "താളടിക്കു തുല്യം നരരാം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "വേരുകൊമ്പിവ ശേഷിച്ചിടാ",
        "ചാരമാമവർ കാൽക്കടിയിൽ",
        "നേരുകാരതി ശോഭിതരാം"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "യൂദർ ക്രിസ്തനെത്തളളിയതാൽ",
        "ഖേദമെന്തു വന്നോർക്കുക നീ",
        "ഭേദമില്ല നീയാകിലുമീ"
      ]
    }
  ],
