{
  "number": 1266,
  "title": "സന്തോഷമെനിക്കുണ്ട്, കാരണമുണ്ട്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സന്തോഷമെനിക്കുണ്ട്, കാരണമുണ്ട്",
        "യേശു എന്‍ പാപം നീക്കിയതാല്‍",
        "ഞാനിപ്പോള്‍ പാടുന്നു",
        "നാള്‍തോറും",
        "യേശു എന്‍ പാപം നീക്കിയതാല്‍!",
        "പാപത്താലെന്‍ ഹൃദയം ഭാരപ്പെട്ടിരുന്നു",
        "യേശു എന്റെ ഭാരം",
        "നീക്കി ശാന്തി തന്നു",
        "ഞാനിപ്പോള്‍ പാടുന്നു",
        "നാള്‍തോറും",
        "യേശു എന്‍ പാപം നീക്കിയതാല്‍"
      ]
    }
  ],
