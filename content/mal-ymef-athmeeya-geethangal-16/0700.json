{
  "number": 700,
  "title": "അനുദിനവും അരികിലുളള",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അനുദിനവും അരികിലുളള",
        "അരുമനാഥൻ മതിയെനിക്ക്",
        "അനവധിയായ് അനുഗ്രഹങ്ങൾ",
        "അരുളിയെന്നെ അണയ്ക്കുമവൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഒരു നിമിഷം മറന്നിടാതെ",
        "ഒരുദിനവും കൈവിടാതെ",
        "തിരുചിറകിൽ മറവിലെന്നെ",
        "ചേർത്തണയ്ക്കും നാഥനവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഏറിവരും ആധികളിൽ",
        "ഏകനല്ല പാരിതിൽ ഞാൻ",
        "ഏവരും കൈവിട്ടെന്നാലും",
        "ഏറ്റവും നൽ മിത്രമവൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പാരിതിലെൻ പാതയിൽ ഞാൻ",
        "പതറിടാതെ പരിപാലിക്കും",
        "പരമനാഥൻ മറവിടമാം",
        "പരമപദം അണയുവോളം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
