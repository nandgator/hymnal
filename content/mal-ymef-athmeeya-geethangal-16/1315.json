{
  "number": 1315,
  "title": "അലറുന്ന സിംഹം പോലെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അലറുന്ന സിംഹം പോലെ",
        "പിശാച് നമ്മുടെ പിറകെ",
        "ആരെ വിഴുങ്ങണമെന്നു",
        "തിരഞ്ഞവാന്‍ ചുറ്റി നടക്കുന്നു",
        "അവനെ നാം ഭയപ്പെടേണ്ട",
        "കര്‍ത്താന്‍ കൂടെയുണ്ട്",
        "വിജയം തരുന്നവനെശുവില്‍",
        "മുമ്പില്‍ നാമണിനിരന്നീടുക",
        "ലെഫ്റ്റ് - റൈറ്റ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സത്യമരക്ക് നാം കെട്ടിടാം",
        "നീതിയിന്‍ കവചം ധരിച്ചിടാം",
        "സമാധാന സുവിശേഷമെന്ന",
        "ചെരിപ്പ് കാല്‍കളില്‍ അണിഞ്ഞിടാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വിശ്വാസമെന്ന പരിച്ചയുമായ്",
        "ദുഷ്ടന്റെ അമ്പു തകര്‍ത്തിടാം",
        "വിശുധനാം ദൈവമൊരുക്കിയ",
        "രക്ഷ ശിരസ്സില്‍ നാം അണിഞ്ഞിടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആത്മാവിന്‍ പടവാളാം",
        "ദൈവത്തിന്റെ വചനം കൈക്കൊള്ളാം",
        "ആത്മാനാഥനാം യേശുവിന്‍ നാമാത്തില്‍",
        "എപ്പോഴും പ്രാര്‍ത്ഥിച്ചീടാം"
      ]
    }
  ],
