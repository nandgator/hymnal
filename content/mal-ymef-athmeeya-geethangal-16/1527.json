{
  "number": 1527,
  "title": "നമിക്കുന്നു നമിക്കുന്നു നാഥനെ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നമിക്കുന്നു നമിക്കുന്നു നാഥനെ",
        "ഞങ്ങൾ വണങ്ങുന്നു",
        "വാഴ്ത്തുന്നു നാഥനെ",
        "ആരാധയ്ക്ക് യോഗ്യനാം നാഥനെ",
        "ഞങ്ങൾ പുകഴ്ത്തുന്നു",
        "സ്തുതിക്കുന്നു നാഥനെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സ്വർഗ്ഗം വിട്ട് മന്നിൽ വന്ന നാഥനെ",
        "നിന്ദ പരിഹാസമേറ്റ ജീവനാഥനെ",
        "ക്രൂശിൽ മരിച്ചുയിർത്തെഴുന്നേറ്റവൻ",
        "എൻ പാപത്തിന്റെ ശിക്ഷ",
        "നീക്കി നാഥൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപത്തിൻ ഘോരമാം",
        "ശിക്ഷയിൽ നിന്ന്",
        "നമ്മെ വീണ്ടെടുത്ത നിത്യ ജീവനാഥനെ",
        "മൃത്യുവും ശാപവും ഏറ്റ നാഥനെ",
        "അങ്ങേ തൃപ്പാദത്തിൽ",
        "നമിക്കുന്നു നാഥനെ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
