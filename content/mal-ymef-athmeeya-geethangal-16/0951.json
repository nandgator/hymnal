{
  "number": 951,
  "title": "കർത്താവു താൻ വരും വേഗം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വേഗം വേഗം വേഗം താൻ വരുമേ",
        "നിത്യസന്തോഷം വൃതർക്കേകുവാൻ",
        "കർത്താവു താൻ വരും വേഗം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കർത്താവു താൻ വരും വേഗം",
        "തൻ വചനം സത്യമേ",
        "കാത്തിരിക്കുന്ന തൻ സംഘം",
        "തന്നോടു ചേരുമേ",
        "മർത്യശരീരം മാറുമേ നിത്യശരീരം ലഭ്യമേ",
        "നിത്യസന്തോഷം വൃതർക്കേകുവാൻ",
        "കർത്താവു താൻ വരും വേഗം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കർത്താവു താൻ വരും വേഗം",
        "തൻരാജ്യം സ്ഥാപിക്കുമേ",
        "നീതിമാന്മാർ ഭൂമൗ വാഴും",
        "തന്നോടു കൂടവേ",
        "കണ്ണുനീർ താൻ തുടയ്ക്കുമേ",
        "അന്നവർ ആനന്ദിക്കുമേ",
        "നിത്യസന്തോഷം വൃതർക്കേകുവാൻ",
        "കർത്താവു താൻ വരും വേഗം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കർത്താവു താൻ വരും വേഗം",
        "അന്ധകാരം മാറുമേ",
        "ചന്തമേറും സൂര്യകാന്തി",
        "ചിന്തും ഭൂവെങ്ങുമേ",
        "സന്താപം നീങ്ങിപ്പോകുമേ",
        "സന്തോഷം പൂർണ്ണമാകുമേ",
        "നിത്യസന്തോഷം വൃതർക്കേകുവാൻ",
        "കർത്താവു താൻ വരും വേഗം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കർത്താവു താൻ വരും വേഗം",
        "സംശയമില്ലൊട്ടുമേ",
        "തൻവരവിൻ കാലലക്ഷ്യം",
        "കാണുന്നുണ്ടെങ്ങുമേ",
        "അത്തി തളിർത്തിടുന്നിതാ",
        "വേനലടുത്തുപോയി ഹാ!",
        "നിത്യസന്തോഷം വൃതർക്കേകുവാൻ",
        "കർത്താവു താൻ വരും വേഗം"
      ]
    }
  ],
