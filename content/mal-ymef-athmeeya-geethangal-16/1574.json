{
  "number": 1574,
  "title": "ഭയപ്പെടേണ്ട എൻ മനമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവിൽ നീ ആശ്രയിക്കു",
        "ആശ്വസിക്കൂ നിതാന്തം",
        "തൻ കൃപകൾ ശക്തി തരും -",
        "എന്തിനിനീ വിഷാദം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഭയപ്പെടേണ്ട എൻ മനമേ",
        "ദയയുളള നാഥൻ കൂടെയില്ലേ",
        "അഭയമവൻ തരികയില്ലേ",
        "എന്തിനു ഭീതി എൻ മനമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വലം കരത്താൽ വഹിച്ചു നിന്നെ",
        "വഴി നടത്താൻ പ്രിയനില്ലേ",
        "ഒരു വിപത്തും വരുത്തുകില്ല",
        "എന്തിനു ഭീതി എൻ മനമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മരണനിഴൽ താഴ് വരയിൽ",
        "ശരണം തരും സഖിയല്ലോ",
        "മനതളിരിൽ സുഖമരുളും",
        "എന്തിനു ഭീതി എൻ മനമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഗഗനമതു ഭൂമിക്കുമേൽ",
        "ഉയർന്നിരിക്കുന്നതുപോലെ",
        "തൻ ദയയൊ വലുതല്ലോ",
        "എന്തിനു ഭീതി എൻ മനമേ"
      ]
    }
  ],
