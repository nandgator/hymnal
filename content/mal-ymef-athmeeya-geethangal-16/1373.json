{
  "number": 1373,
  "title": "ചൗഡാ ജൈസാ സമുദ്ര്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചൗഡാ ജൈസാ സമുദ്ര്",
        "ഊംചാ ഹെ ജൈസാ ആസ്മാൻ",
        "ഗഹ് രെ പാനീ സെ ഗഹ് രെ",
        "ഹെ യിശു കാ പ്യാർ",
        "മേം ഹൂം അയോഗ്യ, തൗഭീ വഹ്",
        "കർതാ ഹെ പ്യാർ",
        "രക്ഷാ വഹ് കർതാ ഹെ",
        "ആഗെ ലേ ചല്താ ഹെ ജയ് ജയ് ജയ്"
      ]
    }
  ],
