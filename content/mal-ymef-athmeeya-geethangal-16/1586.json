{
  "number": 1586,
  "title": "ഇനി നാളുകളേറെയില്ല",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഇനി നാളുകളേറെയില്ല",
        "പ്രിയനാഥനായ് ജീവിച്ചിടാൻ",
        "സടകുടഞ്ഞെഴുന്നേല്ക്കാം",
        "സകലവുമവനേകാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദുഷ്കാലമാണീ മരുവാസം",
        "തക്കത്തിൽ നാം ഉപയോഗിക്കണം",
        "നാളുകളെ നമുക്കെണ്ണീടാം",
        "ഒരുങ്ങിടാം പ്രിയരേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സുവാർത്തയോതാൻ സമയമിത്",
        "ഇന്ന് രക്ഷാദിനം സുപ്രസാദകാലം",
        "സമയത്തിലും അസമയത്തിലും",
        "ഒരുങ്ങിടാം പ്രിയരെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "രാജാധിരാജാവെഴുന്നളളുവാൻ",
        "ഇനി സമയമില്ല കാലമധികമില്ല",
        "എതിരേല്ക്കാൻ ദീപവുമായ്",
        "ഒരുങ്ങിടാം പ്രിയരെ"
      ]
    }
  ],
