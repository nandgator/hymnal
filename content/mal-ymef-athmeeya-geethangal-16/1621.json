{
  "number": 1621,
  "title": "എത്ര നിസാരമാം കാര്യമാണെങ്കിലും",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എത്ര നിസാരമാം കാര്യമാണെങ്കിലും",
        "എന്നെക്കൊണ്ടാവില്ല കർത്താവെ",
        "നീ കൃപ തന്നാലെ നീ ചാരെ വന്നാലെ",
        "സാധിക്കയുളെളന്റെ കർത്താവെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്രയോ പ്രാവശ്യം",
        "നിന്നെ മറന്നു ഞാൻ",
        "ജീവിച്ചുപോയെന്റെ കർത്താവെ",
        "ആശ്രയിച്ചിടാനും ആശ്വസിച്ചിടാനും",
        "കർത്താവെ നിയല്ലാതെ ആരുമില്ല"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എത്ര നാളായി ഞാൻ",
        "കാത്തിരിക്കുന്നെന്റെ",
        "കർത്താവെ നിൻ മുഖം കാണാനായി",
        "നീ വേഗം വന്നാലെ",
        "നിൻ കൂടെ ചേർന്നാലെ",
        "തീരുകയുളന്റെ വേദനകൾ"
      ]
    }
  ],
  "sequence": [
