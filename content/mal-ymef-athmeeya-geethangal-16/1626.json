      "lines": [
        "എ... ഏലീ... ഏലീശ",
        "ഏലിയാവിൻ ശിഷ്യൻ",
        "ബി... ബിലി... ബിലീവ് ചെയ്തു",
        "ദൈവം സർവശക്തൻ",
        "അവൻ നയമാൻ രോഗം മാറ്റുമെന്ന്",
        "അവൻ വിധവയുടെ",
        "പാത്രം നിറയ്ക്കുമെന്ന്"
      ]
    }
  ],
