{
  "number": 647,
  "title": "ദിനം ദിനം ദിനം നീ വാഴ്ത്തുക",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ദിനം ദിനം ദിനം നീ വാഴ്ത്തുക",
        "യേശുവിൻ പൈതലേ നീ",
        "അനുദിനവും പാടി വാഴ്ത്തുക"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാൽവറി രക്തമേ",
        "യേശുവിൻ രക്തമേ",
        "കാൽവറിയിൽ യേശുതാൻ",
        "സ്വന്തരക്തം ചിന്തിനിൻ",
        "പാപത്തെ ശാപത്തെ നീക്കി",
        "തന്റെ രക്തത്താൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രോഗം ശിലിച്ചവൻ",
        "പാപം വഹിച്ചവൻ",
        "കാൽവറി മലമുകൾ",
        "കൈകാൽകൾ വിരിച്ചവൻ",
        "രക്ഷിക്കും യേശുവിൻ",
        "പാദത്തിൽ സമർപ്പിക്ക"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എന്നേശു സന്നിധി",
        "എനിക്കെത്രയാശ്വാസം",
        "ക്ലേശമെല്ലാം മാറ്റിടും",
        "രോഗമെല്ലാം നീക്കിടും",
        "വിശ്വാസത്താൽ നിന്നെ",
        "യേശുവിൽ സമർപ്പിക്ക"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഞാൻ നിത്യം ചാരിടും",
        "എന്നേശു മാർവ്വതിൽ",
        "നല്ലവൻ വല്ലഭൻ എന്നേശു",
        "എത്ര നല്ലവൻ",
        "എന്നേശു പൊന്നേശു",
        "എനിക്കെത്ര നല്ലവൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ആത്മാവിൻ ജീവിതം",
        "ആനന്ദ ജീവിതം",
        "ആത്മാവിൽ നിറയുക",
        "ആനന്ദനദിയിതു",
        "പാനം ചെയ്തിടുക",
        "യേശു വേഗം വന്നിടും"
      ]
    }
  ],
