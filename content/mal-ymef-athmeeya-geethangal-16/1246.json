{
  "number": 1246,
  "title": "ആശിസ്സേകണം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആശിസ്സേകണം",
        "വധൂവരർക്കിന്നു നീ - പര",
        "നേശുനാഥനേ! കനിഞ്ഞു",
        "സ്വർഗ്ഗീയമാം - പര - മാശി -"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പണ്ടു നീ ഗലീലയിലെ",
        "കാനാവിങ്കൽ - ചെന്നു",
        "കൊണ്ടവർക്കുവേണ്ടി ജലം",
        "ദ്രാക്ഷാരസ - മാക്കി -",
        "യിണ്ടലാകവേയകറ്റി -",
        "യെന്നോണമി - ന്നും",
        "പ്രസാദമോടിറങ്ങിവന്നു",
        "നൽകേണമേ ശുഭം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സ്നേഹബന്ധനങ്ങളാലെ",
        "യോജിച്ചിവർ ഒരു",
        "ദേഹമായ് വിളങ്ങി",
        "ടുന്നതിന്നേകണം - വരം",
        "ഏകാശ്രയം പ്രവൃത്തി",
        "സംഭാഷണ - മിവ -",
        "യാകവേ വിശിഷ്ടമാം",
        "വിധം കാണുവാൻ - നിത്യം"
      ]
    }
  ],
  "sequence": [
