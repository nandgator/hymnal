  "number": 1307,
  "title": "സാത്താനൊരു സൂത്രക്കാരന്‍",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സാത്താനൊരു സൂത്രക്കാരന്‍",
        "തത്തി തത്തി വരുന്നുണ്ടേ",
        "കൈയെത്തി ചാടിപ്പിടിക്കാന്‍",
        "എന്നെ നോട്ടമിടുന്നുണ്ടേ",
        "ഇല്ലേയില്ലയില്ല",
        "അവനെന്നെ കിട്ടുകയില്ല",
        "ഞാനെശുവിന്റെ പൈതല്‍",
        "ഞാനെശുവിന്റെ കൈയില്‍"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    }
  ],
