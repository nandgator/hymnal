{
  "number": 799,
  "title": "യേശു നല്ലവൻ എൻ",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "യേശു നല്ലവൻ എൻ",
        "യേശു നല്ലവൻ അതേ",
        "സംശയമില്ലേതുമെന്റെ യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "തൻ കരുണയോ",
        "എന്നേക്കുമുളളതാം നിത്യം",
        "തൻ കഴലെനിക്കഭയം",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നല്ല ഇടയൻ ഇല്ല ചഞ്ചലം തന്റെ",
        "ചൊല്ലെനിക്കു മാധുര്യമെൻ",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഇല്ല തനിക്കു തുല്യനാരുമേ ഭുവി",
        "വല്ലഭൻ മഹേശനെന്റെ",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഇന്നലേമിന്നും എന്നേക്കു -",
        "മവൻ താൻ തന്നെ",
        "ഒന്നുപോലിരിക്കുന്നവൻ",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കഷ്ടതകളിൽ ആശ്വാസമേകുവാൻ",
        "എനിക്കേറ്റമടുത്ത തുണയാം",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "യേശു നല്ലവൻ",
        "എന്നാസ്വദിച്ചവർ തന്നിൽ",
        "ആശ്രയിക്കും മേൽക്കുമേലെൻ",
        "യേശു നല്ലവൻ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "നന്ദിയോടു ഞാൻ എന്നാളു -",
        "മവനെ അഭി",
        "വന്ദനം ചെയ്യുമനന്തം",
        "യേശു നല്ലവൻ"
      ]
    }
  ],
