{
  "number": 920,
  "title": "ഒരിക്കലുമിളകാത്ത",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മാരിയേറി ജലം കരേറിയലച്ചടി -",
        "ക്കവേ എന്താകും?",
        "ഉറപ്പുളള പാറയിന്മേൽ",
        "പണിയുന്ന ഭവനമ -",
        "തിളക്കമില്ലാതെ നിൽക്കും",
        "ബലത്തോടെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഒരിക്കലുമിളകാത്ത",
        "ശിലസമാനം ക്രിസ്തു",
        "യിരിയ്ക്കവേയിളകുന്ന മണൽപരപ്പിൽ",
        "പണിയുന്ന ഭവനങ്ങളതു",
        "വെറും ബുദ്ധികേടെ -",
        "ന്നറിയുന്നില്ലൽപവുമീയുലകം ജനം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കുലം, ബലം, സ്ഥലം, ധനം",
        "വിദ്യയിവയെല്ലാം മണൽ",
        "സ്ഥിരതയില്ലൊന്നിനുമീ ധരണി തന്നിൽ",
        "ഇതിൽ മനമുറപ്പിച്ചു ജീവിതത്തെ",
        "പണിയുവാൻ",
        "തുനിയുന്നതബദ്ധമെന്ന -",
        "റിഞ്ഞുകൊൾവിൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മരിച്ചുയിർത്തവനുണ്ടോ -",
        "മറിയുന്നു മന്നിതിലെ",
        "മദമിളകിടും ജനസ്ഥിതി മൂലം",
        "സകലവുമിളകിടും മലകളുമൊഴുകിടും",
        "ഉലയുകില്ലൊരിക്കലുമവനിലുളേളാർ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഭവനം പണിയുന്നവരകലെ -",
        "ക്കളഞ്ഞ കല്ലാ -",
        "മവന്നരികണഞ്ഞിന്നു പണിയപ്പെട്ടാൽ",
        "നവജീവനകല്ലുകളാ - ലുളവാകുമാത്മീയ",
        "ഭവനമായ് നിലകൊളളുമിളകാതെ"
      ]
    }
  ],
