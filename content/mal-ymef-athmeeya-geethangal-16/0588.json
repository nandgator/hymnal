{
  "number": 588,
  "title": "നിസ്തുല്യനാഥൻ ക്രിസ്തുവിൽ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നിസ്തുല്യനാഥൻ ക്രിസ്തുവിൽ",
        "വാസ്തവമാം മോദം",
        "ദർശിക്കുമേതു വ്യക്തിയും",
        "ക്രൂശിൻ പ്രകാശത്താൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അവർണ്ണ്യമാം തൻ സ്നേഹമോ",
        "അഗണ്യനാമെന്നെ",
        "രക്ഷിച്ചു ക്രൂശിൻ രക്തത്താൽ",
        "ശിക്ഷാവിമുക്തനായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സാഷ്ടാംഗം വീണിടുന്നു ഞാൻ",
        "സ്രഷ്ടാവേ, രക്ഷകാ",
        "നിനക്കെൻ ബഹുമതിയും ധനം സമയവും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സമ്പൂർണ്ണമായ് നൽകിടുന്നു",
        "അൻപേറും നാഥനേ",
        "എൻഗേഹം ഭൂനിക്ഷേപങ്ങൾ",
        "നിൻഘോഷണത്തിന്നായ്"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എൻദേഹം ദേഹി മാനസം",
        "നിൻസ്നേഹജ്വാലയാൽ",
        "പ്രശോഭിതമായ്ത്തീരുവാൻ",
        "നാഥാ തുണയ്ക്കുക"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എൻജീവൻ സൗഖ്യം മുറ്റുമായ്",
        "സംജീവദായകാ",
        "അർപ്പിക്കുന്നേ നിൻകൈകളിൽ",
        "ചെയ്‌വാൻ നിൻപൊന്നിഷ്ടം"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "സമസ്തവും നിൻപാദത്തിൽ",
        "സമർപ്പിക്കുന്നഹം",
        "ജയിക്കുക ഭവാനെന്നും",
        "നയിക്ക സാധുവെ"
      ]
    }
  ],
  "sequence": [
