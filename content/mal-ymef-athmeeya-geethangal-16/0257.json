{
  "number": 257,
  "title": "ഗോൽഗോത്തായിലെ കുഞ്ഞാടേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഗോൽഗോത്തായിലെ കുഞ്ഞാടേ",
        "അത്ഭുതമുള്ളോർ കുഞ്ഞാടേ",
        "പാപശാന്തി നീയത്രേ",
        "ഗോൽഗോത്തായിലെ കുഞ്ഞാടേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഗോൽഗോത്തായിലെ മൃത്യുവേ",
        "അത്ഭുതമുള്ളോർ മൃത്യുവേ",
        "ജീവവാതിൽ നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ മൃത്യുവേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഗോൽഗോത്തായിലെ രക്തമേ",
        "അത്ഭുതമുള്ളോർ രക്തമേ",
        "എൻ വിശുദ്ധി നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ രക്തമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഗോൽഗോത്തായിലെ നീതിയേ",
        "അത്ഭുതമുള്ളോർ നീതിയേ",
        "എൻ പ്രശംസ നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ നീതിയേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഗോൽഗോത്തായിലെ താഴ്മയേ",
        "അത്ഭുതമുള്ളോർ താഴ്മയേ",
        "എൻ ഉയർച്ച നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ താഴ്മയേ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഗോൽഗോത്തായിലെ സ്നേഹമേ",
        "അത്ഭുതമുള്ളോർ സ്നേഹമേ",
        "എൻ കിരീടം നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ സ്നേഹമേ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "ഗോൽഗോത്തായിലെ ജയമേ",
        "അത്ഭുതമുള്ളോർ ജയമേ",
        "എന്റെ ശക്തി നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ ജയമേ"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ഗോൽഗോത്തായിലെ കുഞ്ഞാടേ",
        "അത്ഭുതമുള്ളോർ കുഞ്ഞാടേ",
        "എൻ സംഗീതം നീ അത്രേ",
        "ഗോൽഗോത്തായിലെ കുഞ്ഞാടേ"
      ]
    }
  ],
