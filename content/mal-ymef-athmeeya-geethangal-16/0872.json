{
  "number": 872,
  "title": "എന്റെ ദൈവം എത്ര നല്ലവൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്റെ ദൈവം എത്ര നല്ലവൻ",
        "ഏറ്റമെന്നെ അറിയുന്നവൻ",
        "എല്ലാം നന്മയ്ക്കായ് നൽകിടുന്നവൻ",
        "എപ്പോഴുമെന്നെ കുരുതന്നവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കഠിനശോധനവേളയിലും",
        "എരിയും തീച്ചൂള നടുവിലും താൻ",
        "ചൊരിയും തൻകൃപ ഹിമസമമായ്",
        "തീരുമെന്നുടെയാധിയെല്ലാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കണ്ണുനീരിൽ മനസ്സലിയും",
        "കഷ്ടനാളിൽ കൈവിടാത്തവൻ",
        "ഏതുകാര്യവും നടത്തിതരും",
        "ഏതുനേരവും മറന്നിടാതെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യാഹെന്നിടയൻ എന്നും നല്ലവൻ",
        "യെരിഹോ മതിലുകൾ തകർത്തവനാം",
        "ചെങ്കടൽ വഴിയൊരുക്കിയവൻ",
        "ചന്തമായെന്നെ വഴിനടത്തും"
      ]
    }
  ],
