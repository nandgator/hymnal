{
  "number": 865,
  "title": "കരുണയിൻ പരിപാലനം എന്നും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കരുണയിൻ പരിപാലനം എന്നും",
        "ചൊരിയണമീ ദാസനിൽ",
        "മരണംവരെയും ശരണം നിൻചരണം",
        "തരണം നിൻ പാദമഭയം",
        "ഈ ഏഴയിൽ കനിയണമേ സദയം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കാർമുകിലേറിടുമ്പോൾ ജീവിതം",
        "കൂരിരുൾ നിറഞ്ഞിടുമ്പോൾ",
        "കാണുമേ ഞാൻ മേഘേ മാരിവില്ലൻ ശോഭ",
        "ഏശിടുമേ ഹൃദയേ മെല്ലെ",
        "ഈശനെ നിൻ മൊഴികൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ പാദം തളർന്നിടുമ്പോൾ",
        "ചുമലിൽ വൻഭാരം വന്നിടുമ്പോൾ",
        "നരച്ചിടുവോളം ചുമന്നിടാമെന്നുളള",
        "വാഗ്ദത്തമോർത്തിടുന്നു ദിനവും",
        "യാത്ര ഞാൻ തുടർന്നിടുന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സ്തോത്രം സദാ പരനേ നിന്നെ",
        "കീർത്തനം ചെയ്തിടുന്നേ",
        "യേശു മഹേശനെ ജീവനാധാരമേ",
        "ആശയാൽ നിറഞ്ഞിടുന്നേ",
        "എൻമാനസം താണു വണങ്ങിടുന്നേ"
      ]
    }
  ],
  "sequence": [
