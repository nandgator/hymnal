{
  "number": 470,
  "title": "കാത്തിടും പരനെന്നെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കാത്തിടും പരനെന്നെ",
        "കരുണയോടവനെന്നും",
        "കരളലിഞ്ഞു തൻതിരുക്കരങ്ങളാൽ",
        "ഭരിച്ചു കാക്കും താനെന്നേക്കും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചരമനാൾ വരെ മാറ്റമെന്നിയേ",
        "പരമനിശ്ചയം മൂലം",
        "പരമൻ നീയെന്നെ പരിപാലിച്ചു",
        "കൊണ്ടിരുന്നിടുമെന്നും നിർണ്ണയം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തിരുമുഖമെന്നെ നോക്കിയിരിപ്പതതി",
        "ധൈര്യത്തിനു ഹേതുവാം",
        "മരണനിഴലിൻ വഴിയിൽകൂടി",
        "ഞാൻ നടന്നാലും തെല്ലും ഭയപ്പെടാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അഴിയാതുളെളാരു ജീവശക്തിയിൽ",
        "പുതുജനനത്തിൻ മക്കളായ്",
        "തിരുവചനത്താൽ ജനിപ്പിച്ചാത്മിക",
        "പുതുക്കം തന്നെന്നെ കാക്കുന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആരെ വിശ്വസിക്കുന്നെ -",
        "ന്നറിയുന്നുണ്ടു ഞാനിന്ന്",
        "അവനെനിക്കുളേളാരുപനിധി",
        "പരമവസാനം വരെ സൂക്ഷിക്കും"
      ]
    }
  ],
