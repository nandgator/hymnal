{
  "number": 448,
  "title": "യേശുവേ, നിന്നന്തികേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ക്രൂശിങ്കൽ ക്രൂശിങ്കൽ",
        "എൻപ്രശംസയെന്നും",
        "ലോകവാസം നീങ്ങി ഞാൻ",
        "വിശ്രമിക്കുവോളം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവേ, നിന്നന്തികേ",
        "ചേർക്കയെന്നെയെന്നും",
        "വിശ്രമമെൻ ദേഹിക്കു",
        "നൽകുവാൻ നീ മാത്രം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപഭാരം പേറി ഞാൻ",
        "ക്ഷീണനായ് നടന്നു",
        "നിന്റെ ക്രൂശിൻ ശക്തിയാൽ",
        "സ്വസ്ഥനായ് നിരന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഭാരമാകെ നീക്കിടും",
        "ഭൂരിസൗഖ്യമേകും",
        "ചാരുവാം നിൻ സന്നിധൗ",
        "ചേരുവോർക്കു ഭാഗ്യം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിന്നെ വിട്ടുപോകുവാ -",
        "നിന്നിവന്നസാദ്ധ്യം",
        "ധന്യരാണു കേവലം",
        "നിൻജനങ്ങളെന്നും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എന്നിലില്ലയൊന്നിനും",
        "ശക്തിലേശമോർക്കിൽ",
        "നിന്നിലാശ്രയിക്കയാൽ",
        "മോദമെന്നും മോദം"
      ]
    }
  ],
