{
  "number": 978,
  "title": "രാജാധിരാജൻ മഹിമയോടെ",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "രാജാധിരാജൻ മഹിമയോടെ",
        "വാനമേഘത്തിൽ എഴുന്നളളാറായ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ക്ലേശം തീർന്നു നാം നിത്യം വസിപ്പാൻ",
        "വാസം ഒരുക്കാൻ പോയ പ്രിയൻ താൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിന്ദ കഷ്ടത പരിഹാസങ്ങൾ",
        "ദുഷികളെല്ലാം തീരാൻ കാലമായി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പ്രാണപ്രിയന്റെ പൊന്നു മുഖത്തെ",
        "തേജസ്സോടെ നാം കാണ്മാൻ കാലമായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കാന്തനുമായി വാസം ചെയ്യുവാൻ",
        "കാലം സമീപമായി പ്രിയരേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഒരുങ്ങി നിന്നോർ തന്നോടുകൂടെ",
        "മണിയറയിൽ വാഴാൻ കാലമായ്"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "യുഗായുഗമായ് പ്രിയൻ കൂടെ നാം",
        "വാഴും സുദിനം ആസന്നമായി"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "കാഹളധ്വനി കേൾക്കും മാത്രയിൽ",
        "മറുരൂപമായ് പറന്നിടും നാം"
      ]
    }
  ],
