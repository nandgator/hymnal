{
  "number": 1325,
  "title": "തല്ലിയെന്നെ നോവിച്ചാലും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "തല്ലിയെന്നെ നോവിച്ചാലും",
        "പപ്പയ്ക്കുണ്ട് സ്നേഹം",
        "നുള്ളി വേദനിപ്പിച്ചാലും",
        "മമ്മിക്കുണ്ട് സ്നേഹം",
        "നല്ല കുട്ടിയായി ഞാന്‍",
        "വളര്‍ന്നു വന്നിടാന്‍",
        "ബാലശിക്ഷ നല്‍കുന്നു",
        "എന്‍ മാതാപിതാക്കള്‍"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വേദനകള്‍ തന്നെന്നാലും",
        "താതനുണ്ട് സ്നേഹം",
        "സങ്കടങ്ങള്‍ നല്‍കിയാലും",
        "കര്‍ത്തനുണ്ട് സ്നേഹം",
        "നല്ല കുട്ടിയായി ഞാന്‍",
        "വളര്‍ന്നു വന്നിടാന്‍",
        "ബാലശിക്ഷ നല്‍കുന്നു",
        "എന്‍ സ്വര്‍ഗ്ഗപിതാവ്"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    }
  ],
