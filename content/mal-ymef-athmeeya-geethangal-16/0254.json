{
  "number": 254,
  "title": "ഇമ്മാനുവേൽ തൻ ചങ്കതിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻപേർക്കേശു മരിച്ചെന്നു",
        "ഞാൻ വിശ്വസിക്കുന്നു",
        "പാപം എന്നിൽ നിന്നു നീക്കാൻ",
        "യേശു രക്തം ചിന്തി"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇമ്മാനുവേൽ തൻ ചങ്കതിൽ",
        "നിന്നൊഴുകും രക്തം",
        "പാപക്കറ നീങ്ങുമതിൽ",
        "മുങ്ങി തീർന്നാൽ ആരും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കള്ളൻ ക്രൂശിൽ പാപശാന്തി",
        "കണ്ടീയുറവയിൽ",
        "അവനെപ്പോൽ ഞാനും ദോഷി",
        "കണ്ടേൻ പ്രതിശാന്തി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കുഞ്ഞാട്ടിൻ വിലയേറിയ",
        "രുധിരത്തിൻ ശക്തി",
        "വീണ്ടുകൊള്ളും ദൈവസഭ",
        "ആകെ വിശേഷമായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തൻ മുറിവിൻ രക്തനീർ ഞാൻ",
        "കണ്ടന്നുമുതൽ തൻ -",
        "വീണ്ടെടുപ്പിൻ സ്നേഹം താനെൻ",
        "ചിന്ത ഇന്നുമെന്നും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വിക്കുള്ള എന്റെ ഈ നാവു",
        "ശവക്കുഴിക്കുള്ളിൽ",
        "മൗനം എന്നാൽ എന്നാത്മാവു",
        "പാടും ഉന്നതത്തിൽ"
      ]
    }
  ],
