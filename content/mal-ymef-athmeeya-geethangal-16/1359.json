  "title": "ബോലോ ജയ്, മിൽക്കർ ജയ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ബോലോ ജയ്, മിൽക്കർ ജയ്",
        "ബോലോ ജയ്, യിശു കീ ജയ്",
        "ബോലോ ജയ് ജയ് ജയ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പ്രേം കി തേരെ യഹീ രീത്",
        "മൻ മേം ഭർ ദേ അപ്നി പ്രീത്",
        "തേരേ പ്രേം കെ ഗായേം ഗീത്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ക്രൂസ് പർ അപ്നാ ഖൂൻ ബഹാ",
        "മുഝ് പാപീ കോ ദീ ഷിഫാ",
        "മൻ മേരേ തു ബോല് സദാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തേരി കുദ് രത് കീ യഹ് ശാൻ",
        "ഖൂദ് ഹീ ദാതാ ഖൂദ് ഹീ ദാൻ",
        "പൂരെ കർ മൻ കെ അർമാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഖിദ്മത് അപ്നി ലേ മുഝ് സെ",
        "ഇസ് മന്ദിർ മെം തൂ ഹി ബസെ",
        "ജഗ് മെം തേരാ നാമ് രഹെ"
      ]
