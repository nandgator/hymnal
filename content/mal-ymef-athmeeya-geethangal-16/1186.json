{
  "number": 1186,
  "title": "നീ കൂടെ പാർക്കുക",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നീ കൂടെ പാർത്തിടേണം",
        "നിത്യം കാത്തിടേണം",
        "എപ്പോഴും നിറയ്ക്കേണം",
        "നിൻ ആത്മാവാൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "എൻ യേശു രാജനേ!",
        "നിൻ ദിവ്യപ്രതിമ -",
        "എന്നിൽ തികയ്ക്കുകേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "സാത്താൻ പരീക്ഷിക്കിൽ",
        "ഒരാപത്തും ഇല്ലാ",
        "നിൻ സന്നിധാനത്തിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "ഈ ലോകമദ്ധ്യത്തിൽ",
        "നീ പ്രാപ്തൻ രക്ഷകാ -",
        "കാപ്പാൻ നിൻ സത്യത്തിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "എന്നാൽ കഷട്ത്തിലും",
        "ഞാൻ ക്ഷീണത വിനാ -",
        "നിൻ സ്നേഹം പുകഴ്ത്തും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "വിശ്വാസസാക്ഷിക്കായ്",
        "എപ്പോഴും ധൈര്യം താ -",
        "താ ജ്ഞാനത്തിന്റെ വായ്"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "എന്നിൽ ഒരറിവും",
        "ഇല്ല നിന്നിലല്ലാ -",
        "തില്ലൊരു കഴിവും"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "വിട്ടാലും ഏവരും",
        "നീ എന്നെ കൈവിടാ -",
        "തെന്നേക്കും സ്നേഹിക്കും"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "നീ കൂടെ പാർക്കുക",
        "വന്നാലും മരണം",
        "എൻജീവനായക!",
        "നീ അന്നും ശരണം"
      ]
    }
  ],
