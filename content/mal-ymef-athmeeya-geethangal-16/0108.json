{
  "number": 108,
  "title": "സ്തുതിഗീതം പാടുക നാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്തുതിഗീതം പാടുക നാം",
        "ഉയർത്തുക ജയനാമം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്തുതിക്കു യോഗ്യനവൻ",
        "സർവ്വശക്തൻ യഹോവയവൻ",
        "നമ്മെ സ്നേഹിച്ചു നമ്മെ വീണ്ടെടുത്തു",
        "സ്വന്തജനമായ് തീർത്തതിനാൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രോഗിക്കു വൈദ്യനവൻ",
        "സർവ്വശക്തൻ യഹോവയവൻ",
        "സൗഖ്യം നൽകി താൻ ശക്തിയേകിടും",
        "എന്നും ആശ്വാസം പകരുമവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സേനകളിൻ നായകൻ",
        "സർവ്വശക്തൻ യഹോവയവൻ",
        "അവൻ മുമ്പിലും അവൻ പിമ്പിലും",
        "നമ്മെ ജയത്തോടെ നടത്തിടുമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രാജാധിരാജനവൻ",
        "സർവ്വശക്തൻ യഹോവയവൻ",
        "സ്തുതിസ്തോത്രവും എല്ലാ പുകഴ്ചയും",
        "അവനെന്നെന്നും ആമേൻ"
      ]
    }
  ],
