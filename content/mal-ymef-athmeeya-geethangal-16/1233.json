{
  "number": 1233,
  "title": "പോയ രാവിൽ മുഴുവൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പോയ രാവിൽ മുഴുവൻ",
        "കരുണയോടെന്നെ സൂക്ഷിച്ച നാഥാ",
        "നന്ദിയോടെ തിരുസ്നേഹത്തിനായി",
        "ഞാൻ വന്ദനം ചെയ്തിടുന്നു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അന്ധകാരം നിറഞ്ഞു",
        "പലപല തിന്മകൾ വാണിരുന്ന",
        "രാവിൽ തവ ദൂതരിൻ കാവൽ തന്നു",
        "എന്നെ സൂക്ഷിച്ചതിനാൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മന്നിതിൽ മർത്യഗണം",
        "പലവിധ കഷ്ടനഷ്ടം സഹിക്കും",
        "നേരമെനിക്കു തന്ന സുഖം",
        "സമാധാനമിവ നിനച്ചു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദുഃഖങ്ങൾ വന്നിടിലും തവദാസൻ",
        "രോഗിയായ് തീർന്നിടിലും",
        "ദുഃഖം സഹിച്ച നാഥാ!",
        "തിരുകൃപ തന്നു പാലിക്കണമേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഇന്നു പകൽ മുഴുവൻ",
        "തിരുഹിതമെൻ മോദമായിരിപ്പാൻ",
        "സ്വർഗ്ഗീയമന്ന തന്നു അടിയനു",
        "ശക്തിപകർന്നിടണേ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഇന്നെന്റെ ക്രിയകളും മാത്രമല്ല",
        "വാക്മനോഭാവങ്ങളും",
        "ശുദ്ധമായ് സൂക്ഷിക്കുവാൻ",
        "ശുദ്ധാത്മാവാൽ എന്നെ നയിക്കണമേ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "പാപാന്ധകാരത്തിനാൽ നിറഞ്ഞതാം",
        "പാരിതിൽ ജ്യോതിസ്സുപോൽ",
        "പാരം പ്രകാശമേകി പാർത്തിടുവാൻ",
        "പ്രാപ്തനായ് തീർത്തിടണേ"
      ]
    }
  ],
