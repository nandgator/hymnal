{
  "number": 955,
  "title": "വന്നിടും യേശു വന്നിടും വേഗം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വന്നിടും യേശു വന്നിടും വേഗം",
        "മന്നിതിൽ വന്നിടുമേ",
        "വല്ലഭനേശു ഉന്നതനാഥൻ",
        "വന്നിടും മേഘമതിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മന്നവൻ വരുമേ പ്രതിഫലം തരുമേ",
        "നിശ്ചയമായ് വരുമേ",
        "മണ്ണിൽനിന്നുയരും ഭക്തഗണങ്ങൾ",
        "വിണ്ണിൽ തന്നരികിൽ ചേർന്നിടുമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ലോകം മുഴുവൻ ഭരണം നടത്താൻ",
        "ശോകമകറ്റിടുവാൻ",
        "യൂദയിൻ സിംഹം രാജാധിരാജൻ",
        "മേദിനി തന്നിൽ വന്നിടുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സർവ്വസൃഷ്ടിയുമൊന്നു പോലിന്നു",
        "കാത്തു ഞരങ്ങിടുന്നു",
        "ശാപമകറ്റാൻ സ്വാതന്ത്ര്യമേകാൻ",
        "ശാലേമിൻ രാജൻ വന്നിടുമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പശി ദാഹമെല്ലാം പറന്നകലും",
        "തൻ പരിശുദ്ധഭരണമതിൽ",
        "നീതിയിൻ സൂര്യൻ സ്നേഹക്കതിരാൽ",
        "ഭീതിയിരുൾ നിര നീക്കിടുമേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വരണം യേശുരാജൻ വരണം",
        "സത് ഭരണം വരണം",
        "വന്നേ തോരൂ ഭക്തരിൻ കണ്ണീ -",
        "രന്നേ തീരൂ വേദനകൾ"
      ]
    }
  ],
