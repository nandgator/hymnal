{
  "number": 532,
  "title": "ഞങ്ങളുടെ വാസസ്ഥല -",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഞങ്ങളുടെ വാസസ്ഥല -",
        "മെന്നും പരൻ നീ",
        "ഭംഗമില്ലുലകിന്നും മലകൾക്കും",
        "ബഹുമുൻ നീ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നാശത്തിൽ തിരിക്കുന്നു",
        "മാനുജകുലത്തെ നീ",
        "നാശത്തിൽനിന്നു വീണ്ടും",
        "വരുത്തുന്നായവരെ നീ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആയിരം സമകൾ നിൻ കാഴ്ചയിൽ",
        "തലേനാൾ പോൽ",
        "നായകാ! നിനക്കായതൊരു",
        "യാമമതുതാൻ നീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വൻവെളളമതുപോൽ",
        "നീ തളളിടും നരന്മാരെ",
        "വൻനിദ്രയതുപോൽ രാവിലെ",
        "പുല്ലിൻ സ്ഥിതിപോൽ നീ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആയുസ്സെത്രയുമൽപ്പം",
        "കൂടിടുകിലും ദുഃഖം",
        "വേഗത്തിലറുക്കപ്പെട്ടകന്നിടും",
        "ക്ഷണത്തിൽ നീ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കാരുണ്യങ്ങളാൽ ഞങ്ങൾ",
        "ക്കേകിടേണം നീ തൃപ്തി",
        "ആകിൽ ഞങ്ങളെന്നാളും",
        "ആനന്ദിച്ചുകൊളളും നീ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഞങ്ങളിൻ ഹൃദയം നിന്നുടെ",
        "ജ്ഞാനം ഗ്രഹിച്ചിടാൻ",
        "ഞങ്ങളിൻ ദിനമെല്ലാം",
        "എണ്ണുവാനരുൾക നീ"
      ]
    }
  ],
