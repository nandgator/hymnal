{
  "number": 768,
  "title": "യോർദ്ദാൻ നദിതീരം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യോർദ്ദാൻ നദിതീരം",
        "കവിയുമ്പോൾ - മനമേ",
        "ഓളങ്ങൾ കണ്ടു നീ",
        "കലങ്ങണ്ടാ - തെല്ലുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വെളളം പെരുകിയാലുളളം പതറേണ്ട",
        "വല്ലഭനേശു നിൻ അരികിലുണ്ടല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നല്ലോർ വിശ്വാസത്തിൽ",
        "സ്വർലോകപാതയിൽ",
        "കല്ലോലമേടുകളൊതുങ്ങി നിന്നിടും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അൻപുളള രക്ഷകൻ",
        "മുൻപിൽ നടക്കവേ",
        "തുമ്പം വരികിലെന്നും തുണയവനല്ലോ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഭീതി വേണ്ടൊട്ടുമേ",
        "മുമ്പോട്ടു പോക നീ",
        "ഏതു വിഷമവും യേശു തീർത്തിടും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പാൽ തേനൊഴുകിടും",
        "പാവന നാട്ടിൽ നാം",
        "പാർത്തിടുമാനന്ദഗീതം പാടിടും"
      ]
    }
  ],
