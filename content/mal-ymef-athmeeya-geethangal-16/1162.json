{
  "number": 1162,
  "title": "ആകാശമേ കേൾക്ക",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആകാശമേ കേൾക്ക",
        "ഭൂമിയെ ചെവിതരിക",
        "ഞാൻ മക്കളെ പോറ്റി വളർത്തി",
        "അവരെന്നോടു മത്സരിക്കുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാള തന്റെ ഉടയവനെ",
        "കഴുത തന്റെ യജമാനന്റെ",
        "പുൽതൊട്ടി അറിയുന്നല്ലോ",
        "എൻ ജനം അറിയുന്നില്ല"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അകൃത്യഭാരം ചുമക്കും ജനം",
        "ദുഷ്‌പ്രവൃത്തിക്കാരുടെ മക്കൾ",
        "വഷളായി നടക്കുന്നവർ",
        "ദൈവമാരെന്നറിയുന്നില്ല"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആകാശത്തിൽ പെരിഞ്ഞാറയും",
        "കൊക്കും മീവൽപ്പക്ഷിയും",
        "അവ തന്റെ കാലമറിയും",
        "എൻജനം അറിയുന്നില്ല"
      ]
    }
  ],
