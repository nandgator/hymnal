{
  "number": 1362,
  "title": "പാവൻ രെൻ, പാവൻ രൈൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാവൻ രെൻ, പാവൻ രൈൻ",
        "സാരേ ലോഗ് കർതേ ചൈൻ",
        "ജാഗ് തി ബൈഠീ ഹെ കന്യാ പുനീത്",
        "ഗോദ് മെം ലിയേ ഏക് ബാലക് സപ്രീത്",
        "ധന്യ, ധന്യ ബാലക് അനുപ്!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാവൻ രാത്, പാവൻ രാത്",
        "കൈസി യഹ് മംഗൽ ബാത്!",
        "ദുതഗണ് ലായേ ആനന്ദ് ഭർപുർ",
        "സുനോ ഭാഈയോം നികട് ഔർ ദൂർ",
        "യീശു ത്രാതാ ആയാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാവൻ രൈൻ, പാവൻ രൈൻ",
        "ഈശ്വർ - പൂത് പ്രേം ആധാർ",
        "കർ നിത് മദ്ധ്യ ഹമാരേ നിവാസ്",
        "തൂ ഹമാരാ ത്രാണ് ഔർ ആസ്",
        "ജയ് ജയ് തേരീ സദാ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
