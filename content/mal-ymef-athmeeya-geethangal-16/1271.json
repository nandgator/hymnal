{
  "number": 1271,
  "title": "യേശുവിനെ ഞാന്‍",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിനെ ഞാന്‍",
        "എന്നും പിന്‍ചെല്ലും",
        "പിന്‍ നോക്കാതെ, പിന്‍നോക്കാതെ",
        "എല്ലാരുമെന്നെ കൈവിട്ടെന്നാലും",
        "പിന്‍ ചെല്ലും ഞാന്‍ പിന്‍നോക്കാതെ",
        "ക്രൂശെന്റെ മുമ്പില്‍",
        "ലോകമെന്‍ പിമ്പില്‍",
        "പിന്‍ ചെല്ലും ഞാന്‍ പിന്‍നോക്കാതെ"
      ]
    }
  ],
