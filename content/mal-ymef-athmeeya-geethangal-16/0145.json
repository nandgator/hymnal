{
  "number": 145,
  "title": "എൻ യേശു എൻ ഇമ്മാനുവേൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻ യേശു എൻ ഇമ്മാനുവേൽ",
        "ഞാൻ നിൽക്കുന്നതീ പാറമേൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നീതിയും വിശുദ്ധിയും",
        "എൻ യേശുവും തൻരക്തവും",
        "വേറില്ല ആത്മശരണം",
        "വേറില്ല പാപഹരണം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വൃഥാവിൽ സ്വയനീതികൾ",
        "വൃഥാവിൽ ചത്ത രീതികൾ",
        "ദൈവത്തിൻ മുമ്പിൽ നിൽക്കുവാൻ",
        "രക്തത്താലത്രേ പ്രാപ്തൻ ഞാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഈ രക്തത്തിലെൻ ഹൃദയം",
        "ഹിമത്തെക്കാളും നിർമ്മലം",
        "എന്നുരയ്ക്കുന്ന വചനം",
        "തീർക്കുന്നു സർവ്വ സംശയം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആരെന്നെ കുറ്റം ചുമത്തും",
        "ആർ ശിക്ഷയ്ക്കെന്നെ വിധിക്കും",
        "ഞാൻ ദൈവനീതി ആകുവാൻ",
        "പാപമായ് തീർന്നെൻ രക്ഷകൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സംഹാരദൂതൻ അടുത്താൽ",
        "ഈ രക്തം എൻമേൽ കാൺകയാൽ",
        "താൻ കടന്നുപോം ഉടനെ",
        "നിൻവീടു ദൈവസുതനേ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "വൻമഴ പെയ്യും നേരത്തും",
        "ഞാൻ നിർഭയമായിരിക്കും",
        "കാറ്റടിച്ചാലും ഉച്ചത്തിൽ",
        "പാടിടും ഞാൻ എൻ കോട്ടയിൽ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "വീണാലും പർവ്വതങ്ങളും",
        "മാഞ്ഞാലും ആകാശങ്ങളും",
        "ക്രിസ്തുവിൻ രക്തനിയമം",
        "മാറാതെ നിൽക്കും നിശ്ചയം"
      ]
    }
  ],
