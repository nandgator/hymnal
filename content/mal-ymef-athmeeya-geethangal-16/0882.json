{
  "number": 882,
  "title": "എന്നേശുവേ നീയാശ്രയം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നേശുവേ നീയാശ്രയം",
        "ഈ ഭൂവതിൽ നീയാശ്രയം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മർത്ത്യരിലാശ്രയം എനിക്കില്ല",
        "പ്രഭുക്കന്മാരിലുമില്ലെനിക്ക്",
        "എന്റെ ആശ്രയം യാഹ് തന്നെ",
        "ശാശ്വതമായൊരു പാറ തന്നെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ധനത്തിലാശ്രയമെനിക്കില്ല",
        "സൗന്ദര്യത്തിലുമില്ലെനിക്ക്",
        "പരമസമ്പന്നൻ എൻ മാനുവേൽ",
        "അതീവസുന്ദരൻ മൽപ്രാണൻ താൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലോകത്തിലെൻ മനം ചായുകയില്ല",
        "സമ്പത്തിലെൻ മനം വീഴുകില്ല",
        "എന്നവകാശവും ഓഹരിയും എന്നുടെ",
        "പങ്കെല്ലാം താതൻ തന്നെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഒരിക്കൽ വന്നിടും എന്നെ ചേർപ്പാൻ",
        "നിൻ മാറോടണഞ്ഞിടും",
        "ഏഴയാം ഞാൻ ആണികളേറ്റ",
        "പാണി ഞാൻ കണ്ട്",
        "സുന്ദരവദനത്തിൽ മുത്തിടും ഞാൻ"
      ]
    }
  ],
