{
  "number": 243,
  "title": "എൻ ജീവനാഥാ എൻ പേർക്കായ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻ ജീവനാഥാ എൻ പേർക്കായ്",
        "ക്രൂശിൽ മരിച്ചു നീ",
        "എൻ പാപം പോക്കാൻ യാഗമായ്",
        "രക്തം ചൊരിഞ്ഞു നീ",
        "വന്ദിക്കുന്നു നിൻ പാദത്തിൽ",
        "നന്ദിയോടിന്നും രക്ഷകാ",
        "ആരാധിച്ചിടുന്നു എൻ",
        "ആത്മാവിൽ മോദമാ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്വർഗ്ഗത്തിൽ സത്യകൂടാരം",
        "സ്ഥാപിച്ച നായകാ",
        "മൺപാത്രമായ എന്നിൻ നിൻ",
        "സ്നേഹം പകർന്നല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിൻ മാർവ്വിൽ എന്നെ ചേർത്തതാൽ",
        "ഞാൻ എത്ര ഭാഗ്യവാൻ",
        "നിത്യമാം ജീവൻ തന്നതാൽ",
        "പാടിടും എന്നും ഞാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ ദേഹം ദേഹി ആത്മാവും",
        "നിൻ സന്നിധാനത്തിൽ",
        "വീണു വണങ്ങി യാഗമായ്",
        "സർവ്വവും നൽകുന്നേൻ"
      ]
    }
  ],
