{
  "number": 993,
  "title": "കാണുമീയെൻ രാജനെ",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "കാണുമീയെൻ രാജനെ",
        "ഞാൻ തന്റെ സൂര്യ -",
        "പ്രഭയെഴുമഴകൊടു",
        "കാണുമീയെൻ രാജനെ",
        "കാണും ഞാനെൻ രാജനെ",
        "കാണും ഞാനെൻ",
        "കാണും ഞാനെൻ രാജനെ",
        "സൂര്യപ്രഭയൊടു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാറക്കോട്ടയ്ക്കുളളിൽ",
        "ഞാൻ പാർക്കും",
        "നിത്യം പാർക്കും നിത്യം",
        "ഭീതി കൂടാതെ പരമിനി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എന്റെ വെളളം നിശ്ചയം",
        "എന്റെ അപ്പം എന്റെ അപ്പം",
        "മുട്ടുകില്ലൊട്ടും പരമിനി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വിസ്തീർണ്ണമാം ദിക്കിനെ",
        "വിസ്തീർണ്ണമാം വിസ്തീർണ്ണമാം",
        "ദിക്കു കണ്ടിടും പരമിനി"
      ]
    }
  ],
