{
  "number": 553,
  "title": "കരുതുന്നു നമ്മളെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കരുതുന്നു നമ്മളെ",
        "കർത്താവു നിത്യവും",
        "കലങ്ങേണ്ടതൻ ജനമേ",
        "ആമയം തീർത്തവൻ",
        "ചേലൊടു പോറ്റിടും",
        "എന്നും നിർണ്ണയമായ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വിലയേറും തൻ ചോര",
        "വിലയായ് തന്നെന്നെ",
        "വിമലജൻ വാങ്ങിയല്ലോ",
        "ഇതുപോലെ സ്നേഹിച്ചു",
        "ജീവനും നൽകുവാൻ",
        "ആരു തുനിഞ്ഞിടുമോ?"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മുന്നിലെ ചെങ്കടൽ",
        "പിന്നിലെ വൻ പട",
        "തന്നിലും തൻജനത്തെ",
        "ഖിന്നത തീർത്തുടൻ",
        "അക്കരെയെത്തിച്ചോൻ",
        "എന്നും നമ്മൾക്കുണ്ട്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മരുവാസമേകും",
        "പ്രതികൂലമെത്രയും",
        "മധുരമായ് മാറ്റുമവൻ",
        "മരണത്തിൻ നിഴലിലും",
        "പതറാതെ നിർത്തുവാൻ",
        "മുറ്റും ശക്തനവൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വീടൊന്നൊരുക്കി ഹാ!",
        "വേഗത്തിൽ വന്നിടും",
        "വീട്ടിൽ കൈക്കൊണ്ടിടും",
        "താൻ നിത്യതമുഴുവനും",
        "പിരിയാതെ വാഴും നാം",
        "നിത്യവും ആനന്ദമായ്"
      ]
    }
  ],
