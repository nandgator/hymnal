{
  "number": 1333,
  "title": "സ്വര്‍ഗ്ഗം എത്ര സുന്ദരദേശം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്വര്‍ഗ്ഗം എത്ര സുന്ദരദേശം",
        "എന്റെ യേശു രാജന്‍ വാഴുന്ന ദേശം",
        "ഞാനൊരിക്കാലങ്ങ് പോകുമേ - അവിടെ",
        "ഹല്ലേലൂയ്യ ആര്‍ത്തുപാടുമേ",
        "ഹല്ലേലൂയ്യ ഓശാന"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നരകം എത്ര ഭീകരദേശം",
        "ദുഷ്ടസാത്താനെന്നും വാഴുന്ന ദേശം",
        "അവന്റെ മക്കള്‍ അവിടെപ്പോകുമേ",
        "അവിടെ കണ്ണുനീരും മുറവിളിയുമേ",
        "അയ്യോ അയ്യോ അയ്യയ്യോ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    }
  ],
  "meta": {
    "author": "GK"
  }
}
