{
  "number": 582,
  "title": "കർത്താവിനായ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കർത്താവിനായ്",
        "പാരിലെന്റെ ജീവകാലമെല്ലാം",
        "പാർത്തിടും ഞാൻ സ്തോത്രഗീതം പാടി"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്റെ പാപശാപമെല്ലാം",
        "നീക്കി - കർത്തൻ",
        "എന്നെ ദൈവപൈതലാക്കി മാറ്റി",
        "സന്താപങ്ങൾ തീർന്നിന്നാകയാൽ",
        "ഞാൻ പാടും",
        "സന്തോഷത്തിൻ സംഗീതമുച്ചത്തിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആകുലങ്ങൾ തിങ്ങിടുന്ന",
        "നേരം - എന്നിൽ",
        "ആശ്വാസം പകർന്നു നാഥൻ കാക്കും",
        "ആപത്തിലും തെല്ലും",
        "മാറാതെ നിന്നെന്നെ",
        "ആണിയേറ്റ പാണിയാൽ താൻ താങ്ങും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശത്രു നേരെ വന്നെതിർ -",
        "ത്തെന്നാലും എന്റെ",
        "യാത്രാമദ്ധ്യേ എന്തു നേരിട്ടാലും",
        "കർത്താവിൽ ഞാൻ ചാരി",
        "തൻ മുഖത്തെ നോക്കി",
        "യാത്രചെയ്യും ക്രൂശെടുത്തിപ്പാരിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വാട്ടം മാലിന്യമില്ലാത്ത നാട്ടിൽ - നിത്യ",
        "വീട്ടിൽ ചെന്നു ചേരും നാൾവരെയും",
        "വീഴാതെന്നെ കൈയിൽ",
        "വിശ്വസ്തനായ് കാത്തു",
        "വിശ്വാസത്തിൻ നായകൻ നടത്തും"
      ]
    }
  ],
