{
  "number": 1548,
  "title": "താങ്ങും കരങ്ങൾ ഉണ്ട്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "താങ്ങും കരങ്ങൾ ഉണ്ട്",
        "നിന്റെ ഹൃദയം തകരുമ്പോൾ",
        "ശാശ്വതപാറ യേശു",
        "പുതുജീവൻ പകർന്നിടും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഭാരം വലിയതോ",
        "നുകം താങ്ങുവാൻ കഠിനമോ",
        "സ്നേഹിതർ ദുഷിക്കുന്നോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കണ്ണു നീരിൻ താഴ് വരകൾ",
        "അതി ഘോരമാം മേടുകളും",
        "മരണത്തിൻ കൂരിരുൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കാൽവറി മലമുകളിൽ",
        "കൊടുംകാരിരുമ്പാണികളിൽ",
        "തിരുരക്തം ചൊരിഞ്ഞവനിൽ"
      ]
    }
  ],
