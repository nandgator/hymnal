{
  "number": 1367,
  "title": "ഛോട് ന മുഝേ പ്യാരേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യീശു! യീശു! ബിൻതീ സുൻ മേരീ",
        "ഔരോം പർ തൂ ദയാ കർതാ",
        "കർ തൂ മുഝ് പർ ഭീ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഛോട് ന മുഝേ പ്യാരേ",
        "യീശു ബിൻതീ സുൻ മേരീ",
        "ഔരോം പർ തൂ ദയാ കർതാ",
        "കർ തൂ മുഝ് പർ ഭീ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തേരേ പാസ് ഹേ ദയാ",
        "സിന്ധു ശാന്തി പാഊംഗാ",
        "ഝുക്താ ഹൂം മേം തേരേ",
        "സാമ്നേ അബ് വിശ്വാസ് ദിലാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തുഝ് പർ പൂരീ ആസ് മേം",
        "രഖ്താ അപ്നാ മുഖ് ദിഖ് ലാ",
        "ചംഗാ കർ ഇസ് ഘായൽ മൻ",
        "കോ ദയാ സേ ബചാ"
      ]
    }
  ],
