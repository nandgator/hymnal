{
  "number": 234,
  "title": "ആരാധിക്കുന്നു ഞങ്ങൾ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആരാധിക്കുന്നു ഞങ്ങൾ",
        "നിൻസന്നിധിയിൽ",
        "സ്തോത്രത്തോടെന്നും",
        "ആരാധിക്കുന്നു ഞങ്ങൾ",
        "നിൻ സന്നിധിയിൽ",
        "നന്ദിയോടെന്നും",
        "ആരാധിക്കുന്നു ഞങ്ങൾ",
        "നിൻസന്നിധിയിൽ",
        "നന്മയോർത്തെന്നും",
        "ആരാധിക്കാം യേശുകർത്താവിനെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നമ്മെ സർവ്വം മറന്ന്",
        "തൻ സന്നിധിയിൽ മോദമോടെന്നും",
        "നമ്മെ സർവ്വം മറന്ന്",
        "തൻ സന്നിധിയിൽ ധ്യാനത്തോടെന്നും",
        "നമ്മെ സർവ്വം മറന്ന്",
        "തൻ സന്നിധിയിൽ കീർത്തനത്തിനായ്",
        "ആരാധിക്കാം യേശു കർത്താവിനെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നീയെൻ സർവ്വനീതിയും",
        "ആയിതീർന്നതാൽ ഞാൻ പൂർണ്ണനായ്",
        "നീയെൻ സർവ്വനീതിയും",
        "ആയിതീർന്നതാൽ ഞാൻ ഭാഗ്യവാൻ",
        "നീയെൻ സർവ്വനീതിയും",
        "ആയിതീർന്നതാൽ ഞാൻ ധന്യനായ്",
        "ആരാധിക്കാം യേശുകർത്താവിനെ"
      ]
    }
  ],
