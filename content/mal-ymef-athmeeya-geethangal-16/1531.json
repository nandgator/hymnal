{
  "number": 1531,
  "title": "ആരാധന എൻ ദൈവത്തിന്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആരാധന എൻ ദൈവത്തിന്",
        "ആരാധന എൻ പിതാവിന്",
        "ആകാശം മെനഞ്ഞ ആഴിയെ നിർമ്മിച്ച",
        "ആരാധ്യനാം ദേവനാരാധന"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആരാധന എന്നേശുവിന്",
        "ആരാധന എൻ രക്ഷകന്",
        "ആദ്യനും അന്ത്യനും ആരാലും വന്ദ്യനും",
        "ആയവനാം കർത്താവിനാരാധന"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആരാധന ശുദ്ധത്മാവിന്",
        "ആരാധന നിത്യാത്മാവിന്",
        "ആശ്വാസപ്രദനും നൽവഴി കാട്ടിയും",
        "ആയവനാം ആത്മാവിനാരാധന"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
