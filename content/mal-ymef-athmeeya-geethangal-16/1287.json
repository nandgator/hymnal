{
  "number": 1287,
  "title": "ബാലകരെ കൂടിടാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ബാലകരെ കൂടിടാം",
        "സാമോദം നാം പാടിടാം",
        "പാലകനാം യേശു തന്റെ",
        "പാവനനാമം വാഴ്ത്തിടാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ശിശുക്കളെ തന്നരികിൽ",
        "അയപ്പാതെ തടയരുതെ",
        "സ്വർഗ്ഗരാജ്യം അവരുടെയും",
        "അവരെപ്പോലുള്ളോർക്കും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വാ എന്നരികിലെന്നാഹ്വാനാം",
        "വാത്സല്യത്തോടെവർക്കും",
        "വാരിവിതറും വല്ലഭനെ",
        "വാനോളം നാം വാഴ്ത്തിടേണം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കാൽവറിയിൽ കരളുരുകി",
        "കാൽകരങ്ങൾ ആണികൾക്കായി",
        "ദാരുണാം വിധം അർപ്പിച്ച",
        "കാരുണ്യത്തെ വാഴ്ത്തിടാം"
      ]
    }
  ],
