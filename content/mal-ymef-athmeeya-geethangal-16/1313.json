{
  "number": 1313,
  "title": "ഹല്ലേലൂയ്യ പാടാം എല്ലനാളും പാടാം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഹല്ലേലൂയ്യ പാടാം എല്ലനാളും പാടാം",
        "വല്ലഭാനെശുവിനു - ആഹാ -",
        "തുല്ല്യമിള്ളതവന്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കുട്ടികള്‍ നമ്മള്‍ കൂടി",
        "കൂട്ടമായാനന്തത്തോടെ",
        "തംബുരുമീട്ടിടാം  - ആഹാ -",
        "തപ്പുമുഴക്കിടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപികളായവരാം നാം,",
        "പാവനരായിടുവനായ്",
        "പാതയൊരുക്കിയവാന്‍ - ആഹാ -",
        "പാലകനേശുപരന്‍"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
