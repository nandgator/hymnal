{
  "number": 300,
  "title": "മഹാത്ഭുതം മഹോന്നതം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മഹാത്ഭുതം മഹോന്നതം",
        "മാ പാപിയെന്നെ നീ",
        "മാറോടണച്ച സ്നേഹമേ",
        "മാറാത്ത സ്നേഹമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അനാഥനല്ല ഞാനിനി",
        "നിൻപ്രിയ സൂനുവാം",
        "അനാദിയന്ത സ്നേഹത്താൽ",
        "വിനാശം പോക്കി നീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കണ്ണീരിൻ താഴ് - വരയിലും",
        "വൻ കൂരിരുളിലും",
        "കാണും ഞാൻ നാഥാ നിൻ കൃപാ -",
        "കരങ്ങൾ സർവ്വദാ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിൻ സന്നിധിയണയുമ്പോൾ",
        "നിൻ പാദം ചേരുമ്പോൾ",
        "നിരന്തരം ഞാൻ പാടിടും",
        "നിസ്സീമമാം സ്നേഹം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
