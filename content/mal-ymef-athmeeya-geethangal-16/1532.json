{
  "number": 1532,
  "title": "സ്തോത്രങ്ങൾ അർപ്പിച്ച്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്തോത്രങ്ങൾ അർപ്പിച്ച്",
        "വീണു വണങ്ങുന്നു എൻ ദൈവമെ",
        "തിരുനാമമല്ലാതില്ല",
        "വാനിലും ഭൂവിലും ആരാധ്യമായ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സർവ്വം ചമച്ചവനാകും",
        "സർവേശ്വരാ നമിക്കുന്നേൻ",
        "ഉർവിയതിൽ മനുഷ്യർക്കായി",
        "പുത്രനെ തന്നതാൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഏകജാതനായവനെ ഏകിയ",
        "സ്നേഹത്തെയോർത്തു",
        "ആത്മാവിലും ആത്മാർത്ഥമായും",
        "ആരാധിക്കും ഞങ്ങൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രൂശിൽ മരണം സഹിച്ച",
        "രക്ഷകനാം യേശുവിനും",
        "അന്ത്യത്തോളം കൂടെ വസിക്കും",
        "ആത്മാവിനും തോത്രം"
      ]
    }
  ],
