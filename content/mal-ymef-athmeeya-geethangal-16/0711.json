{
  "number": 711,
  "title": "യേശുവിൻ മധുരനാമം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "മാധുര്യ നാമമേ",
        "പാരിന്നാശ സ്വർമോദം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിൻ മധുരനാമം",
        "എപ്പോഴും സ്മരിക്കുക",
        "ആശ്വാസം നിനക്കതേകും",
        "ലേശം ഇല്ല സംശയം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഹാ! പ്രിയതമം ആ നാമം",
        "ഹൃദയത്തിന്നു സദാ",
        "കഷ്ടത്തിൽ അവനെ ഓർക്ക",
        "കിട്ടും തൻ കൃപയുടൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഏതവസ്ഥയിങ്കലും താൻ",
        "സാദരം തരും തുണ",
        "വിശ്വാസത്തിൻ കണ്ണുയർത്തി",
        "യേശുവെ വിളിക്ക നീ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നിൻസ്വയം അവന്റെ ക്രൂശിൽ",
        "നിന്നിറങ്ങിടാതെ നീ",
        "എന്നും തന്നിൽ വാസം ചെയ്കിൽ",
        "തന്നിടും അവൻ ബലം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ശത്രു നിന്നെ നേരിടുന്ന",
        "മാത്രയിൽ നിനയ്ക്കുക",
        "നിന്നിൽ സർവ്വശക്തനായ് താൻ",
        "എന്നും വാസം ചെയ്യുന്നു"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഹൃത്തിൽ എന്നും പാർത്തിടുന്ന",
        "ക്രിസ്തു രക്ഷകന്റെ മേൽ",
        "ആശ്രയം സദാ പതിപ്പോർ",
        "വാഴും ജീവനിൽ മുദാ"
      ]
    }
  ],
