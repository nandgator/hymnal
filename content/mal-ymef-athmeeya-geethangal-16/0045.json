{
  "number": 45,
  "title": "കർത്താവിനെ നാം സ്തുതിക്ക",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നാം സ്തോത്രം സ്തോത്രം",
        "സ്തോത്രം കഴിക്ക",
        "സ്തോത്രം സ്തോത്രം",
        "നാം സ്തോത്രം കഴിക്ക"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കർത്താവിനെ നാം സ്തുതിക്ക",
        "ഹേ! ദൈവമക്കളേ",
        "സന്തോഷത്തിൽ നാം അർപ്പിക്ക",
        "സ്തോത്രത്തിൻ ബലിയെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വിശുദ്ധ സ്നേഹബന്ധത്താൽ",
        "ഒരേ ശരീരമായ്",
        "നാം ചേർക്കപ്പെട്ടതാകയാൽ",
        "ചേരുവിൻ സ്തുതിക്കായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പിതാവു ഏകജാതനെ",
        "നമുക്കു തന്നല്ലോ",
        "ഹാ! സ്നേഹത്തിൻ അഗാധമേ",
        "നിന്നെ ആരായാമോ?"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നാം പ്രിയപ്പെട്ട മക്കളായ്",
        "വിളിച്ചപേക്ഷിപ്പാൻ",
        "തൻ ആത്മാവെ അച്ചാരമായ്",
        "നമുക്കു നൽകി താൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഒരേദൻ തോട്ടം പോലിതാ",
        "തൻ വചനങ്ങളാം",
        "വിശിഷ്ടഫലം സർവ്വദാ",
        "ഇഷ്ടംപോൽ ഭക്ഷിക്കാം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഈ ലോകത്തിൻ ചിന്താകുലം",
        "ദൈവാശ്രിതർക്കില്ല",
        "തൻ പൈതങ്ങളിൻ ആവശ്യം",
        "താൻ കരുതും സദാ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "കർത്താവിൻ നാമം നിമിത്തം",
        "അനേക കഷ്ടവും",
        "നേരിടുമ്പോഴും ധന്യർ നാം",
        "ഇല്ലൊരു നഷ്ടവും"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ഈ വിതയ്ക്കുന്ന കാലം നാം",
        "ചിലപ്പോൾ കരയും",
        "പിതാവോ കണ്ണുനീരെല്ലാം",
        "തുടച്ചുകളയും"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "തൻനിത്യരാജ്യം നൽകുവാൻ",
        "പിതാവിനിഷ്ടമായ്",
        "തൻമുഖത്തിൻ മുമ്പാകെ താൻ",
        "നിർത്തും തൻസ്തുതിക്കായ്"
      ]
    }
  ],
