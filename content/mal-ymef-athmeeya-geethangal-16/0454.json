{
  "number": 454,
  "title": "ഒന്നേയുളെളനിക്കാനന്ദമുലകിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഒന്നേയുളെളനിക്കാനന്ദമുലകിൽ",
        "യേശുവിൻ സന്നിധിയണയുവതേ",
        "അന്നേരം മമ മാനസഖേദം",
        "ഒന്നായകലും വെയിലിൽ ഹിമംപോൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മാനം ധനമീ മന്നിൻ മഹിമകളൊന്നും",
        "ശാന്തിയെ നൽകാതാം",
        "ദാഹം പെരുകും തണ്ണീരൊഴികെ",
        "ലോകം വേറെ തരികില്ലറിക"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീർത്തോടുകളിൽ മാനെപ്പോലെൻ",
        "മാനസമീശനിൽ സുഖം തേടി",
        "വറ്റാജീവജലത്തിൻ നദിയെൻ",
        "വറുമയെയകറ്റി നിർവൃതിയരുളി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തൻബലിവേദിയിൽ കുരികിലും",
        "മീവലും വീടും കൂടും കണ്ടതുപോൽ",
        "എൻബലമാം സർവ്വേശ്വരനിൽ",
        "ഞാൻ സാനന്ദമഭയം തേടും സതതം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കണ്ണീർ താഴ്‌വരയുണ്ടെനിക്കനവധി",
        "മന്നിൽ ജീവിത പാതയതിൽ",
        "എന്നാലും ഭയമെന്തിനെന്നരികിൽ",
        "നന്നായവൻ കൃപമഴപോൽ",
        "ചൊരികിൽ"
      ]
    }
  ],
