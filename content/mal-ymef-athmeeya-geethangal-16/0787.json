{
  "number": 787,
  "title": "നീ എന്റെ കർത്താവും",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നീ എന്റെ കർത്താവും",
        "നീ എന്റെ സർവ്വവും",
        "ഈ ജീവിതയാത്രയിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവമേ നീ എനിക്കായ്",
        "കരുതുന്നതാകയാൽ",
        "നിന്നിലർപ്പിച്ചിടുന്നു",
        "എൻ ആകുലങ്ങളും",
        "നിൻ കരങ്ങളിൽ",
        "താണിരിക്കുമ്പോൾ",
        "നിൻകൃപയാലെന്നെ",
        "താങ്ങിടുന്നല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവമേയെൻ ഭാരങ്ങളും",
        "കഷ്ടതയെല്ലാം",
        "നിൻ ചുമലിൽ താങ്ങി",
        "യെന്നെ നടത്തിടുന്നു",
        "നിന്റെ ദയയിൽ ഞാൻ",
        "ആശ്രയിക്കുന്നു",
        "നിന്റെ രക്ഷയിൻ ഞാൻ",
        "ആനന്ദിക്കുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ദൈവമേ നിൻ വാഗ്ദത്തങ്ങൾ",
        "ഓർത്ത് പാർത്ത് ഞാൻ",
        "നന്ദിയോടെ വാഴ്ത്തിടും",
        "നിൻ നാമത്തെ എന്നും",
        "പ്രത്യാശയിൻ ദിനം വന്നിടും വേഗം",
        "നിൻ മുഖം നേരിൽ",
        "കണ്ടാരാധിക്കും ഞാൻ"
      ]
    }
  ],
