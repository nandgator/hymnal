{
  "number": 332,
  "title": "എന്റെ പ്രിയനോ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്റെ പ്രിയനോ",
        "അവൻ എനിക്കുളളവൻ",
        "അവൻ എന്നേക്കുമായെന്നെ",
        "വീണ്ടെടുത്തവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇത്രമഹൽ സ്നേഹമാരിലും ഞാൻ",
        "ഇദ്ധരയിലെങ്ങും കാണുന്നില്ല",
        "എന്നെ സ്വന്തമാക്കിടുവാൻ",
        "എൻപേർക്കായ് രക്തം",
        "ചൊരിഞ്ഞവൻ താൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ലോകത്തിൻ സ്ഥാപനം",
        "മുതലെനിക്കായ്",
        "അറുക്കപ്പെട്ട ദൈവകുഞ്ഞാടവൻ",
        "പാപശാപം നീക്കിടുവാൻ",
        "പ്രിയൻ ശാപമായി ക്രൂശതിന്മേൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആയിരത്തിൽ പതിനായിരത്തിൽ",
        "സർവ്വാംഗ സുന്ദരനെൻപ്രിയൻ താൻ",
        "പ്രാണതുല്യം സ്നേഹിച്ചതാൽ",
        "തൻ ജീവൻ നൽകി മറുവിലയായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നന്ദിയാലെന്നുളളം നിറഞ്ഞിടുന്നേ",
        "സ്തോത്രങ്ങൾ പാടി ഞാൻ വാഴ്ത്തിടുമേ",
        "ജീവനുളള കാലമെല്ലാം",
        "ഹാ! നന്ദിയോടെ സ്തുതിച്ചിടുമേ"
      ]
    }
  ],
