{
  "number": 1630,
  "title": "മുങ്ങിപ്പൊങ്ങി, മുങ്ങിപ്പൊങ്ങി",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മുങ്ങിപ്പൊങ്ങി, മുങ്ങിപ്പൊങ്ങി",
        "മുങ്ങിപ്പൊങ്ങി നയമാൻ",
        "ഒന്ന്, രണ്ട്, മൂന്ന്, നാല്",
        "അഞ്ചല്ല ആറുവട്ടം",
        "കുഷ്ഠമൊട്ടും മാറിയില്ല - അയ്യോ",
        "രോഗം ഭേദമായതില്ല",
        "പാവം നയമാൻ, പാവം നയമാൻ",
        "പാവത്തിൻ കണ്ണുനിറഞ്ഞു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തിരികെ പോകാം, തിരികെ പോകാം",
        "എന്നുരച്ചു നയമാൻ",
        "അരുത് ഗുരു അരുത് ഗുരു",
        "കാലുപ്പിടിച്ചു ദാസർ",
        "ഏഴാംവട്ടം മുങ്ങിയപ്പോൾ - ആഹാ",
        "എല്ലാമെല്ലാം സുന്ദരമേ",
        "പാവം നയമാൻ, പാവം നയമാൻ",
        "പാവത്തിൻ കണ്ണുനിറഞ്ഞു"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    }
