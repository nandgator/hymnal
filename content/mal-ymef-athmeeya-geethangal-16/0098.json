{
  "number": 98,
  "title": "പാപഭാരക്കടലിലാണ്ടു",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപഭാരക്കടലിലാണ്ടു",
        "വലയുവോരീ ലോകരെ",
        "താപമാറ്റിക്കരയണച്ചോ -",
        "രേശുദേവാ! വന്ദനം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീതിയെന്തെന്നറിവതിന്നു",
        "പ്രാപ്തിയില്ലാ ഞങ്ങളിൽ",
        "നീതിമത്ത്വം കരുണമൂലം",
        "നൽകിയോനേ! വന്ദനം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഗളമൊടിച്ചു കളയവേണ്ടും",
        "കഴുതകൾക്കു തുല്യരായ്",
        "വെളിയിൽ നിന്നോരെളിയ",
        "ഞങ്ങൾ നീ നിമിത്തം മുക്തരായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കല്ലിലുള്ളെഴുത്തു മാച്ചു",
        "ഞങ്ങൾ തന്നുള്ളങ്ങളിൽ",
        "നല്ല നിൻവഴി തെളിച്ചു തന്ന",
        "നാഥാ വന്ദനം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "തീരെയെളിയോരടിയാർ",
        "ചെയ്യുമീയാരാധനം",
        "പാരമാം കരുണ പൂണ്ടു",
        "സ്വീകരിക്ക സാദരം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "കീർത്തനങ്ങൾ പാടി ഞങ്ങൾ",
        "നിത്യകാലം നിന്നുടെ",
        "സത്തമമാം സന്നിധിയിൽ",
        "വാഴുമാറാകേണമേ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
