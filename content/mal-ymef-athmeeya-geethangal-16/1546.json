{
  "number": 1546,
  "title": "യിസ്രായേലിൻ പരിപാലകൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യിസ്രായേലിൻ പരിപാലകൻ",
        "അവൻ മയങ്ങുകില്ലുറങ്ങുകില്ല",
        "അവൻ നിന്നെ പരിപാലിക്കും",
        "ദിനം തോറും പരിപാലിക്കും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പകൽ മേഘസ്തംഭത്താലും",
        "രാത്രി അഗ്നിഭത്താലും",
        "അവൻ നിന്നെ വഴി നടത്തും",
        "ചിറകിൻ കീഴിൽ നടത്തും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യഹോവയെ രുചിച്ചറിവിൻ",
        "യാഹിൽ പ്രശംസിച്ചിടുവിൻ",
        "അവൻ സങ്കേതവും ശരണവും",
        "രക്ഷയും കോട്ടയുമാം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
