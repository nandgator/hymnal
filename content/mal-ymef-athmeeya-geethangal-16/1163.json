{
  "number": 1163,
  "title": "വരുവിൻ യേശുവിൻ ചാരേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വരുവിൻ യേശുവിൻ ചാരേ",
        "വരുവിൻ അനുതാപത്തോടേ",
        "വരുവിൻ നിങ്ങൾ വരുവിൻ",
        "ദൈവം നൽകും",
        "രക്ഷ കൃപയാൽ വിശ്വാസത്താൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ക്രിസ്തു നാഥൻ",
        "കാൽവറിയിൽ ക്രൂശിൽ",
        "രക്തം ചിന്തി മരിച്ചുയിർപൂണ്ടു",
        "ശിക്ഷാവിധി നീങ്ങി",
        "നിത്യ രക്ഷാമാർഗ്ഗം",
        "വിളംബരം ചെയ്തു ഭൂവിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപഭാരത്താലുലകിൽ വാഴും",
        "മാനവരേ നിങ്ങൾ വന്നിടുവിൻ",
        "പാപഭാരം നീക്കും",
        "ശാപമെല്ലാം പോക്കും പരമസൗഭാഗ്യമേകും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലോകസുഖം നൊടിനേരം മാത്രം",
        "ശോകമല്ലാതെന്താണതിൻ നേട്ടം",
        "നിത്യസമാധാനം ക്രിസ്തുവിന്റെ",
        "ദാനം നിയതം സന്തോഷമല്ലോ"
      ]
    }
  ],
