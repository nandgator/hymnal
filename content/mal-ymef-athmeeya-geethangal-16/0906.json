{
  "number": 906,
  "title": "മായയായ ലോകം സർവ്വവും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മായയായ ലോകം സർവ്വവും",
        "മായയുടെ മായയേ",
        "കായവും സൗഭാഗ്യവും",
        "ആദായമെല്ലാം മായയേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഒന്നുമില്ലാതെ വന്നതുപോൽ",
        "ഒന്നുമില്ലാതെ പോകുമേ",
        "മന്നിലെ സൗഭാഗ്യമെല്ലാം",
        "വിട്ടകന്നു പോകണം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മാതാപിതാ സോദരരും",
        "ഭാര്യയും തനുജരും",
        "മാനമേറും സ്നേഹിതരും",
        "മായയുടെ മായയേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ധാന്യവും ധനലാഭവും",
        "വിശിഷ്ട പീടിക മാളിക",
        "കീർത്തിയേറിയ ദേഹമെല്ലാം",
        "ശൂന്യമായി പോകുമേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "മായയായ ചിന്ത നീക്കി",
        "കാര്യമായ യേശുവെ",
        "വീര്യമോടെ സേവ ചെയ്താൽ",
        "മായയെല്ലാം നീങ്ങിപ്പോം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
