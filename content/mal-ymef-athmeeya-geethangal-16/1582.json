{
  "number": 1582,
  "title": "ചൂരച്ചെടി തണലിൽ ഞാൻ -",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ചൂരച്ചെടി തണലിൽ ഞാൻ -",
        "ഉറങ്ങിടുമ്പോൾ",
        "മരിക്കാനായ് ഇച്ഛിച്ചു",
        "ഞാൻ കരഞ്ഞിടുമ്പോൾ -",
        "നല്ലവനാം ദൈവമെന്റെ",
        "അരികിൽ വന്നു",
        "കനലിൽ നൽകി ജീവൻ നൽകി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൂരെയാത്ര ചെയ്യാൻ ശക്തി",
        "എനിക്കു നൽകി -",
        "ബലമുള്ള ഭൂജത്താൽ എന്നെ താങ്ങി",
        "മരുഭൂവിൽ ചൂടേറ്റു തളർന്നിടുമ്പോൾ",
        "മന്ന തന്നു തൃപ്തനാക്കി നടത്തുമെന്നെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ചൂരച്ചെടി ഉണങ്ങി വേരറ്റാലും",
        "തുരത്തിയിലെ വെള്ളം വറ്റിപ്പോയാലും",
        "വീഞ്ഞു വീട്ടിലേക്കെന്നെ",
        "കൊണ്ടു പോകും",
        "സ്നേഹ കൊടിക്കീഴിൽ",
        "ഞാൻ വിശ്രമിക്കും"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
