{
  "number": 509,
  "title": "ഭക്തരിൽ വാത്സല്യമുളള",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഭക്തരിൽ വാത്സല്യമുളള",
        "ദൈവമേ നിൻ പ്രിയനാമീ",
        "മർത്ത്യനിൽ കനിഞ്ഞു ശക്തി",
        "നൽകണം ലോക",
        "ശക്തിയെ ജയിച്ചു ജീവിച്ചിടുവാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അന്ധകാരപ്രഭു തന്റെ തന്ത്രമോരോരോ",
        "വിധത്തിൽ",
        "ചന്തമോടയച്ചിടുന്നു സന്തതം എന്റെ",
        "ബന്ധുവേ ചിന്തിക്കണം ഞാൻ നിൻ ഹിതം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആരുമെൻ ജീവിതപാത",
        "തുച്ഛമാക്കിടാത്തവണ്ണം",
        "കാര്യമായെൻ നില നിന്നിൽ",
        "കാക്കണം എന്നിൽ",
        "സാരമാം സൽഗുണങ്ങൾ വിളങ്ങണം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ക്രിസ്തുവിൻ പ്രത്യക്ഷത നാളെത്രയും",
        "വേഗത്തിലെന്ന",
        "ങ്ങോർത്തു ഞാൻ നിത്യവും",
        "കാത്തിരിക്കണം നല്ല",
        "ശ്രദ്ധയോടെൻ ജീവിതം നയിക്കണം"
      ]
    }
  ],
  "sequence": [
