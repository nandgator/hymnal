{
  "number": 1080,
  "title": "സുവിശേഷമറിയിപ്പാനഭിമാനം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സുവിശേഷമറിയിപ്പാനഭിമാനം",
        "സവിശേഷം തോന്നുന്നു ഹൃദി",
        "പരമാർത്ഥം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിയതം രക്ഷയ്ക്കു ദിവ്യശക്തിയതു",
        "ദയയെഴും സത്യദൈവത്തിൻ സന്ദേശം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കഠിന കിരാതവർഗ്ഗം പോലുമിതിൻ",
        "പ്രതിഭയാൽ ദിവ്യഗുണങ്ങളുളേളാരായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പരമാനന്ദപ്രദമാമുപദേശം",
        "ധരണിയിലിതിന്നു സമമില്ലേതും"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    },
