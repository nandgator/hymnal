{
  "number": 1082,
  "title": "ജയം ജയം കൊളളും നാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ജയം ജയം കൊളളും നാം",
        "ജയം കൊളളും നാം",
        "യേശുവിന്റെ കൊടിക്കീഴിൽ",
        "ജയം കൊളളും നാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നായകനായ് യേശു തന്നെ",
        "നടത്തുന്ന സൈന്യം",
        "മായലോകം പേടിക്കേണ്ട"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സർവ്വലോക സൈന്യങ്ങളെ",
        "സാത്താൻ കൂട്ടിയാലും",
        "സ്വർഗ്ഗനാഥൻ ചിരിക്കുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കൗശലങ്ങൾ തത്വജ്ഞാനം",
        "യേശുവിന്നു വേണ്ടാ",
        "വചനത്തിൻ ശക്തി മതി"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ക്രിസ്തൻ ക്രൂശിൻ രക്തത്താലും",
        "നിത്യജീവനാലും",
        "വിശുദ്ധാത്മശക്തിയാലും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ക്ലേശിക്കേണ്ടാ ഹല്ലേലുയ്യാ!",
        "ദൈവത്തിനു സ്തോത്രം",
        "യേശുകൊണ്ട ജയത്താലെ"
      ]
    }
  ],
