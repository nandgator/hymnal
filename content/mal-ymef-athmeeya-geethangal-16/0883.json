{
  "number": 883,
  "title": "കൃപാകടലേ കനിയേണമേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കൃപാകടലേ കനിയേണമേ",
        "വരുന്നു ദാസൻ തിരുസവിധേ",
        "മനമേറ്റം കലങ്ങുന്നേ",
        "ദിനംതോറും വിനകളാലെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മരുഭൂമിയിൽ ചൂടുവെയിലും",
        "കൊടുങ്കാറ്റും പെരുകിടുന്നേ",
        "അണയുവാനായ് തണൽ നീയല്ലോ",
        "അണയുന്നു ഞാൻ തിരുസവിധെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഗമനവുമെൻ ആഗമനവും",
        "അറിയുന്നോനാം കരുണാനിധേ",
        "അണയുന്നു ഞാൻ തവപാദത്തിൽ",
        "ചൊരിക കൃപ പെരുംമാരിപോൽ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
