{
  "number": 250,
  "title": "അതാ കേൾക്കുന്നു ഞാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അതാ കേൾക്കുന്നു ഞാൻ",
        "ഗതസമന തോട്ടത്തിലെ",
        "പാപിയെനിക്കായ് നൊന്തലറിടുന്ന",
        "പ്രിയന്റെ ശബ്ദമതേ!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദേഹമെല്ലാം തകർന്നു",
        "ശോകം നിറഞ്ഞവനായ്",
        "ദേവാധിദേവാ! നിൻസുതൻ",
        "എനിക്കായ് - പാടുകൾ പെട്ടിടുന്നേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അപ്പാ ഈ പാനപാത്രം",
        "നീക്കുക സാദ്ധ്യമെങ്കിൽ",
        "എന്നിഷ്ടമല്ല നിന്നിഷ്ടമാകട്ടെ",
        "എന്നവൻ തീർത്തുരച്ചു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പ്രാണവേദനയിലായ്",
        "പാരം വിയർത്തവനായ്",
        "എൻപ്രാണനായകൻ ഉള്ളം തകർന്നിതാ",
        "യാചന ചെയ്തിടന്നേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദുസ്സഹ വേദനയാൽ",
        "മന്നവനേശു താനും",
        "മൂന്നുരു ഊഴിയിൽ വീണു പ്രാർത്ഥിച്ചല്ലോ",
        "പാപി എൻ രക്ഷയ്ക്കായി"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സ്നേഹത്തിൻ ഇമ്പവാക്കാൽ",
        "ആശ്വാസമേകുമവൻ",
        "കഷ്ടസമയത്തിൽ ആശ്വാസം കാണാതെ",
        "വിങ്ങി വിലപിക്കുന്നേ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എന്നെയും തന്നെപ്പോലെ മാറ്റും",
        "ഈ മാ സ്നേഹത്തെ",
        "എണ്ണിയെണ്ണി ഞാൻ ഉള്ളം നിറഞ്ഞല്ലാ",
        "നാളും പുകഴ്ത്തിടുമേ"
      ]
    }
  ],
