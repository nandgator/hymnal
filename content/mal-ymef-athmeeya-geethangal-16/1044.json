{
  "number": 1044,
  "title": "സീയോൻ മണാളനെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സീയോൻ മണാളനെ",
        "ശാലേമിൻ പ്രിയനെ",
        "നിന്നെക്കാണുവാൻ നിന്നെക്കാണുവാൻ",
        "എന്നെത്തന്നെ ഒരുക്കുന്നു നിൻരാജ്യത്തിൽ",
        "വന്നു വാഴുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പരനേ നിൻ വരവേതു നേരത്തെന്നു",
        "അറിയുന്നില്ല ഞാൻ അറിയുന്നില്ല ഞാൻ",
        "അനുനിമിഷവും അതികുതുകമായ്",
        "നോക്കിപ്പാർക്കുന്നേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കണ്ണുനീർ നിറഞ്ഞ ലോകത്തു",
        "നിന്നു ഞാൻ",
        "പോയ് മറയുമേ പോയ് മറയുമേ",
        "കണ്ണിമയ്ക്കും നൊടിനേരത്തു ചേരുമേ",
        "വിൺപുരിയതിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സഭയാം കാന്തയെ ചേർക്കുന്നനേരത്ത്",
        "എന്താനന്ദമേ... എന്താനന്ദമേ",
        "പ്രിയന്റെ മാർവ്വിൽ",
        "ഞാൻ ചാരും സമയത്ത് പരമാനന്ദമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കുഞ്ഞാട്ടിൻ രക്തത്താൽ കഴുകപ്പെട്ടവർ",
        "എടുക്കപ്പെടുമല്ലോ എടുക്കപ്പെടുമല്ലോ",
        "ആ മഹൽ സന്തോഷ",
        "ശോഭനനാളതിൽ",
        "ഞാനും കാണുമേ"
      ]
    }
  ],
