{
  "number": 1609,
  "title": "യേശുരാജൻ ഭൂവിൽ വന്നു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുരാജൻ ഭൂവിൽ വന്നു",
        "പാപിയെന്നെ തേടിവന്നു",
        "കാൽവറിയിൽ ജീവൻതന്നു",
        "നന്ദിയോടെ ഞാൻ ഓർക്കുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഭാഗ്യമിതു ശ്രേഷ്ഠമതേ",
        "ദിവ്യമായ രക്ഷയിതേ",
        "സ്തോത്രഗീതം പാടിടുമേ",
        "ജീവിതത്തിൻ അന്ത്യം വരെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യേശു രാജൻ വീണ്ടും വരും",
        "ലോകമിതു മാഞ്ഞുപോകും",
        "സ്വർഗ്ഗരാജ്യമെൻ ഭവനം",
        "സ്വർഗ്ഗതാതൻ തന്റെ ദാനം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സ്നേഹിതരേ വന്നിടുക",
        "യേശുപാദം ചേർന്നിടുക",
        "പാപശാന്തി നൽകിടുമേ",
        "മോക്ഷവീട്ടിൽ ചേർത്തിടുമേ"
      ]
    }
  ],
