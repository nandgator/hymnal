{
  "number": 1001,
  "title": "ജയം ജയം യേശുവിന്നു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ജയം ജയം ഹല്ലേലുയ്യാ",
        "വാഴ്ക ജീവനായക!",
        "ജയം ജയം ഹല്ലേലുയ്യാ",
        "വാഴ് ജീവദായക!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ജയം ജയം യേശുവിന്നു",
        "ദിവ്യ രക്ഷകൻ ഇതാ!",
        "ചാവിൻ കല്ലറയിൽനിന്നു ഉയിർത്തു",
        "ഹല്ലേലുയ്യാ!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ചത്ത കർമ്മങ്ങളിൽ നിന്നു",
        "യേശു നമ്മെ രക്ഷിച്ചു",
        "നമ്മിൽ ജീവിക്കുന്നതിന്നു",
        "തന്നെത്താൻ പ്രതിഷ്ഠിച്ചു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മൃത്യുവിൻ ഭയങ്കരങ്ങൾ നീങ്ങി",
        "തൻ ഉയിർപ്പിനാൽ",
        "നിത്യജീവന്റെ ഇമ്പങ്ങൾ വന്നു",
        "സുവിശേഷത്താൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "മണ്മയമാം ഈ ശരീരം",
        "ആത്മമയമാകുവാൻ",
        "കാഹളം ധ്വനിക്കുന്നേരം",
        "കൽപ്പിച്ചിടും രക്ഷകൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നെടുവീർപ്പും കണ്ണുനീരും",
        "ദുഃഖവും വിലാപവും",
        "നൊടിനേരംകൊണ്ടുതീരും",
        "പിന്നെയില്ലോർ ശാപവും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ജീവനുളള രക്ഷിതാവിൻ കൂടെ",
        "നാമും ജീവിക്കും",
        "എന്നെന്നേക്കും തൻ പിതാവിൻ",
        "രാജ്യത്തിൽ ആനന്ദിക്കും"
      ]
    }
  ],
