{
  "number": 1081,
  "title": "യേശുവിൻ സാക്ഷികൾ നാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവിൻ സാക്ഷികൾ നാം",
        "സുവിശേഷത്തിൻ സേനകൾ നാം",
        "ജയ് ജയ ഗീതം ശുഭനാദം",
        "സുവിശേഷം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപത്തെ വെറുക്കുന്നു ദൈവം",
        "പാപിയെ സ്നേഹിക്കുന്നു",
        "നല്ല സന്ദേശം നമ്മുടെ ദേശം",
        "എങ്ങുമേ അറിയിക്ക നാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവത്തിൻ മഹത് സ്നേഹം",
        "ഏകജാതനെത്തന്ന സ്നേഹം",
        "കൽമനം മാറ്റും നന്മകളൂറ്റും",
        "കൃപയുടെയുറവിടമാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലജ്ജിതരാകേണ്ട ലവ",
        "ലേശവും ഭയം വേണ്ടാ",
        "ദൈവിക ശക്തി പാപിക്കു മുക്തി",
        "നൽകുന്നു സുവിശേഷം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വേറൊരു സുവിശേഷം",
        "ഇല്ല പാരിതിലിന്നശേഷം",
        "പാപികൾ സ്വർഗ്ഗം പൂകുന്നമാർഗ്ഗം",
        "മറ്റില്ലെന്നറിയിക്ക നാം"
      ]
    }
  ],
