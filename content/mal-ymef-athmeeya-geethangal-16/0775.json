{
  "number": 775,
  "title": "ആശ്വാസദായകനായ്",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആശ്വാസദായകനായ്",
        "എനിക്കേശു അരികിലുണ്ട്",
        "എന്തെന്തു ഭാരങ്ങൾ ഏറിവന്നാലും",
        "എന്നെ കൈവിടാത്തവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആവശ്യഭാരങ്ങളാൽ ഞാൻ",
        "ആകുലനായിടുമ്പോൾ",
        "തന്റെ സാന്ത്വനം നൽകി വഴി നടത്തും",
        "യേശു അരികിലുണ്ട് -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രോഗം പ്രയാസങ്ങളാൽ",
        "ഞാൻ ക്ഷീണിതനായിടുമ്പോൾ",
        "എന്നെ താങ്ങി കരങ്ങളിൽ കാത്തിടും",
        "യേശു അരികിലുണ്ട് -"
      ]
    }
  ],
