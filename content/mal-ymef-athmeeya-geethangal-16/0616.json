{
  "number": 616,
  "title": "വിശ്വാസത്തോണിയിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ",
        "ഹല്ലേലുയ്യാ ഏറ്റുപാടാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വിശ്വാസത്തോണിയിൽ",
        "അക്കരെക്ക് പോകും നാം",
        "ഹല്ലേലുയ്യാ എന്നും പാടാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അല്ലൽ പരന്നാലും",
        "അലമാല വന്നാലും",
        "ഉല്ലാസത്തോടെന്നും പാടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കാറ്റങ്ങടിക്കുമ്പോൾ",
        "ഊറ്റമായലറുമ്പോൾ",
        "കൂട്ടിനായുണ്ടേശു നാഥൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തീരത്തണയുവാൻ",
        "തീരാമോദം പൂകുവാൻ",
        "തീരെയില്ല നാളുകളിനി"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "അന്ത്യം വരെയെന്നും",
        "ചുക്കാൻ പിടിക്കുവാൻ",
        "അമരത്തെന്നേശുവുണ്ട്"
      ]
    }
  ],
