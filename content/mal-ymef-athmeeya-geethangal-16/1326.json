{
  "number": 1326,
  "title": "മുന്നേറാം മുന്നേറാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഇന്ത്യ നേടിടാം ഇന്ത്യ നേടിടാം",
        "സാത്താന്‍ കോട്ട തകര്‍ത്തിടാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മുന്നേറാം മുന്നേറാം",
        "അണിയായ് പോയിടാം",
        "സുവിശേഷക്കൊടി പാറിച്ചെങ്ങും",
        "ധീരധീരമായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വേറില്ലല്ലോ സത്യമാര്‍ഗ്ഗം",
        "മോക്ഷം നേടാന്‍ സ്വര്‍ഗ്ഗം പൂകാന്‍"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വിശ്വസിക്കാം പ്രാര്‍ത്ഥിച്ചീടാം",
        "ജീവന്‍ വച്ചും പോരാടിടാം"
      ]
    }
  ],
