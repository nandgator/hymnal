{
  "number": 115,
  "title": "എണ്ണിയാൽ തീർന്നിടുമോ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നും ഞാൻ സ്തുതിച്ചിടും",
        "എന്നും ഞാൻ പുകഴ്ത്തിടും",
        "നിന്നുടെ കൃപകളെ ഞാൻ",
        "എന്നെന്നും പാടിടുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എണ്ണിയാൽ തീർന്നിടുമോ",
        "വല്ലഭാ! നിൻകൃപകൾ",
        "വർണ്ണിപ്പാൻ സാദ്ധ്യമല്ല",
        "മന്നവാ! നിൻവഴികൾ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഏഴയാമെന്നെയും നീ",
        "ആഴമായ് സ്നേഹിച്ചതാൽ",
        "ഊഴിയിൽ താണിറങ്ങി",
        "ഏഴയെ വീണ്ടെടുത്തു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപത്തിൻ ചേറ്റിൽ ഞാനും",
        "താപത്താൽ വലഞ്ഞ നേരം",
        "വേഗത്തിൽ വന്നു എന്നെ",
        "സ്നേഹത്താൽ വീണ്ടെടുത്തു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വിശ്വാസ ജീവിതത്തിൽ",
        "ആശ്വാസദായകനായ്",
        "വിശ്വത്തിലെന്നുമെന്നും",
        "കൂടെയിരിക്കുമവൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നിൻമുഖം കണ്ടിടുവാൻ",
        "നിന്നോടു ചേർന്നിടുവാൻ",
        "എന്നുളളം കൊതിച്ചിടുന്നേ",
        "എൻ പ്രിയാ! വന്നിടണേ!"
      ]
    }
  ],
