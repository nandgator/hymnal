{
  "number": 233,
  "title": "ഓ ദൈവമേ രാജാധിരാജദേവാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അത്യുച്ചത്തിൽ പാടും",
        "ഞാൻ കർത്താവേ",
        "അങ്ങെത്രയോ മഹോന്നതൻ!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഓ ദൈവമേ രാജാധിരാജദേവാ",
        "ആദിയന്തം ഇല്ല മഹേശനേ",
        "സർവ്വലോകം അങ്ങയെ വന്ദിക്കുന്നേ",
        "സാധു ഞാനും വീണു വണങ്ങുന്നേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സൈന്യങ്ങളിൽ നായകനങ്ങല്ലയോ",
        "ധന്യനായ ഏകാധിപതിയും",
        "ഇമ്മാനുവേൽ വീരനാം ദൈവവും നീ",
        "അന്യമില്ലേതും തവ നാമം പോൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അത്യഗാധം ആഴിയനന്തവാനം",
        "താരാജാലം കാനന പർവ്വതം",
        "മാരിവില്ലും താരും തളിരുമെല്ലാം",
        "നിൻ മഹത്വം ഘോഷിക്കും സന്തതം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഏഴയെന്നെ ഇത്രമേൽ സ്നേഹിക്കുവാൻ",
        "എൻ ദൈവമേ എന്തുള്ളു നീചൻ ഞാൻ",
        "നിൻ രുധിരം തന്നെന്നെ വീണ്ടെടുപ്പാൻ",
        "ക്രൂശിലോളം നീ നിന്നെ താഴ്ത്തിയോ"
      ]
    }
  ],
