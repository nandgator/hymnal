{
  "number": 1351,
  "title": "ദൈവത്തിന്‍റെ കുഞ്ഞാട് -",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവത്തിന്‍റെ കുഞ്ഞാട് -",
        "ഭൂവില്‍ വന്ന കുഞ്ഞാട്",
        "എനിക്കും നിനക്കും",
        "ഡാഡിക്കും മുമ്മിക്കും",
        "രക്ഷ തന്നീടുവാന്‍ വന്ന",
        "യേശു രക്ഷകന്‍",
        "നരനായ്‌ ബലിയായ്",
        "കുരിശില്‍ മൃതിയായ്",
        "രുധിരം അഖിലം തന്ന",
        "യേശു രക്ഷകന്‍"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    }
