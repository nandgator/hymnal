{
  "number": 732,
  "title": "പരപരമേശാ വരമരുളീശ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പരപരമേശാ വരമരുളീശ",
        "നീയത്രേയെൻ രക്ഷാസ്ഥാനം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നിന്നെക്കാണും ജനങ്ങൾക്കു",
        "പിന്നെ ദുഃഖമൊന്നുമില്ല"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിന്റെ എല്ലാ നടത്തിപ്പും",
        "എന്റെ ഭാഗ്യനിറവല്ലോ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആദിയിങ്കൽ കയ്പാകിലും",
        "അന്ത്യമോ മധുരമത്രേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കാർമേഘത്തിനുളളിലീ ഞാൻ",
        "മിന്നും സൂര്യ ശോഭകാണും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സന്ധ്യയിങ്കൽ വിലാപവും",
        "സന്തോഷമുഷസ്സിങ്കലും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "നിന്നോടൊന്നിച്ചുളള വാസം",
        "എന്റെ കണ്ണീർ തുടച്ചിടും"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "നിന്റെ മുഖശോഭ മൂലം",
        "എന്റെ ദുഃഖം തീർന്നുപോകും"
      ]
    }
  ],
