{
  "number": 265,
  "title": "കുരിശിൽ രുധിരം ചൊരിഞ്ഞു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കുരിശിൽ രുധിരം ചൊരിഞ്ഞു",
        "രക്ഷകൻ ജീവൻ വെടിഞ്ഞു",
        "എൻ പാപശാപം എല്ലാം കളഞ്ഞു",
        "എന്നെ രക്ഷിപ്പാൻ കനിഞ്ഞു - എന്നെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകം ഉളവാകും മുന്നേ താൻ",
        "കണ്ടു അഗതിയെന്നെ",
        "രക്ഷയൊരുക്കി അന്നേ എനിക്കായ്",
        "എത്ര മഹാത്ഭുത സ്നേഹം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വിണ്ണിൽ ജനകൻ തൻമടിയിൽ",
        "തങ്ങിയിരുന്ന സുതൻ",
        "എന്നെ തിരഞ്ഞു വന്നു ജഗതിയിൽ",
        "തന്നു തൻ ജീവൻ എനിക്കായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രൂശിൽ ചൊരിഞ്ഞ രക്തത്താലെൻ",
        "കുറ്റം ക്ഷമിച്ചു തന്നു",
        "സന്താപം പോക്കി ശത്രുത നീക്കി താൻ",
        "സന്തോഷം എന്നിൽ പകർന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആണി തുളച്ച തൃപ്പാദത്തിൽ",
        "വീണു വണങ്ങുന്നു ഞാൻ",
        "സ്തോത്രം സ്തുതികൾ -",
        "ക്കിന്നുമെന്നെന്നേക്കും",
        "പാത്രമവനേകൻ താൻ"
      ]
    }
  ],
