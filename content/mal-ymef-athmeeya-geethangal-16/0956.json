{
  "number": 956,
  "title": "വാനിൽ വന്നിടുമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വാനിൽ വന്നിടുമേ",
        "വിണ്ണിൻ ദൂതരുമായ്",
        "രാജരാജൻ നമ്മുടെ നാഥൻ",
        "തേജസ്സിൽ വന്നിടുമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇല്ല നാളധികം പാരിൽ നമുക്കിനിയും",
        "വേല തികച്ചിടാം ലോകം ത്യജിച്ചിടാം",
        "വരവിന്നായെന്നും ഉത്സുകരായ്",
        "നാം ഒരുങ്ങിയുണർന്നിരിക്കാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മണ്ണിൽ നിലനിൽക്കും ഒന്നും നമുക്കില്ല",
        "വിണ്ണിലൊരുക്കുന്ന വീടു നമുക്കുണ്ട്",
        "വീണ്ടെടുപ്പിൻ നാൾ വേഗം വരുന്നു",
        "വീട്ടിൽ നാം ചേർന്നിടാറായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശാലേം നഗരമതിൻ തങ്കവീഥികളിൽ",
        "ചേലെഴും പ്രിയന്റെ സ്നേഹക്കൈകളിൽ നാം",
        "ചേർന്നു വിശ്രാമം നേടിടുമന്നു",
        "തീർന്നിടുമാകുലങ്ങൾ"
      ]
    }
  ],
