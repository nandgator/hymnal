{
  "number": 1260,
  "title": "ഒന്നുചേർന്നു പോയിടാം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഒന്നുചേർന്നു പോയിടാം",
        "സൺ‌ഡേ സ്കൂളിൽ പോയിടാം",
        "ക്രിസ്തുവിൻ വചസ്സുകൾ",
        "ഭംഗിയായി പഠിച്ചിടാം!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സത്യ വേദപുസ്തകം",
        "രക്ഷകൻ മൊഴികളെ",
        "സത്യമായി പഠിച്ചിടാം",
        "മോദമോടെ പാടിടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപമാകെ നീക്കിടും",
        "ശോകമാകെ പോക്കിടും",
        "മോദമായി വിളിച്ചിടും",
        "യേശുവെ ഗമിച്ചിടാം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
