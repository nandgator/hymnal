{
  "number": 944,
  "title": "രാജൻ മുമ്പിൽ നിന്നു നാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "രാജൻ മുമ്പിൽനിന്നു നാം",
        "കണ്ടിടും തൻ സൗന്ദര്യം",
        "കീർത്തിക്കും തൻമഹത്വം",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ",
        "രാജൻ മുമ്പിൽ നിൽക്കും നാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "കണ്ടിടും തൻ സൗന്ദര്യം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "ദൂതന്മാർക്കു തുല്യരായ്",
        "വാഴും നാം സന്തുഷ്ടരായ്",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "നീക്കും പോരിൻ ആയുധം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "തീർന്നു യുദ്ധാഭ്യാസവും",
        "തീർന്നെല്ലാ പ്രയാസവും",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "പ്രാപിക്കും തൻ വാഗ്ദത്തം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "നാം പിതാവിൻ രാജ്യത്തിൽ",
        "വാഴും നിത്യതേജസ്സിൽ",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "ശോഭിക്കും നിരന്തരം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "തീർന്നു ബലഹീനത",
        "തീർന്നു എല്ലാ ക്ഷീണത",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "പ്രാപിക്കും നിത്യാനന്ദം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "നിത്യജീവൻ ഇമ്പങ്ങൾ",
        "തേജസ്സിൻ കിരീടങ്ങൾ",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "ചെയ്യും സ്നേഹ സംസർഗ്ഗം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "എല്ലാ ദൈവമക്കളും",
        "എന്നും ഒന്നായ് വാണിടും",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "രാജൻ മുമ്പിൽ നിന്നു നാം",
        "ചെയ്യും നിത്യവന്ദനം",
        "ഹല്ലേലുയ്യാ - ഹല്ലേലുയ്യാ",
        "നാമും സ്വർഗ്ഗസൈന്യവും",
        "ഇപ്രകാരം പാടിടും",
        "ഹല്ലേലുയ്യാ വേഗത്തിൽ"
      ]
    }
  ],
