{
  "number": 326,
  "title": "എത്ര നല്ല സ്നേഹിതൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്ര നല്ല സ്നേഹിതൻ",
        "ശ്രീയേശു മഹാരാജൻ!",
        "നമുക്കുളളാശ്രയമവനേകൻ",
        "ആരുമില്ലിതുപോലൊരുത്തമ",
        "സ്നേഹിതനീയുലകിൽ",
        "അവൻ പ്രിയമരികിലണഞ്ഞറികിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവകോപത്തീയിലായ്",
        "നാമനിശവുമഴലായ്‌വാൻ",
        "കുരിശിൽ മനസ്സൊടു ബലിയായ് താൻ",
        "ജീവനേയും തന്നിടുവാനാരു തുനിഞ്ഞിടും?",
        "ഇതേവിധമാരു കനിഞ്ഞിടും?"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സങ്കടങ്ങൾ തിങ്ങിടുമ്പോൾ",
        "സംഗീതം പാടാം",
        "അവങ്കൽ സങ്കേതം തേടാം",
        "ഭീതിയരുതെന്നോതിയരികിൽ",
        "മരുവുന്നവനെന്നും",
        "നമുക്കായ് കരുതുന്നവനെന്നും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആകവേ ചിന്താകുലങ്ങൾ",
        "തൻമേലാക്കിടാം",
        "അവൻ കൈ നമ്മെ താങ്ങിടും",
        "ആരിലും ബലവാനവൻ",
        "മഹിമോന്നതധന്യനവൻ",
        "നമുക്കിങ്ങെന്നുമനന്യനവൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നിന്ദയും ചുമന്നിടാം",
        "നാമേൽക്കുകയപമാനം",
        "തൻനാമത്തിലാർക്കുമതഭിമാനം",
        "ഒന്നിലും ഭയന്നിടാതെ",
        "മന്നിൽ നിന്നിടാം",
        "അവന്റെ പിന്നിൽ നിരന്നിടാം"
      ]
    }
  ],
  "sequence": [
