{
  "number": 1588,
  "title": "എന്റെ പ്രിയൻ എന്നു വരും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്റെ പ്രിയൻ എന്നു വരും",
        "എന്റെ പ്രിയൻ എന്നു വരും",
        "എന്റെ കണ്ണുനീരു തോർന്നിടുവാൻ",
        "പ്രിയൻ എന്നു വരും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാരിൽ ജീവിക്കും കാലം",
        "ഭാരത്താൽ ഞാൻ നീറിടുമ്പോൾ",
        "തിരുമാറിൽ ചാരി ഞാൻ",
        "ആശ്വസിക്കും യേശു രക്ഷകന്റെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഈ ലോക വാസത്തിൽ",
        "പ്രതികൂലം ഏറിടുമ്പോൾ",
        "അനുകൂലമായ് എനിക്കെന്നും ഉണ്ട്",
        "യേശു എൻ ചാരെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വാനിൽ വേഗം വന്നിടുമേ",
        "യേശു പ്രിയ രക്ഷകൻ താൻ",
        "അന്ന് വിശുദ്ധരൊത്ത് പാടിടുവാൻ",
        "സാധു അടിയനിതാ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
