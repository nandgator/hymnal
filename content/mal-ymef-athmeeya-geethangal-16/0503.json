{
  "number": 503,
  "title": "പുഷ്പം നിറഞ്ഞോർ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവിനെ പിഞ്ചെല്ലും ഞാനെന്നും",
        "ലേശം പേടിക്കാതെ എല്ലാടത്തുമേ",
        "യേശുവിനെ പിഞ്ചെല്ലും ഞാനെന്നും",
        "ലേശം പേടിക്കാതെ എങ്ങും പിഞ്ചെല്ലും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പുഷ്പം നിറഞ്ഞോർ",
        "താഴ്‌വരയിൽകൂടി ഞാൻ",
        "രക്ഷകനോടുകൂടെ യാത്ര ചെയ്യുമേ",
        "താൻ നടത്തുന്നിടത്തെല്ലാം",
        "ഞാൻ പിഞ്ചെല്ലുമേ താൻ നൽകും",
        "കിരീടം പ്രാപിക്കുവോളം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വൻ കാറ്റടിക്കും",
        "താഴ്‌വരയിൽകൂടി ഞാൻ",
        "എൻ രക്ഷകനോടുകൂടെ യാത്ര ചെയ്യും",
        "എന്നെ താൻ നടത്തുന്നതിനാൽ ഭയപ്പെടാ",
        "അനർത്ഥങ്ങൾ നേരിട്ടാലും പേടിക്കാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "താഴ്‌വരയിലോ പർവ്വത -",
        "ത്തിൻ മേലെയോ",
        "രക്ഷകനെ ചേർന്നു ഞാനും",
        "യാത്ര ചെയ്യും",
        "താൻ നടന്ന പാതയിൽ നടത്തും താനെന്നെ",
        "ദൈവപർവ്വതങ്ങളിലെത്തുംവരെ"
      ]
    }
  ],
