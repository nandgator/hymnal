{
  "number": 1580,
  "title": "യേശു എന്നാത്മസഖേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശു എന്നാത്മസഖേ",
        "നിൻ മാർവിൽ ഞാൻ ചേരട്ടെ",
        "ഈ ലോകമാം വാരിധേ",
        "തിരകൾ ഉയരുന്നേ!",
        "ഘോരമാം കോൾ ശാന്തമായ്",
        "തീരും വരെ രക്ഷകാ!",
        "എൻ ജീവനെ കാക്കുക",
        "നിൻ അന്തിക ഭദ്രമായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വേറെ സങ്കേതം വേണ്ടാ",
        "എന്നാത്മാവിന്നഭയമായ്",
        "കൈവിടരുതേ എന്നെ",
        "കാത്തുരക്ഷിക്ക സദാ",
        "എൻ സഹായം ആശയം",
        "എല്ലാം നിന്നിൽ മാത്രമേ",
        "എന്നെ മറക്കേണമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രിസ്തോ! എൻ ആവശ്യങ്ങൾ",
        "നിന്നാൽ നിറവേറുന്നു",
        "ഏഴകൾ നിരാശ്രയർക്കാധാരം നീയാകുന്നു",
        "നീതിമാൻ നീ നിർമ്മലൻ",
        "മഹാ മ്ലേഛൻ ഞാൻ മുറ്റും",
        "പാപി ഞാൻ മാ പാപി ഞാൻ",
        "കൃപ സത്യം നീ മുറ്റും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കാരുണ്യവാരിധേ കന്മഷം കഴുകുക",
        "നിത്യ ജീവ വെളളമെൻ",
        "ചിത്തം ശുദ്ധമാക്കട്ടെ",
        "ജീവനുറവാം നാഥാ!",
        "ഞാൻ ഏറെ കുടിക്കട്ടെ",
        "എന്നുളളിൽ ഉയരുക",
        "നിത്യകാലമൊക്കവെ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
