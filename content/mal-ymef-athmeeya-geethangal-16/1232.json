{
  "number": 1232,
  "title": "അതിമോദംനിന്തിരു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അതിമോദംനിന്തിരു",
        "സന്നിധിയണയുന്നു പ്രഭാതത്തിൽ",
        "സ്തുതിഗീതങ്ങൾ പാടിവാഴ്ത്തുവാൻ",
        "കൃപയേകണമധികം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "തിരുനാമത്തിലഭയം",
        "പ്രാപിച്ചധികം ശക്തി ലഭിപ്പാൻ",
        "തിരുസന്നിധിയണയുന്നീശാ",
        "ബലഹീനനാമടിയൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മമ ജീവിതവഴികൾ തവഹിതം",
        "പോൽ തുടർന്നിടുവാൻ",
        "പരനേ, മമ പ്രിയനേ, കൃപ",
        "പകർന്നീടണമധികം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അരുണോദയസമയം",
        "പാരിൽ പതഗഗണം പാടുന്നു",
        "തിരുവേദത്തിൻ പൊരുളേ ദിവ്യ",
        "കതിർ വീശണം ഹൃദയേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അരിസഞ്ചയം വിഹരിക്കുന്നു",
        "വിനകൾ വരുത്തിടുവാൻ",
        "അഖിലേശ, മാം കരങ്ങൾ",
        "നീട്ടിപ്പരിപാലിക്ക പരനേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ജഗദീശനെ ഭജിച്ചാത്മീയ പുതുക്കം",
        "പ്രാപിച്ചതിനാൽ",
        "ജയജീവിതം നയിപ്പാനാശ -",
        "വളരുന്നാത്മപ്രിയനേ"
      ]
    }
  ],
