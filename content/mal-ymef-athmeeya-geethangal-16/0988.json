{
  "number": 988,
  "title": "സന്തോഷിപ്പിൻ വീണ്ടും സന്തോഷിപ്പിൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സന്തോഷിപ്പിൻ വീണ്ടും സന്തോഷിപ്പിൻ",
        "സ്വർഗ്ഗ സന്തോഷത്താൽ നിറവിൻ",
        "സർവ്വസമ്പൂർണ്ണനാം",
        "നാഥൻ ചെയ്തതാം",
        "നന്മകൾ ധ്യാനിച്ചു സന്തോഷിക്കാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "രക്ഷകനാം പ്രിയന്റെ",
        "പാലകൻ യേശുവിന്റെ",
        "നാമമുയർത്തുക നാം",
        "നാൾതോറും ആമോദമായ് - എന്നും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപത്തിൽ നിന്നു നമ്മെ",
        "കോരിയെടുത്തു പരൻ",
        "ശാശ്വതമാം പാറയിൽ",
        "പാദം നിറുത്തിയതാൽ - എന്നും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രിസ്തുവിൻ കഷ്ടങ്ങളിൽ",
        "പങ്കുളേളാരാകും തോറും",
        "സന്തോഷിപ്പിൻ പ്രിയരേ",
        "ആത്മീയഗീതങ്ങളാൽ - എന്നും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രോഗങ്ങൾ വന്നിടിലും",
        "ഭാരങ്ങളേറിടിലും",
        "സൗഖ്യം പകർന്നു പരൻ",
        "സന്തോഷം തന്നതിനാൽ - എന്നും"
      ]
    }
  ],
