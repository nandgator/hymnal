{
  "number": 232,
  "title": "അതിമോദം പാടും ഞാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അതിമോദം പാടും ഞാൻ",
        "സ്തുതിഗീതങ്ങൾ",
        "ദേവാധി ദേവൻ രാജാധി രാജൻ",
        "ലോകാധി നാഥനെൻ യേശുവിന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പരലോകം വിട്ടവൻ പാരിൽ വന്നു",
        "പാപികൾക്കായ് തന്‍റെ ജീവൻ തന്നു",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ പാടി",
        "പുകഴ്ത്തും തൻ സ്നേഹത്തെ",
        "കീർത്തിക്കും ഞാനെന്നും തൻ നാമത്തെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീചനാം എന്നേയും സ്നേഹിച്ചുതാൻ",
        "മോചനം തന്നെന്നെ രക്ഷിച്ചതാൽ",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ പാടി",
        "പുകഴ്ത്തും തൻ സ്നേഹത്തെ",
        "കീർത്തിക്കും ഞാനെന്നും തൻ നാമത്തെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഒരു നാളും കുറയാത്ത നിത്യസ്നേഹം",
        "മരുഭൂവിൽ ഞാനിന്ന് ആസ്വദിച്ച്",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ പാടി",
        "പുകഴ്ത്തും തൻ സ്നേഹത്തെ",
        "കീർത്തിക്കും ഞാനെന്നും തൻ നാമത്തെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ചേരും ഞാനൊരു നാളിൽ തന്നരികിൽ",
        "തിരുമുഖം കാണും ഞാനന്നു നേരിൽ",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ പാടി",
        "പുകഴ്ത്തും തൻ സ്നേഹത്തെ",
        "കീർത്തിക്കും ഞാനെന്നും തൻ നാമത്തെ"
      ]
    }
  ],
