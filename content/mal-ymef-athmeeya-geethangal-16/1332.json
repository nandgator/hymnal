        "കൂടെപ്പോരാം ഞാന്‍",
        "കീയോം, കീയോം., മ്യാവു മ്യാവു",
        "ബൗബൗ ബൗബൗ",
        "പോരാം പോരാം ഞങ്ങളും പോരാം",
        "ബൈബിള്‍ ഫെസ്റ്റിവലില്‍"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
