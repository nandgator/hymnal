{
  "number": 1092,
  "title": "ലേശവും ഭയം വേണ്ടാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "(രീതി: \"നീയല്ലോ ഞങ്ങൾക്കുളള\")",
        "യേശുവിൻ വീരന്മാരെ",
        "ധൈര്യത്തോടെ നടപ്പിൻ",
        "ആശു നമുക്കുണ്ടു ജയം",
        "വൈരിയോടു പൊരുതാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലേശവും ഭയം വേണ്ടാ",
        "നമുക്കിന്നു ജയിക്കാം",
        "യേശു താൻ കൂടെയുണ്ടു -",
        "നായകനായെപ്പോഴും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സ്നേഹത്തിൻ കൊടിപിടി -",
        "ച്ചെല്ലാടവും ചുറ്റി നാം",
        "കാഹളങ്ങൾ ഊതുക",
        "വൻ കോട്ടകൾ ഇടിയുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശത്രുത്വം എന്ന നടു -",
        "മതിലവൻ ഇടിച്ചു",
        "പുത്രത്വത്തിൻ ആവിയെ",
        "തന്നു നമുക്കതിനാൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സുവിശേഷക്കൊടിയെ",
        "പിടിച്ചുയർത്തിടുക",
        "സവിശേഷം വിവരിക്ക",
        "കുരിശിന്റെ രഹസ്യം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സത്യമാം അരക്കെട്ടും",
        "നീതിയെന്ന കവചം",
        "സത്യസുവിശേഷ",
        "യത്നച്ചെരിപ്പതും ധരിച്ചു"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "രക്ഷയിൻ കൊടി",
        "നമുക്കിക്ഷണമുയർത്തണം",
        "രക്ഷപ്പെട്ട ജനത്തിന്റെ",
        "ധൈര്യമവർ കാണുവാൻ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "രക്ഷയിൻ ശിരസ്ത്രം",
        "വിശ്വാസമെന്ന പരിച",
        "രക്ഷകന്റെ വചനമാം",
        "ആത്മവാളും ധരിച്ചു"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ജയത്തിൻ കൊടിയുണ്ടു",
        "നമുക്കിന്നു പിടിപ്പാൻ",
        "ഭയപ്പെടാൻ അടിമയിൻ",
        "ആവിയല്ല നമുക്ക്"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "വീരന്മാർക്കാവശ്യം നൽ",
        "ധീരതയതല്ലയോ?",
        "ഭീരുത്വം നമുക്കിനി തീരെ",
        "വേണ്ടാനിശ്ചയം"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "ജയത്തെ നമുക്കേശുമൂലം",
        "തരുന്നവന്നു",
        "ജയം! ജയം! ഹല്ലേലുയ്യാ!",
        "ഹല്ലേലുയ്യാ! നിരന്തം"
      ]
    }
  ],
