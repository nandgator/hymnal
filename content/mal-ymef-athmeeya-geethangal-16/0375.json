{
  "number": 375,
  "title": "ദൈവത്തിൻ നാമത്തിൽ നാം",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "ദൈവത്തിൻ നാമത്തിൽ നാം",
        "ചേർന്നിടും സമയങ്ങളിൽ",
        "മോദമായ് ധ്യാനിച്ചിടാം",
        "തന്‍റെ വൻകൃപകൾ ദിനവും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കുന്നുകളകന്നിടിലും",
        "മഹാ പർവ്വതം മാറിടിലും",
        "തന്‍റെ ദയയെന്നും ശാശ്വതമേതന്‍റെ",
        "മക്കൾക്കാശ്രയമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സീയോനിലവൻ നമുക്കായ്",
        "അതിശ്രേഷ്ഠമാം മൂലക്കല്ലായ്",
        "തന്നോടു ചേർന്നു നാമും",
        "തന്‍റെ ജീവകല്ലുകളായിടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കർത്തൻ തൻവരവിൻ നാളിൽ",
        "തന്‍റെ കാന്തയാം നമ്മെ ചേർത്തിടും",
        "എന്‍റെ കണ്ണുനീരെല്ലാം തുടയ്ക്കും",
        "തന്‍റെ മാർവ്വോടു ചേർത്തീടുമേ"
      ]
    }
  ],
