{
  "number": 933,
  "title": "യേശുവരും വേഗത്തിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവരും വേഗത്തിൽ",
        "ആശ്വാസമേ",
        "യേശുവരും വേഗത്തിൽ ക്രിസ്തേശു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മേഘം തൻതേരും",
        "അനേകരാം ദൂതരും",
        "ശേഖരിപ്പാൻ തന്നിലേക്കെല്ലാശുദ്ധരെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവത്തെ സത്യത്തിൻ സേവ",
        "ചെയ്തവർക്കു",
        "ചാവിനെ ജയിച്ചു തൻ ജീവനെ കൊടുപ്പാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തന്തിരുവരവിന്നായ് സന്തതം",
        "കാത്തവർ",
        "അന്തമില്ലാത്തൊരു",
        "സന്തോഷം ലഭിപ്പാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഭൃത്യന്മാർ താൻ ചെയ്ത",
        "സത്യപ്രകാരം",
        "നിത്യമഹത്വത്തിൻ",
        "രാജ്യത്തിൽ വാഴാൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "തൻ ജനത്തിന്റെല്ലാ നിന്ദയെ നീക്കി",
        "അൻപുളള കൈകൊണ്ട്",
        "കണ്ണുനീർ തുടപ്പാൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "തൻ തിരുമുഖത്തെ നാം",
        "കൺകൊണ്ടു കണ്ടു",
        "സന്തുഷ്ടരായെന്നും തൻ",
        "നാമം സ്തുതിപ്പാൻ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "ലോകത്തിൻ ചിന്തകൾ",
        "പോകട്ടെയെല്ലാം",
        "ഏക പ്രത്യാശ ഇങ്ങാക എൻ യേശു"
      ]
    }
  ],
