{
  "number": 810,
  "title": "യേശുവിൻ മാർവ്വിൽ ചാരിടുക",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ചാരിടുക നിത്യസ്നേഹത്തിൽ",
        "ചാരിടുക തൻ കൃപയതിൽ",
        "ചാരിടുക സ്വർപ്പുരം നോക്കി",
        "രക്ഷകനിൽ ചാരിടുക"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിൻ മാർവ്വിൽ ചാരിടുക",
        "സഹായിക്കും താനെല്ലാനാളും",
        "വിശ്വസിക്കിൽ തൻ ദിവ്യസ്നേഹം",
        "ഗീതത്താലുളളം നിറയ്ക്കും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യേശുവിൻ മാർവ്വിൽ ചാരിടുക",
        "വെളിച്ചമേകും പാതയെല്ലാം",
        "പിൻചെൽക തൻവഴിയെ",
        "മോദാൽ ശാന്തസ്വരം ശ്രവിക്കുക"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യേശുവിൻ മാർവ്വിൽ ചാരിടുക",
        "അർപ്പിക്കയെല്ലാം ക്രിസ്തുവിൽ നീ",
        "താൻ സ്നേഹ ദയാവാനെപ്പോഴും",
        "തൻകൺകൾ മങ്ങിടില്ല"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "യേശുവിൻ മാർവ്വിൽ ചാരിടുക",
        "നിറവേറ്റിടുമാവശ്യങ്ങൾ",
        "സ്വീകരിച്ചിടുന്നോർക്കെന്നും",
        "താൻ നിത്യസ്നേഹിതനുമാം"
      ]
    }
  ],
