{
  "number": 105,
  "title": "നീ കരുണാരസമേകിനാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നീ കരുണാരസമേകിനാ",
        "നതിനായിതാ വന്ദനം!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകമെല്ലാം പുകൾ പെരുകും",
        "ഏകനാഥനാം വിഭോ!",
        "ശരണം സദാ വന്ദനം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ശോകമെഴും ലോകമിതിൻ",
        "മോഹം നീക്കിയെന്നിൽ",
        "നീയതിനായിതാ വന്ദനം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നിൻസുതങ്കലെന്നെയഹോ!",
        "ധന്യനാക്കിവച്ചു നീ",
        "യതിനായിതാ വന്ദനം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അന്തമില്ലാതുള്ള പിഴ",
        "ഹന്ത! മോചിച്ചന്നു നീ",
        "അയതിനായിതാ വന്ദനം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പാവനമാം രക്തമതിൽ",
        "പാപശുദ്ധി നൽകി നീ",
        "അയതിനായിതാ വന്ദനം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "നിർമ്മലമായ് പ്രതിദിനവും",
        "നന്മയാൽ നിറച്ചിടുന്ന -",
        "തിനായിതാ വന്ദനം"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "നിൻവചനം മൂലമഹോ",
        "എൻവഴിക്കധീശനായ്",
        "നിലനിന്നതാൽ വന്ദനം"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "നിന്ദിതനാമെന്നരികിൽ",
        "നിന്നു കഷ്ടനാളിൽ",
        "നീയതിനായിതാ വന്ദനം"
      ]
    }
  ],
