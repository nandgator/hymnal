{
  "number": 985,
  "title": "കാത്തു കാത്തേകനായ്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാത്തു കാത്തേകനായ്",
        "നിൻ വരവോർത്തു ഞാൻ",
        "നാളെത്ര നീക്കിയെൻ യേശുദേവാ",
        "കാണും പ്രപഞ്ചമോ മാറുമെന്നാകിലും",
        "മാറാത്ത വാക്കു നീ തന്നതല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സംസാരസാഗരേ നീന്തി നീന്തി ഞാൻ",
        "സന്താപത്താലുഴന്നീടുന്നയ്യോ",
        "സന്തോഷമേകുവാൻ",
        "നിൻകൂടെ വാഴുവാൻ",
        "സൗന്ദര്യ പൊൻമുഖം കണ്ടിടുവാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സ്വന്തമായൊന്നുമേ",
        "കാണുവാനില്ലിതിൽ",
        "സ്വന്തമായ് നീ മതി യേശുദേവാ",
        "ബന്ധുക്കൾ മിത്രരും അന്ത്യസമയമേ",
        "പിന്തിരിഞ്ഞീടുമാ ശോകരംഗം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആശ്വാസമേകുക വിശ്വാസനായക",
        "നശ്വരനാടകമാണീ ലോകം",
        "ആശിഷമേകുക എൻശ്വാസം പോംവരെ",
        "നിൻഗാനം പാടുവാൻ ശക്തി നൽക"
      ]
    }
  ],
  "sequence": [
