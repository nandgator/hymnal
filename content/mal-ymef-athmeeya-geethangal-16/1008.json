{
  "number": 1008,
  "title": "കർത്തൃകാഹളം യുഗാന്ത്യ -",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പേർ വിളിക്കും നേരം കാണും",
        "പേർ വിളിക്കും നേരം കാണും",
        "പേർ വിളിക്കും നേരം കാണും",
        "പേർ വിളിക്കും നേരം",
        "കാണുമെൻ പേരും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കർത്തൃകാഹളം യുഗാന്ത്യ -",
        "കാലത്തിൽ ധ്യാനിക്കുമ്പോൾ",
        "നിത്യമാം പ്രഭാതശോഭിതത്തിൻ നാൾ",
        "പാർത്തലേ രക്ഷപെട്ടോ -",
        "രക്കരെക്കൂടി ആകാശേ",
        "പേർ വിളിക്കും നേരം",
        "കാണുമെൻ പേരും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ക്രിസ്തനിൽ നിദ്രകൊണ്ടോരീ -",
        "ശോഭിത പ്രഭാതത്തിൽ",
        "ക്രിസ്തൻ ശോഭ ധരിപ്പാ -",
        "നുയിർത്തു തൻ",
        "ഭക്തർ ഭവനേ ആകാശ -",
        "മപ്പുറം കൂടിടുമ്പോൾ",
        "പേർ വിളിക്കും നേരം",
        "കാണുമെൻ പേരും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കർത്തൻ പേർക്കു രാപ്പകൽ",
        "അദ്ധ്വാനം ഞാൻ ചെയ്തിങ്ങനെ",
        "വാർത്ത ഞാൻ ചൊല്ലിടട്ടെ",
        "തൻ സ്നേഹത്തിൻ",
        "പാർത്തലത്തിൽ എന്റെ വേല",
        "തീർത്തു ജീവിതാന്ത്യത്തിൽ",
        "പേർ വിളിക്കും നേരം",
        "കാണുമെൻ പേരും"
      ]
    }
  ],
