{
  "number": 376,
  "title": "യേശു എന്നഭയകേന്ദ്രം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു എന്നഭയകേന്ദ്രം",
        "മാറ്റമില്ലാ സ്നേഹിതൻ",
        "സ്തോത്രം സ്തുതികൾക്കു യോഗ്യൻ",
        "വാഴ്ത്തും നിന്നെയെന്നും ഞാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വ്യാകുലങ്ങൾ നേരിട്ടാലും",
        "ഭാരമുളളിൽ വന്നാലും",
        "രോഗിയായ് തീർന്നെന്നാലും",
        "യേശുവിൽ ഞാൻ ചാരിടും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എന്നെ ശുദ്ധീകരിച്ചിടാൻ",
        "ബാലശിക്ഷ നൽകിയാൽ",
        "താതന്‌ നന്ദികരേറ്റും",
        "ഹല്ലേലുയ്യാ പാടും ഞാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യേശു രാജനെന്നെ ചേർപ്പാൻ",
        "മേഘാരൂഢനായ് വരും",
        "ആകുലങ്ങളില്ലാ നാട്ടിൽ ചേരും",
        "സ്വർഗ്ഗവീട്ടിൽ ഞാൻ"
      ]
    }
  ],
