{
  "number": 640,
  "title": "എത്ര നല്ല സഖി യേശു",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്ര നല്ല സഖി യേശു",
        "പാപഭാരം ചുമപ്പാൻ",
        "പ്രാർത്ഥനയിൽ കർത്തൻ മുമ്പിൽ",
        "എല്ലാം സമർപ്പിച്ചിടാം",
        "എത്ര സമാധാന നഷ്ടം",
        "എത്ര ദുഃഖം സഹിപ്പൂ",
        "ദൈവമുമ്പിൽ പ്രാർത്ഥനയിൽ",
        "അടുത്തു വരായ്കയാൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പരിശോധന കഷ്ടങ്ങൾ",
        "പ്രശ്നങ്ങൾ നമുക്കുണ്ടോ?",
        "കർത്തൻ സന്നിധിയിൽ ചെല്ലൂ",
        "അധൈര്യപ്പെടാതെ നാം",
        "എല്ലാ ദുഃഖങ്ങളും വഹിപ്പാൻ",
        "ഇല്ല വേറെ സ്നേഹിതൻ",
        "ചെല്ലൂ കർത്തൻ സന്നിധിയിൽ",
        "വല്ലഭൻ സഹായിക്കും -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഭാരമേറ്റും അദ്ധ്വാനിച്ചും",
        "ക്ഷീണിതനാണെങ്കിൽ നീ",
        "യേശു നൽകും ആശ്വാസം",
        "തൻസന്നിധി താനഭയം",
        "സ്നേഹിതർ കൈവിട്ടാലുറ്റ",
        "സ്നേഹിതനാം ക്രിസ്തു താൻ",
        "സ്നേഹകരങ്ങളിൽ കാക്കും",
        "സുസ്ഥിരമാം വിശ്രാമം -"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
