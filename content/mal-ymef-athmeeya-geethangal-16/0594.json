{
  "number": 594,
  "title": "പിന്തുടരും ഞാനേശുവിനെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവിൻ ദിവ്യനാമമേ",
        "ശാശ്വത സങ്കേതമേ",
        "സ്വർഗ്ഗീയമാമനുഗ്രഹമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പിന്തുടരും ഞാനേശുവിനെ",
        "എന്തു വിപത്തുകൾ വന്നാലും",
        "വൻതിരകളുയരുകിലും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കേവലമീ ഭൂമരുവിൽ ഞാൻ",
        "വഴിവിട്ടിനി വലയാതെ",
        "തൻ വലങ്കൈ നടത്തുമെന്നെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തൻ ക്രൂശിലെ സ്നേഹസ്വരം",
        "സങ്കടമഖിലവും തീർത്തിടുമേ",
        "തങ്കമുഖമെന്താനന്ദമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സംശയമില്ലെനിക്കവനെ",
        "ശാശ്വതമായ തൻ തിരുവചനം",
        "നിശ്ചയമായ് നിലനിൽക്കും"
      ]
    }
  ],
