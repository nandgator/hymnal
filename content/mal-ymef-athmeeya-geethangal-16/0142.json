{
  "number": 142,
  "title": "ദേവാ വന്ദനം വന്ദനമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ദേവാ വന്ദനം വന്ദനമേ",
        "ക്രിസ്തുനാഥാ വന്ദനമേ",
        "യേശു രാജാധി രാജാവേ",
        "കർത്താധികർത്തവേ വന്ദനം വന്ദനമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആദികാരണനായവനേ",
        "ദൂതവന്ദിത വല്ലഭനേ",
        "നിത്യജീവനും, സത്യവും, മാർഗ്ഗവുമായ",
        "ശ്രീയേശു മഹോന്നതനേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വിണ്ണിൻ മഹിമ വിട്ടിറങ്ങി",
        "പാപലോകത്തിൽ വന്നവനേ",
        "മർത്യപാപവും ശാപവും എല്ലാം",
        "ചുമന്നൊഴിച്ചുന്നതനാത്മജനേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രൂശിൽ മരിച്ച രക്ഷകനേ",
        "മൂന്നാം നാളിലുയിർത്തവനേ",
        "ഇന്നു വിണ്ണിലും മണ്ണിലും",
        "കർത്താധികർത്താവായ്",
        "വാഴുമത്യുന്നതനേ"
      ]
    }
  ],
