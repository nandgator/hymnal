{
  "number": 344,
  "title": "എത്ര മധുരം തൻ നാമം",
  "parts": [
    {
      "id": "c",
      "kind": "chorus",
      "lines": [
        "എത്ര മധുരം തൻ നാമം",
        "എന്നേശു രക്ഷകൻ നാമം",
        "വിണ്മയർ വീണു വണങ്ങിടും വല്ലഭ",
        "നാമം അതിശയനാമം -"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവിൻ നാമം - ശാശ്വതനാമം",
        "ക്ലേശങ്ങളെല്ലാം - തീർത്തിടും നാമം",
        "വിശ്വാസികൾക്കുളളിൽ",
        "ആശ്വാസമേകിടും നാമം അതിശയനാമം -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യേശുവിൻ നാമം ഉന്നത നാമം",
        "ഉലകിലുദിച്ചോരു - ത്തമ നാമം",
        "സൗരഭ്യം തൂകും പരിമളതൈലമീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യേശുവിൻ നാമം - രക്ഷണ്യനാമം",
        "പരിശുദ്ധമാർഗ്ഗം കാട്ടിടും നാമം",
        "വാനവും ഭൂമിയും മാറുമെന്നാലും",
        "മാറാത്ത നിസ്തുല്യനാമം -"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "യേശുവിൻ നാമം അത്ഭുതനാമം",
        "പാപത്തിൻ ശാപം തീർത്തിടും നാമം",
        "തുമ്പം സഹിച്ചവർക്കിമ്പം പകർന്നിടും"
      ]
    }
  ],
