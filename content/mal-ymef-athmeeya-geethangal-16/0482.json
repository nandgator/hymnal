{
  "number": 482,
  "title": "ദൈവത്തിൽ ഞാൻ കണ്ടൊരു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "തന്റെ ചിറകിന്നു കീഴ്",
        "ദുർഘടങ്ങൾ നീങ്ങി ഞാൻ",
        "വാഴുന്നെന്തുമോദമായ്",
        "പാടും ഞാൻ അത്യുച്ചമായ്"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവത്തിൽ ഞാൻ കണ്ടൊരു",
        "നിർഭയമാം പാർപ്പിടം",
        "ഇത്ര സൗഖ്യമെങ്ങുമേ",
        "കാണുന്നില്ല സാധു ഞാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തന്റെ നിഴലിനു കീഴ് -",
        "ഛന്നനായ് ഞാൻ പാർക്കയാൽ",
        "രാപ്പകൽ ഞാൻ നിർഭയൻ",
        "ഭീതി ദൂരെ പാഞ്ഞുപോയ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഘോരമഹാമാരിയോ",
        "കൂരിരുട്ടിൻ വേളയോ",
        "ഇല്ലതെല്ലും ചഞ്ചലം",
        "നാഥനുണ്ടു കൂടവേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ആയിരങ്ങളെന്നുടെ നേർക്കു",
        "വന്നെതിർക്കിലും",
        "വീതിയുളള പക്ഷങ്ങൾ",
        "സാധുവെ മറച്ചിടും"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സ്നേഹശാലി രക്ഷകൻ",
        "ഖേടകം തൻ സത്യമാം",
        "എന്റെ ചങ്കിലുണ്ടിതാ",
        "രക്ഷിതാവിൻ പേർ സദാ"
      ]
    }
  ],
