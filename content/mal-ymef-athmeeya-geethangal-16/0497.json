{
  "number": 497,
  "title": "യേശു എന്നുള്ളത്തില്‍ വന്ന നാളില്‍",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു എന്നുള്ളത്തില്‍ വന്ന നാളില്‍",
        "എന്തു മാറ്റം വന്നു എന്നില",
        "തന്നെ ഞാനുള്ളത്തില്‍ ഏറ്റത",
        "എന്തു മോദം വന്നു എന്നില്‍"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വന്‍ വിനകള്‍ തന്‍ നടുവില്‍ സഹായമേകി",
        "എന്റെ പാപശാപമെല്ലാം തന്‍മേലേറ്റി",
        "ക്രൂശില്‍ തന്‍ ചോരയെന്‍ പേര്‍ക്കായൂറ്റി",
        "എന്തുമാറ്റം വന്നു എന്നില്‍"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പൊന്‍നിണം തന്നെന്‍ വിലയായ്‌ വീണ്ടു കൊള്‍വാന്‍",
        "എന്നുമെന്നും ഞാനവന്റേതൊന്നുമാര്രം",
        "ദേഹമെന്‍ ദേഹിയെന്നാത്മാവും",
        "എന്തുമാറ്റം വന്നു എന്നില്‍"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻവഴിയിൽ ദുർഘടങ്ങൾ എല്ലാം നീങ്ങി",
        "എന്റെയാശ എന്റെ ലാക്കും ഒന്നു മാത്രം",
        "ഇല്ലിനി മൃത്യുവിൻ ഭീതിയെന്നിൽ",
        "എന്തു മാറ്റം വന്നു എന്നിൽ!"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രാത്രികാലം തീർന്നിടാറായ് പ്രഭാതമെത്തി",
        "പ്രഭാതതാരം യേശു വാനിൽ വന്നിടാറായ്",
        "എന്നുമെൻ ഗാനമിതൊന്നുമാത്രം",
        "എന്തു മാറ്റം വന്നു എന്നിൽ!"
      ]
    }
  ],
