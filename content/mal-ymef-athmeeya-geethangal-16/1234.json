{
  "number": 1234,
  "title": "പൊൻപുലരിയിലെൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പൊൻപുലരിയിലെൻ",
        "ദൈവത്തിൻ സ്നേഹം",
        "ഓർക്കുവതാനന്ദമേ - അതു",
        "തീർന്നിടാതിഹത്തിൽ",
        "തുടർന്നിടും പരത്തിൽ",
        "അതുല്യമതിശയമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രാവിലെൻ മനസ്സിൻ ഭാരങ്ങളഖിലം",
        "യാഹെ ഞാനേൽപ്പിച്ചതാൽ - ഇന്നും",
        "ദൈവത്തെ സ്തുതിക്കും",
        "നേരമെൻ ഭയവും",
        "ശങ്കയും നീങ്ങിടുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഇന്നുമെൻ നിനവും ആശകളഖിലം",
        "ദൈവഹിതാനുസൃതം - ആയെൻ",
        "ആയുസ്സിൻ ദിനവും",
        "ആശിഷ‍ായ് ഭവിപ്പാൻ",
        "ആശയാൽ കുമ്പിടുന്നു"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
