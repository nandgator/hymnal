{
  "number": 1571,
  "title": "നീ എന്റെ സങ്കേതമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നീ എന്റെ സങ്കേതമേ",
        "ഈ ലോകയാത്രയതിൽ",
        "നിൻ കൃപ മാത്രം മതി",
        "ആശ്വാസമായുലകിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എൻ മനം നീറിടുമ്പോൾ",
        "കൂരിരുൾ ഏറിടുമ്പോൾ",
        "നല്ലൊരു രക്ഷകനിക്ഷിതിയിൽ വന്നു",
        "എന്നെയും രക്ഷിപ്പാനായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ലോകം വെറുത്തിടുമ്പോൾ",
        "സ്നേഹിതർ കൈവിടുമ്പോൾ",
        "ക്രിസ്തുവിൻ ദീപമായ്",
        "നാടെങ്ങും ശോഭിപ്പാൻ",
        "എന്നെന്നും കൃപ നൽകണേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഈ മരുയാത്രയതിൽ",
        "ക്ഷീണിതനായിടുമ്പോൾ",
        "നല്ലൊരു ദാസനായ് ലോകെ",
        "ഞാൻ ജീവിപ്പാൻ",
        "എന്നെന്നും കൃപ നൽകണേ"
      ]
    }
  ],
