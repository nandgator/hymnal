{
  "number": 336,
  "title": "ക്രിസ്തേശുവിന്റെ നാമമേ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അതിചിത്രമാം നാമം",
        "എൻ യേശുവിൻ നാമം",
        "അതിചിത്രമാം നാമം",
        "എൻ രക്ഷകന്റെ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ക്രിസ്തേശുവിന്റെ നാമമേ",
        "അതിചിത്രമാം നാമം",
        "ആകാശത്തിൻ കീഴെങ്ങുമേ",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തൻശുദ്ധ രക്തത്തളിപ്പു",
        "അതിചിത്രമാം നാമം",
        "വരുത്തി ദൈവയോജിപ്പു",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഹാ! പാപ വാഴ്ച കഴിഞ്ഞു",
        "അതിചിത്രമാം നാമം",
        "പിശാചിൻബന്ധം അഴിഞ്ഞു",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അശുദ്ധി പാർത്ത ഹൃദയം",
        "അതിചിത്രമാം നാമം",
        "വിശുദ്ധാത്മാവിൻ പാർപ്പിടം",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എൻ ദൈവത്തിന്നു ജീവിപ്പാൻ",
        "അതിചിത്രമാം നാമം",
        "ഞാൻ സ്വതന്ത്രൻ ഞാൻ",
        "ഭാഗ്യവാൻ അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "പരീക്ഷകൻ സമീപിച്ചാൽ",
        "അതിചിത്രമാം നാമം",
        "എൻ ജയം ക്രൂശിൻ രക്തത്താൽ",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "എന്നേക്കും എന്നെ കാക്കുവാൻ",
        "അതിചിത്രമാം നാമം",
        "കൈയേറ്റെൻ പ്രാണനായകൻ",
        "അതിചിത്രമാം നാമം"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ഹാ യേശുവേ! നിൻ സ്വന്തം",
        "ഞാൻ അതിചിത്രമാം നാമം",
        "എന്നേക്കും എന്റെ സ്വന്തം",
        "താൻ അതിചിത്രമാം നാമം"
      ]
    }
  ],
