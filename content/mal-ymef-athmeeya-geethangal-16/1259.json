  "title": "ആകാശം ഭൂമിയിവ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആകാശം ഭൂമിയിവ",
        "നിർമ്മിച്ച ദേവദേവൻ",
        "സീയോനിൽ നിന്നിവരെ വാഴ്ത്തട്ടെ",
        "വാഴ്ത്തുവിൻ പരം വാഴ്ത്തുവിൻ",
        "ഏകൻ ത്രിയേകനാകും",
        "സ്നേഹസ്വരൂപിയെന്നും",
        "ഏകട്ടെ മംഗളങ്ങൾ മേൻമേലായ്‌"
      ]
    }
  ],
