{
  "number": 947,
  "title": "യേശു വരുന്നു വേഗം വരുന്നു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു വരുന്നു വേഗം വരുന്നു",
        "ഒരുങ്ങുവിൻ പ്രിയരേ!- നമ്മൾ",
        "പ്രാണനാഥൻ വരുന്നു കാണുവാൻ",
        "കാത്തിരിപ്പിൻ പ്രിയരേ!"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അത്തിവൃക്ഷം തളിർത്തുനിൽക്കും",
        "കാലമായല്ലോ",
        "കാത്തിരുന്ന സ്വന്തനാട്ടിൽ",
        "യൂദർ പോയല്ലോ",
        "കാലമേറെയില്ല -",
        "കാന്തൻ താമസിക്കയില്ല",
        "വേഗം വന്നു വീട്ടിൽ നമ്മെ ചേർത്തിടുമല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സർവ്വസൃഷ്ടിജാലം പോലും",
        "കാത്തിരിക്കയാം",
        "ദൈവപുത്രൻ വീണ്ടെടുപ്പ്",
        "പൂർത്തിയാകുവാൻ",
        "അന്നേ ശോകം തീരൂ",
        "യേശു വന്നേ ശാപം മാറൂ",
        "ഉർവിയെങ്ങുമന്നു മാത്രം",
        "ശാന്തി വന്നിടും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഉദയതാരമുദിച്ചു നേരം",
        "വെളുക്കുവോളവും",
        "ഹൃദയവീട്ടിൽ വചനമാകും",
        "വിളക്കു വയ്ക്കുവിൻ",
        "അന്ധകാരം മാറും",
        "ദുഃഖബന്ധനങ്ങൾ തീരും",
        "നീതി സൂര്യൻ കാന്തി ചിന്തി വന്നുദിക്കുമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പാരിൽ തപിക്കും ഭക്തർ",
        "ഖേദം വേഗം തീരുമേ",
        "നേരിൽ തന്നെ കാണും",
        "നേരം കണ്ണീർ തോരുമേ",
        "പിന്നെ ദുഃഖമില്ല",
        "മൃത്യുവെന്ന ശത്രുവില്ല",
        "എന്നുമെന്നും കർത്തനോടു",
        "ചേർന്നു വാഴുമേ!"
      ]
    }
  ],
