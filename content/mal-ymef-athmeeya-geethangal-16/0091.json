{
  "number": 91,
  "title": "ആനന്ദമായ് ആത്മനാഥനെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആനന്ദമായ് ആത്മനാഥനെ",
        "ആയുസ്സെല്ലാം ഞാൻ പാടി സ്തുതിക്കും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അകൃത്യങ്ങൾ നീക്കി പാപങ്ങൾ പോക്കി",
        "അവൻ മകനാക്കി സ്വർഗ്ഗത്തിലിരുത്തി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അനുദിനമിന്നു അനുഭവിക്കുന്നു",
        "ആത്മസന്തോഷം അനന്ത സൗഭാഗ്യം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അന്ത്യം വരെയും അന്തികേയുള്ള",
        "ആരോമൽസഖി താൻ ആരുമില്ലിതുപോൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അത്ഭുതമേശുവിന്നനുപമ സ്നേഹം",
        "ആരാലും വർണ്ണ്യമല്ലവൻ കൃപകൾ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "അൽപ്പനാൾ മാത്രം കൂടാരവാസം",
        "അക്കരെ നാട്ടിൽ ചെല്ലുമെൻ വീട്ടിൽ"
      ]
    }
  ],
