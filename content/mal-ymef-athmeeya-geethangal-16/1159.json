{
  "number": 1159,
  "title": "പാപികളിൻ രക്ഷകൻ താ -",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പാപികളിൻ രക്ഷകൻ താ -",
        "നിവൻ പാദം വണങ്ങിടും നീ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപശാപം തീർപ്പാൻ",
        "പാരിൽ ജനിച്ചോരു",
        "ദേവസുതനാകുമേശു",
        "നായകനിവനറിക"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആദിവചനമായ് ഭേദമെന്യേ നിന്നു",
        "മേദിനിയോടഖിലവും",
        "മോദമായ് ചമച്ചതിവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ആദിപിതാക്കൾക്കോരേക",
        "ശരണമായ്",
        "സാദരമായ് നിന്ന ദിവ്യ",
        "ദാനവസ്തുവായതിവൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദിവ്യബലികൾക്കൊരവ്യാജ",
        "ശക്തിയായ്",
        "ഭവ്യമായിരുന്ന നിത്യഹവ്യ",
        "വസ്തുവായതിവൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ക്രൂശിൽ മരിച്ചതാൽ നാശമൊഴിച്ചു",
        "തന്നാശ്രയം തെളിഞ്ഞുടൻ",
        "പ്രത്യാശയിൻവഴി തുറന്നാൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ജീവനിൽ പൂകേണ്ട വാതിലാം",
        "തന്നിലൂടാവലായടുപ്പോർ",
        "ദിവ്യജീവനിൽ കടന്നിടുന്നു"
      ]
    }
  ],
