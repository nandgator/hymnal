{
  "number": 329,
  "title": "വാഴ്ത്തിടുന്നു നാഥാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വാഴ്ത്തിടുന്നു നാഥാ",
        "വാഴ്ത്തിടുന്നു ദേവാ",
        "വാഴ്ത്തിടുന്നു ഭൂവാനങ്ങൾ",
        "സൃഷ്ടിച്ച ദൈവാത്മജാ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആദിയനാദിയും നീ",
        "അൽഫഒമേഗയും നീ",
        "ആയിരം പതിനായിരങ്ങളിൽ",
        "സർവ്വാംഗസുന്ദരൻ നീ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഉന്നതദേവൻ നീ",
        "വന്ദ്യമഹോന്നതൻ നീ",
        "ലോകത്തിൻ പാപം",
        "ചുമന്നൊഴിപ്പാൻ",
        "വന്നൊരു കുഞ്ഞാടു നീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സ്വന്തനിണം ക്രൂശിൽ",
        "ചിന്തിമുഴുവൻ നീ",
        "നൊന്തുനിൻ പ്രാണൻ",
        "വെടിഞ്ഞുയിർത്തു",
        "വാഴുമാചാര്യൻ നീ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഏകമദ്ധ്യസ്ഥൻ നീ",
        "ഏവർക്കും രക്ഷകൻ നീ",
        "ഇന്നലെ ഇന്നുമെന്നും മാറാത്ത",
        "വല്ലഭ ദേവൻ നീ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സ്തോത്രം ഹല്ലേലുയ്യ",
        "മാമഹത്വം സ്തുതിയും",
        "സാദരം സർവ്വവും അർപ്പിച്ചു",
        "നാഥാ പാദം കുമ്പിടുന്നു"
      ]
    }
  ],
