{
  "number": 191,
  "title": "ഏകസത്യദൈവമേ എന്റെ ദൈവമേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഏകസത്യദൈവമേ എന്റെ ദൈവമേ",
        "എന്നുമുള്ള ദൈവമേ എന്റെ ദൈവമേ",
        "നീ തന്നെ ദൈവം നീ മാത്രം ദൈവം",
        "നീയെന്നും അത്യുന്നതൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആഴിയും അനന്തമാം താരവീഥിയും",
        "ഊഴിയും പ്രപഞ്ചവും സൃഷ്ടി ചെയ്തവൻ",
        "നീ തന്നെ ദൈവം നീ മാത്രം ദൈവം",
        "നീയെന്നും സർവ്വശക്തനാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഏകജാതനെയെനിക്കേകിയവൻ നീ",
        "ഏഴയെന്നെ അത്രമേൽ സ്നേഹിപ്പവൻ നീ",
        "നീ തന്നെ ദൈവം നീ മാത്രം ദൈവം",
        "നീയെന്നും അത്യുന്നതൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എന്നുമീ ധരിത്രിയിൽ കൂടെയുള്ളവൻ",
        "ഇന്നുമെന്നുമൊന്നുപോലെ കാത്തിടുന്നവൻ",
        "നീ തന്നെ ദൈവം നീ മാത്രം ദൈവം",
        "നിയെന്നും മതിയായവൻ"
      ]
    }
  ],
  "sequence": [
