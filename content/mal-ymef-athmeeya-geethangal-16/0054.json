{
  "number": 54,
  "title": "സ്തുതിപ്പിൻ നാം യഹോവയെ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്തുതിപ്പിൻ നാം യഹോവയെ",
        "അവൻ നല്ല നാഥനല്ലോ",
        "സ്തുതിക്കണമവനെ നാം",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദേവദേവനെ സ്തുതിപ്പിൻ",
        "അവൻ നല്ല നാഥനല്ലോ",
        "കർത്തൃകർത്തനെ സ്തുതിപ്പിൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തനിച്ചത്ഭുതം ചെയ്‌വവൻ",
        "അവൻ നല്ല നാഥനല്ലോ",
        "ചമച്ചാകാശങ്ങളവൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഭൂമേൽ വെള്ളം വിരിച്ചോ -",
        "നവൻ നല്ല നാഥനല്ലോ",
        "ജ്യോതിസ്സുകൾ ചമച്ചവൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പകൽ വാഴും സൂര്യനെയും",
        "അവൻ നല്ല നാഥനല്ലോ",
        "രാത്രിചന്ദ്രാദികളെയും",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "മിസ്രേം കടിഞ്ഞൂൽ കൊന്നവൻ",
        "അവൻ നല്ല നാഥനല്ലോ",
        "യിസ്രായേലെ വീണ്ടുകൊണ്ടോ -",
        "നവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "വിസ്തൃതമാം കൈയൂക്കിനാ",
        "ലവൻ നല്ല നാഥനല്ലോ",
        "ചെങ്കടൽ പകുത്തതവൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "അതിലൂടവരെ നയി -",
        "ച്ചവൻ നല്ല നാഥനല്ലോ",
        "എതിരികളെയമിഴ്ത്തി",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "മരുവിൽ ജനത്തെ നയി -",
        "ച്ചവൻ നല്ല നാഥനല്ലോ",
        "അരചരെ നശിപ്പിച്ചാ -",
        "നവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "ശ്രുതിതിപ്പെട്ട രാജരെത്താ",
        "നവൻ നല്ല നാഥനല്ലോ",
        "സീഹോനമോർ രാജാവിനെ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s11",
      "kind": "stanza",
      "label": "11",
      "lines": [
        "ബാശാൻ രാജാവോഗിനെയും",
        "അവൻ നല്ല നാഥനല്ലോ",
        "അവർ ദേശം പകുത്തവൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s12",
      "kind": "stanza",
      "label": "12",
      "lines": [
        "തൻ ജനത്തിന്നവ നൽകി",
        "അവൻ നല്ല നാഥനല്ലോ",
        "തൻ ജനത്തിൻ താഴ്നിലയോർ",
        "ത്തവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s13",
      "kind": "stanza",
      "label": "13",
      "lines": [
        "ശത്രുകൈയിൽനിന്നും വീണ്ടാ -",
        "നവൻ നല്ല നാഥനല്ലോ",
        "പോറ്റുന്നവനെല്ലാറ്റെയു -",
        "മവൻ കൃപ നിത്യമല്ലോ"
      ]
    },
    {
      "id": "s14",
      "kind": "stanza",
      "label": "14",
      "lines": [
        "സ്വർഗ്ഗദേവനെ സ്തുതിപ്പിൻ",
        "അവൻ നല്ല നാഥനല്ലോ",
        "നിത്യരാജനെ വാഴ്ത്തുവിൻ",
        "അവൻ കൃപ നിത്യമല്ലോ"
      ]
    }
  ],
