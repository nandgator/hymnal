{
  "number": 539,
  "title": "അനുദിനമെന്നെ പുലർത്തുന്ന ദൈവം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "അനുദിനമെന്നെ പുലർത്തുന്ന ദൈവം",
        "അനവധി നന്മകൾ നല്കിടുന്നു",
        "അനന്തമാം തിരുകൃപ മതിയേ",
        "ആനുഗ്രഹ ജീവിതം നയിച്ചിടുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അവനിയിലെ അനർത്ഥങ്ങളാൽ",
        "അലയുവാൻ അവനെന്നെ കൈവിടില്ല",
        "അകമെ താനരൂപിയായുളളതിനാൽ",
        "ആകുലമില്ലെനിക്കാധിയില്ല"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജീവിതമാം എൻ പടകിൽ",
        "വൻ തിരമാല വന്നാഞ്ഞടിച്ചാൽ",
        "അമരത്തെൻ അഭയമായ്‌ നാഥനുണ്ട്",
        "അമരും വൻ കാറ്റും തിരമാലയും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ബലഹീനമാം എൻ ശരീരം",
        "ഈ മണ്ണിൽ മണ്ണായ്‌ തീരുമെന്നാൽ",
        "തരും പുതുദേഹം തൻ ദേഹ സമം",
        "തേജെസ്സെഴുന്നൊരു വിൺ ശരീരം"
      ]
    }
  ],
