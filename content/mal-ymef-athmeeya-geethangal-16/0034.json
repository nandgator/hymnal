{
  "number": 34,
  "title": "ദൈവമാം യഹോവയെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ദൈവമാം യഹോവയെ",
        "സ്തുതിക്ക തന്റെ മന്ദിരേ - ഓ",
        "വാനഗോള സംവിധാനമേനി",
        "കണ്ടു വാഴ്ത്തുക"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ധന്യമായ തന്റെ വേല",
        "മന്നിൽ രക്ഷ തന്നു ഹാ!",
        "ഉന്നതന്റെ വൻ കൃപയ്ക്കു മുന്നിൽ",
        "നമ്മൾ വാഴ്ത്തണം",
        "വൻമഹിമയുള്ള തന്റെ",
        "നാമമെത്ര വന്ദ്യമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കാഹളങ്ങളുച്ചനാദ",
        "ഭംഗിയിൽ മുഴങ്ങണം",
        "വീണമീട്ടിപ്പാടൂ നമ്മൾ",
        "മോദഗീതമങ്ങനെ",
        "കിന്നരത്തിനുള്ള കമ്പി -",
        "യീണമേകി നിൽക്കണം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തപ്പുവാദ്യമൊപ്പമുള്ള",
        "ചിട്ടകൾ ചമയ്ക്കണം",
        "തന്ത്രി നാദമെന്നു വേണ്ട",
        "വേണുനാദമോടെയും",
        "നൃത്തഗാനമോടു നമ്മൾ സ്തോത്ര -",
        "മേകി വാഴ്ത്തണം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കരങ്ങൾ കൊട്ടിയുച്ചനാദ",
        "ഭംഗിയിൽ പുകഴ്ത്തണം",
        "വല്ലഭന്റെ നല്ല നാമമെന്നുമെന്നുമുന്നതം",
        "ജീവനുള്ളതൊക്കെയും",
        "യഹോവയെ വണങ്ങണം"
      ]
    }
  ],
