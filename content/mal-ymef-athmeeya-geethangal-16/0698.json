{
  "number": 698,
  "title": "എന്നെ വഴി നടത്തുന്നോൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എന്നെ വഴി നടത്തുന്നോൻ",
        "എന്റെ ഈ മരുവാസത്തിൽ",
        "ഓരോ ദിവസവും എന്നെ നടത്തുന്നോൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സാറാഫുകളവർ ഓരോ നിമിഷവും",
        "പാടിസ്തുതിക്കുമ്പോൾ",
        "അതിലുന്നതമായ സ്ഥാനങ്ങളിന്മേൽ",
        "എന്നെ നടത്തുന്നോൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രോഗം മരണങ്ങൾ ഓളങ്ങളാലെ",
        "ഏറി ഉയരുമ്പോൾ",
        "എന്റെ വിശ്വാസക്കപ്പൽ താളടിയാകാതെ",
        "എന്നെ നടത്തുന്നോൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശത്രുവിൻ ശക്തികൾ ഓരോ ദിവസവും",
        "ഏറി ഉയരുമ്പോൾ",
        "എന്റെ ശത്രുക്കൾ മുമ്പാകെ ഓരോ",
        "ദിവസവും മേശ ഒരുക്കുന്നോൻ"
      ]
    }
  ],
