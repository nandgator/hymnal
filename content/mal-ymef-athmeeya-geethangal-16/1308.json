{
  "number": 1308,
  "title": "എന്തോരേന്തൊരു മോദം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്തോരേന്തൊരു മോദം",
        "എനിക്കയ്യാ",
        "എന്നുള്ളിലതിമോദം",
        "യേശുവിന്റെ രക്ഷകനായ്",
        "ഉള്ളിലെനിക്കുള്ളതാല്‍",
        "എന്നെന്നുമതിമോദം -",
        "മനമതില്‍ നിറയണമമ്മാ - മ - മമ്മാ - മമ്മാ"
      ]
    }
  ],
