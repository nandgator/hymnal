{
  "number": 977,
  "title": "വരുന്നു വേഗം യേശു രാജൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആ... ആനന്ദമേ പരമാനന്ദമേ",
        "അന്നാളിലെന്തോരാനന്ദമേ",
        "മനുവേൽ മശിഹ നീതിയിൽ",
        "രാജനായ് ഭൂ -",
        "വാഴുമന്നാളിലെന്താനന്ദമേ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വരുന്നു വേഗം യേശു രാജൻ",
        "ഭരണം ഭൂമേൽ ചെയ്തിടുവാൻ",
        "ദൈവികരാജ്യം സ്ഥാപിക്കുവാൻ",
        "വരുന്നു വേഗം യേശുരാജൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "സാത്താനെ ബന്ധനം ചെയ്തിടുമേ",
        "ശാശ്വത ശാന്തി പകർന്നിടുമേ",
        "സന്താപങ്ങൾ പറന്നോടിടുമേ",
        "സത്ഭരണം ഭൂവിലായിടുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യുദ്ധവും ക്ഷാമവും ഭൂകമ്പവും",
        "ഉഗ്രജനങ്ങളിൻ കൊലവിളിയും",
        "ഭീകര വാഴ്ചയും മാറിടുമേ",
        "പ്രീതിയോടേവരും വസിച്ചിടുമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "മരുഭൂതലവും മലരണിയും",
        "വരണ്ടഭൂമയിൽ ഫലം പെരുകും",
        "അനുഗ്രഹമാരിയാൽ ജലം നിറയും",
        "അവനിയിലേശു വാണിടുമ്പോൾ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നിന്ദിതരും രക്തസാക്ഷികളും",
        "മന്നിതിൽ പാടുകളേറ്റവരും",
        "പൊന്മുടി ചൂടിയന്നാർത്തു പാടി",
        "മന്നവൻ ക്രിസ്തുവിൻ കൂടെ വാഴും"
      ]
    }
  ],
