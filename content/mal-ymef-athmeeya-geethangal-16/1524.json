{
  "number": 1524,
  "title": "എത്ര നല്ലവൻ എൻ യേശു നായകൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്ര നല്ലവൻ എൻ യേശു നായകൻ",
        "ഏതു നേരത്തും നടത്തിടുന്നവൻ",
        "എണ്ണിയാൽ തീർന്നിടാ",
        "നന്മകൾ ചെയ്തവൻ",
        "എന്നെ സ്നേഹിച്ചവൻ ഹാലേലൂയ്യാ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നായകനവൻ നമുക്കു മുമ്പിലായ്",
        "നൽ വഴികളെ ഒരുക്കിടുന്നവൻ",
        "നന്ദിയാൽ പാടും ഞാൻ",
        "നല്ലവൻ യേശുവേ",
        "നാടെങ്ങും ഘോഷിക്കും",
        "നിൻ മഹാസ്നേഹത്തെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പ്രിയരേവരും പ്രതികൂലമാകുമ്പോൾ",
        "പാരിലേറിടും പ്രയാസവേളയിൽ",
        "പൊന്മുഖം കണ്ടു ഞാൻ",
        "യാത്ര ചെയ്തിടുവാൻ",
        "പൊന്നു നാഥൻ കൃപ",
        "ഏകണേ ദാസരിൽ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
