{
  "number": 16,
  "title": "സ്തോത്രം സ്തോത്രം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്തോത്രം സ്തോത്രം",
        "സ്തോത്രഗീതങ്ങളാൽ",
        "കർത്തനെ സ്തുതിച്ചിടും ഞാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപത്തിൻ കുഴിയിൽ",
        "ശാപത്തിൻ വഴിയിൽ",
        "പാരം വലഞ്ഞയെന്നെ",
        "തേടിവന്നു ജീവൻ തന്നു",
        "നേടിയെടുത്തി്ടയൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ലംഘനം ക്ഷമിച്ചും",
        "പാപങ്ങൾ മറച്ചും",
        "ലഭിച്ചെനിക്കായതിനാൽ",
        "ഭാഗ്യവാനായി പാർത്തിടുന്നു",
        "ഭാവി പ്രത്യാശയോടെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നന്മകൾ നൽകി",
        "നൽവഴീലെന്നെ",
        "നന്നായ് നടത്തുന്നവൻ",
        "നന്ദിയോടെൻ നാൾകളെല്ലാം",
        "നാഥനായ് ജീവിക്കും ഞാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വല്ലഭനേശുവിൻ",
        "വന്ദിതനാമം",
        "വർണ്യമല്ലെൻ നാവിനാൽ",
        "കീർത്തിക്കും ഞാൻ സ്തോത്രം ചെയ്യും",
        "കീർത്തനം പാടിടും ഞാൻ"
      ]
    }
  ],
