{
  "number": 1141,
  "title": "ഇന്നു നീ ഒരിക്കൽ കൂടി",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഇന്നു നീ ഒരിക്കൽ കൂടി",
        "ദൈവവിളി കേട്ടല്ലോ",
        "രക്ഷിതാവു സ്നേഹത്തോടെ",
        "കാത്തിരിക്കുന്നുണ്ടല്ലോ",
        "ഇന്നു തന്നെ യേശു നിന്നെ",
        "രക്ഷിപ്പാനായ് കാക്കുന്നു",
        "ഭയം വേണ്ടാ, ശങ്കിക്കേണ്ടാ",
        "വാ ഇന്നവങ്കൽ നീ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്രനാൾ വൃഥാവായ് ഓടി",
        "മനുഷ്യാ നിൻ ജീവിതം",
        "ലോകത്തിന്റെ ഇമ്പം തേടി",
        "പാഴിലാക്കി ഈവിധം -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കൈക്കൊളളാതെ തളളുമെന്നു",
        "ഒട്ടും വേണ്ടാ സംശയം",
        "രക്ഷിതാവു നിന്നെയിന്നു",
        "സ്വന്തമാക്കി തീർത്തിടും"
      ]
    }
  ],
