{
  "number": 1369,
  "title": "യേ ദുനിയാ ദോ ദിൻ കാ മേളാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേ ദുനിയാ ദോ ദിൻ കാ മേളാ",
        "യേ ദുനിയാ ദോ ദിൻ കാ മേളാ",
        "സോച് സമഝ്കർ സൗദാകർ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സുന്ദർ സുന്ദർ മഹല് ബനായേം",
        "കൗഡീ കൗഡീ മായാ ജോഡീ",
        "ഖാലീ ആയാ ഖാലീ ജാനാ",
        "ധോഖാ ഹീ ധോഖാ ഹെ",
        "യഹ് സബ് കുഛ് ഛോഡ്കെ ജാനാ ഹെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മാതാ പിതാ ഔർ ഭായീ ബഹനെം",
        "ഖേത് കുടുംബ് യേ നാതേ സാരെ",
        "കഹ് നെ കേ ഹേം തേരാ മേരാ",
        "കഹ് നാ ഹീ കഹ് നാ ഹെ",
        "യഹ് സബ് കുഛ് നാതേ ഝൂഠേ ഹെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഗർ യീശു കീ ആജ്ഞാ മാനെ",
        "ദുനിയാദാരീ കൊ ബീസാർ കേ",
        "ഉസ്കേ കദ്മോം മെം ആ ജാവോ",
        "ദേതാ ഹെ വഹ് യഹ് ഗവാഹി",
        "കി തൂ മേരാ പ്യാരാ ബേടാ ഹെ"
      ]
    }
  ],
