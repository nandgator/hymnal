{
  "number": 1533,
  "title": "നാഥാ നിൻ തിരു സവിധേ - ഇന്നു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നാഥാ നിൻ തിരു സവിധേ - ഇന്നു",
        "താണു വണങ്ങിടുന്നു",
        "നാഥാ നിൻ തിരു സവിധേ - ഇന്നു",
        "വീണു വണങ്ങിടുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഉളളം തിങ്ങും ഭാരങ്ങളാൽ",
        "ഉള്ളുരുകി കേണിടുമ്പോൾ",
        "ഉണ്ടെനിക്കേശുവിന്റെ",
        "സന്നിധിയിലാശ്വാസം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കഷ്ടനഷ്ടമേറിടിലും",
        "ഇഷ്ടരായോർ മാറിടിലും",
        "കഷ്ടതയിൽ തുഷ്ടി നൽകും",
        "കർത്തനേശുക്രിസ്തു മതി"
      ]
    }
  ],
