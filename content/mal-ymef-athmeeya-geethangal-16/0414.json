{
  "number": 414,
  "title": "എടുക്ക എൻജീവനെ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എടുക്ക എൻജീവനെ",
        "നിനക്കായെൻ യേശുവേ",
        "അന്ത്യശ്വാസത്തോളം",
        "താ - നെഞ്ചതിൽ ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എടുക്ക എൻ കൈകളെ",
        "ചെയ്‌വാൻ സ്നേഹവേലയെ",
        "കാലുകളും ഓടണം",
        "നീ വിളിച്ചാൽ തത്ക്ഷണം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എടുക്ക എൻ നാവിനെ",
        "സ്തുതിപ്പാൻ പിതാവിനെ",
        "സ്വരം അധരങ്ങൾ വായ് -",
        "നിൽക്കുന്നു നിൻ ദൂതരായ് -"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എടുക്ക എൻ കർണ്ണങ്ങൾ",
        "കേൾക്കുവാൻ നിൻ മർമ്മങ്ങൾ",
        "കണ്ണിനും പ്രകാശം താ - നിന്നെ",
        "കാണ്മാൻ സർവ്വദാ -"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "എടുക്ക എൻ ബുദ്ധിയെ",
        "ഗ്രഹിപ്പാൻ നിൻ ശുദ്ധിയെ",
        "മനശ്ശക്തി കേവലം",
        "നിനക്കായെരിയണം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എടുക്ക എൻ ഹൃദയം",
        "അതു നിൻ സിംഹാസനം",
        "ഞാൻ അല്ല എൻ രാജാവേ",
        "നീ അതിൽ വാഴണമേ -"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "എടുക്ക എൻ ഭവനം",
        "നിനക്കെപ്പോൾ ആവശ്യം",
        "യോഗത്തിന്നും ശിഷ്യർക്കും",
        "അതു തുറന്നിരിക്കും -"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "എടുക്ക എൻ സമ്പത്തും",
        "എന്റെ പൊന്നും വെളളിയും",
        "വേണ്ടാ ധനം ഭൂമിയിൽ",
        "എൻ നിക്ഷേപം സ്വർഗ്ഗത്തിൽ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "മക്കളെയും യേശുവേ",
        "എടുക്കണം നിനക്ക്",
        "അവർ നിന്നെ സ്നേഹിപ്പാൻ",
        "പഠിച്ചാൽ ഞാൻ ഭാഗ്യവാൻ"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "എടുക്ക എൻ യേശുവേ",
        "എന്നെത്തന്നെ പ്രിയനേ!",
        "എന്നെന്നേക്കും നിനക്കു",
        "എന്നെ ഞാൻ പ്രതിഷ്ഠിച്ചു"
      ]
    }
  ],
