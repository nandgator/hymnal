{
  "number": 875,
  "title": "എൻ ദൈവമേ നീയൊഴികെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻ ദൈവമേ നീയൊഴികെ",
        "എന്നെ കരുതുവാനാരുമില്ല"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എരിയുന്ന വെയിലിൽ",
        "ഞാൻ തളരില്ല നാഥാ",
        "തണലായെനിക്കെന്നും",
        "നീ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീ തന്നതല്ലാതെ എനിക്കൊന്നുമില്ല",
        "അഖിലം നിൻകൃപയല്ലോ",
        "അതുമാത്രം മതിയെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നീ ചെയ്ത നന്മകൾക്കെന്തു പകരം",
        "ചെയ്തിടും നാഥാ ഞാൻ",
        "നിന്നെ സ്തുതിക്കും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "രോഗക്കിടക്കയിൽ ആശ്വാസം നീയേ",
        "മൃത്യുവിൻ നേരം",
        "നിന്മാറിൽ വിശ്രാമം"
      ]
    }
  ],
