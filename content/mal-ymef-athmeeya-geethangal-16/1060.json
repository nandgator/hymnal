{
  "number": 1060,
  "title": "കർത്താവിൻ ഭക്തന്മാർ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കർത്താവിൻ ഭക്തന്മാർ",
        "വാഗ്ദത്തനാടതിൽ",
        "എത്തിടുവാൻ കാലമായി",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ",
        "ഹല്ലേലുയ്യാ ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കാന്തൻ വന്നീടുവാൻ",
        "കാന്തയെ ചേർക്കുവാൻ",
        "കാലമായ് നാളങ്ങടുത്തുപോയി",
        "ഒരുങ്ങിയിരിക്കുന്നോർ",
        "ഒരുക്കിയ വീട്ടിലും",
        "ചേരും സമയവും ആസന്നമായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കണ്ണുനീർ തോർന്നിടും",
        "നിന്ദകൾ മാറിടും",
        "എണ്ണമില്ലായുഗം വാണീടും നാം",
        "ഒന്നിച്ചുകൂടുവാൻ ഒന്നിച്ചു പാടുവാൻ",
        "ഒന്നിച്ചുവാഴുവാൻ കാലമായി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പുത്തനാംശാലേമിൽ",
        "പുത്തൻ ശരീരത്തിൽ",
        "പുത്തൻ ഗീതങ്ങൾ നാം ആലപിക്കും",
        "പൊൻവീണകൾ മീട്ടി",
        "വിൺമയവീട്ടിൽ നാം പൊൻമുഖം",
        "കണ്ടെന്നും ആരാധിക്കും"
      ]
    }
  ],
