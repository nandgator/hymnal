{
  "number": 1179,
  "title": "കൃപയാലത്രേ ആത്മരക്ഷ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "കൃപയാലത്രേ ആത്മരക്ഷ",
        "അതു വിശ്വാസത്താൽ നേടുക",
        "വില കൊടുത്തു വാങ്ങുവാൻ സാദ്ധ്യമല്ല",
        "അതു ദാനം ദാനം ദാനം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മലകൾ കയറിയാൽ കിട്ടുകയില്ല",
        "ക്രിയകൾ നടത്തിയാൽ നേടുകയില്ല",
        "നന്മകൾ നോമ്പുകൾ",
        "നേർച്ചകൾ കാഴ്ചകൾ",
        "ഇവയാലൊന്നും രക്ഷ സാദ്ധ്യമല്ല"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഈ ലോകജീവിതത്തിൽ നേടുക",
        "നിന്റെ മരണശേഷം",
        "അവസരങ്ങളില്ല സോദരാ!",
        "നരകശിക്ഷയിൽ നിന്നു",
        "വിടുതൽ നേടുവാൻ",
        "ഇന്നു വരിക രക്ഷകന്റെ സന്നിധേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "രക്ഷകന്റെ സന്നിധേ ചെല്ലുക",
        "നിന്റെ പാപമെല്ലാം",
        "തന്റെ മുമ്പിൽ ചൊല്ലുക",
        "തന്റെ യാഗം മൂലമിന്ന്",
        "നിന്റെ പാപമെല്ലാം പോക്കി",
        "നിന്നെ ദൈവപൈതലാക്കി മാറ്റുമേ"
      ]
    }
  ],
