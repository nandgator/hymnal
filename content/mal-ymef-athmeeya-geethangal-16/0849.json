{
  "number": 849,
  "title": "യേശുവേ നീ നിൻ പാവന ചോര",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വല്ലഭൻ നീയേ നല്ലവൻ നീയേ",
        "വന്ദിതനെൻ പ്രിയനും",
        "എല്ലാമായ് നീയുളളതാലെൻ",
        "അല്ലൽ മറന്നിടും ഞാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവേ നീ നിൻ പാവന ചോര",
        "ചൊരിഞ്ഞെന്നെ വാങ്ങിയതാൽ",
        "ഇന്നുമെന്നും നിന്നടിമ",
        "ദാസനായ് പാർത്തിടും ഞാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഖേദമെഴും ഭൂവാസമിതേകും",
        "വേദന വേളകളിൽ",
        "നീയൊഴികെയാരുമില്ലെനി -",
        "ക്കാശ്രയമായ് പാരിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വാനവും ഭൂമിയും മാറിലും",
        "നീയോ മാറാതുണ്ടെനിക്കായ്",
        "മരുഭൂ നൽകും മാറയിലും",
        "നീ മാധുര്യ മൽ സഖിയാം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ചാവിനെ വെന്നു വിണ്ണിലെനിക്കായ്",
        "ജീവിക്കും നാഥനും നീ",
        "വീണ്ടുംവന്നെന്നെ ചേർപ്പവനും നീ",
        "വിമല മനോഹരൻ നീ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ആദിയും നീയേ അന്തവും നീയേ",
        "അൽഫ ഒമേഗയും നീ",
        "അവനിയിൽ വന്നു ആയിരമാണ്ടുകൾ",
        "വാണിടും രാജനും നീ"
      ]
    }
  ],
