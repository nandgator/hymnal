{
  "number": 1102,
  "title": "പോകുക പോകുക സോദരരേ! നാം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പോകുക പോകുക സോദരരേ! നാം",
        "പോകുക യുദ്ധം ചെയ്‌വതിന്നായ്",
        "പോകുക ക്രൂശിൻ പടയാളികളായ്",
        "പടപൊരുതിടാൻ പോയിടാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വചനം വാളായ് കൈകളിലേന്തി",
        "സത്യം നല്ലൊരു പരിചയുമായ്",
        "കവചമതായി നീതി ധരിച്ചും",
        "വിശ്വാസത്തിൻ ശിരസ്ത്രവുമായ്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തേടുക നേടുക നാടുകൾ നീളെ",
        "രക്ഷയിലേക്കിന്നാളുകളെ",
        "വീടുകൾ മേടുകൾ കാടുകൾ കയറി",
        "വേലിക്കരികിലുമുളളവരെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പകലൊളിമാറും നാളുവരുന്നു",
        "ഇരുളുപരത്തും നാളുകളാം",
        "പരമേശന്റെ വാളു ധരിച്ചു",
        "പൊരുതുക മരണത്തോളം നാം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
