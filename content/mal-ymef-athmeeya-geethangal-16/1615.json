{
  "number": 1615,
  "title": "വില്ലനാണേ മഹാവില്ലനാണേ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വില്ലനാണേ മഹാവില്ലനാണേ",
        "സാത്താൻ ലാക്കുനോക്കി",
        "നിന്നെ പാട്ടിലാക്കും",
        "അവൻ ലാക്കുനോക്കി",
        "നിന്നെ പാട്ടിലാക്കും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വാക്കിൽ കുടുങ്ങല്ലേ... ഉം... ഉം...",
        "നോക്കിൽ കുടുങ്ങല്ലേ... ഉം... ഉം...",
        "സാത്താന്റെ കെണിയിൽ",
        "കുടുങ്ങാതിരിക്കുവാൻ",
        "യേശുവേ രക്ഷകനായി വരിക്കണം"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    }
  ],
  "meta": {
    "author": "BT"
  }
}
