{
  "number": 380,
  "title": "എൻ യേശു രക്ഷകൻ എൻ നല്ല ഇടയൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നന്മ മാത്രമേ പൂർണ്ണകൃപയും",
        "യേശുവേ! നിൻആടിനെ",
        "എപ്പോഴും പിൻചെല്ലും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എൻ യേശു രക്ഷകൻ എൻ നല്ല ഇടയൻ",
        "തൻ ആടുകളിൽ ഒന്നിനും ഇല്ലൊരു കുറവും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഞാൻ നാശവഴിയിൽ",
        "തെറ്റിടും നേരത്തിൽ",
        "തൻ സ്വർഗ്ഗഭാഗ്യം വിട്ടു താൻ",
        "എന്നെ അന്വേഷിപ്പാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തൻ ശബ്ദം കേട്ടു ഞാൻ",
        "സന്തോഷത്തോടെ താൻ",
        "തൻ മാർവ്വിൽ എന്നെ അണച്ചു",
        "എൻകണ്ണീർ തുടച്ചു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എൻ പാപമുറിവു",
        "യേശു പൊറുപ്പിച്ചു",
        "തൻ സ്വന്തം രക്തം തന്നവൻ",
        "ഹാ! നല്ല ഇടയൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "പിതാവിൻ ഭവനം ഇപ്പോൾ",
        "എൻ പാർപ്പിടം",
        "സ്വർഗ്ഗീയ ഭക്ഷണംകൊണ്ടു",
        "ഞാൻ തൃപ്തിപ്പെടുന്നു"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഞാൻ സിംഹഗർജ്ജനം",
        "കേട്ടാൽ ഇല്ലിളക്കം",
        "തൻകൈയിൻ കോലും വടിയും",
        "സാത്താനെ ഓടിക്കും"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "എന്നെ വിളിച്ചവൻ",
        "എന്നേക്കും വിശ്വസ്തൻ",
        "താൻ അന്ത്യത്തോളം എന്നെയും",
        "വിടാതെ സൂക്ഷിക്കും"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "തൻ സ്വർഗ്ഗഭാഗ്യവും",
        "മാറാത്ത തേജസ്സും",
        "എൻയേശു തരും എനിക്കും",
        "ഇങ്ങില്ലോർ കുറവും"
      ]
    }
  ],
