{
  "number": 192,
  "title": "നന്ദിയോടെ, നന്ദിയോടെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നന്ദിയോടെ, നന്ദിയോടെ",
        "നാഥാ നിന്നെ നമിക്കുന്നു",
        "നന്ദിയോടെ, നന്ദിയോടെ",
        "നന്മകൾ വാഴ്ത്തിടുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "താഴ്ചയിലെന്നെ നീ ഓർത്തതിനാൽ",
        "താണു നരാകൃതി പൂണ്ടതിനാൽ",
        "നീചനാമെന്നെയും നീ",
        "സൂനുവായ് തീർത്തതിനാൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിത്യത മുഴവനും പാടിയാലും",
        "എത്തിപ്പോകാത്തതാം നന്മകളാൽ",
        "എന്നെ നിറച്ചവൻ നീ",
        "എന്നെ നയിപ്പവൻ നീ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ജീവൻ വെടിഞ്ഞെന്നെ വീണ്ടനാഥാ",
        "ജീവിക്കുന്നിന്നു നീ ഉന്നതത്തിൽ",
        "ജീവിത നാൾകളെല്ലാം",
        "നീ മതിയീ മരുവിൽ"
      ]
    }
  ],
