{
  "number": 1071,
  "title": "യേശുനാഥാ യേശുനാഥാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുനാഥാ യേശുനാഥാ",
        "എന്നു നീ വന്നിടും പ്രാണനാഥാ?",
        "എൻ ക്ലേശഭാരങ്ങൾ",
        "തീർത്തിടുവാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകത്തിൻ മായകൾ",
        "മോഹിച്ചു ഞാൻ",
        "ഓടിയനേരമെൻ ചാരെ വന്നു",
        "കൈപിടിച്ചെന്നെ തൻ",
        "തേജസ്സിൻ മാർഗ്ഗത്തിൽ",
        "ആക്കിയെൻ കർത്താവു ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഈ ലോകത്തിൽ ഞാനൊരന്യനത്രേ",
        "ഈ മരുജീവിതം ക്ലേശമത്രേ",
        "സ്വർഗ്ഗ കനാനെന്റെ സ്വന്തസ്ഥലമത്രേ",
        "സ്വർഗ്ഗീയജീവിതം നിത്യമത്രേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കർത്തൻ വരവിനെ നോക്കി നോക്കി",
        "പാർത്തലേ പാർത്തിടുന്നാശയാൽ ഞാൻ",
        "പ്രത്യാശയാലുളളം തിങ്ങി നിറയുന്നേ",
        "ആമേൻ കർത്താവേ നീ വന്നിടണേ"
      ]
    }
  ],
