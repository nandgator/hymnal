{
  "number": 1357,
  "title": "പ്രഭു മഹാൻ! വിചാരും കാര്യ തേരെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പ്രശംസാ ഹോ - വേ പ്രഭൂ യീശു കീ",
        "കിതനാ മഹാൻ, കിതനാ മഹാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പ്രഭു മഹാൻ! വിചാരും കാര്യ തേരെ",
        "കിത്നേ അത്ഭുത് ജോ തൂനേ ബനായേ",
        "ദേഖൂം താരേ സുനൂം ഗർജന് ഭയങ്കർ",
        "സാമർത്ഥ് തേരി സാരേ ഭൂമണ്ഡല് പർ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വൻ കേ ബീച് മെം തരായി മദ്ധ്യ വിചാരൂം",
        "മധുര് സംഗീത് മേം ചിഡിയോം കാ സുനൂം",
        "പഹാഡ് വിശാല് സേ ജബ് മേം നീൽചേ ദേഖൂം",
        "ഝർനേ ബഹ്തേ ലഗ്തി ശിതള് വായു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മസീഹ് ആവേഗാ ശബ്ദ് തുരഹി കാ ഹോഗാ",
        "മുഛേ ലേഗാ ജഹാം ആനന്ദ് മഹാൻ",
        "മേം ഝുകൂംഗാ സാഥ് ആദർ ഭക്തി ദിനതാ",
        "ഔർ ഗാഊംഗാ പ്രഭു കിത് നാ മഹാൻ"
      ]
    }
  ],
