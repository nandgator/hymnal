{
  "number": 534,
  "title": "എൻദൈവമേ നീയെത്ര",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എൻദൈവമേ നീയെത്ര",
        "നല്ലവനാം! വല്ലഭനാം!",
        "എന്നെ നീ നടത്തിടുന്നു",
        "എൻഭാരം ചുമന്നിടുന്നു",
        "അന്നന്നു നീ വേണ്ടുന്നതെല്ലാം",
        "നൽകി പാലിക്കുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഇദ്ധരയിൽ എല്ലാം പ്രതികൂലമായ്",
        "തീർന്നെന്നാലും",
        "കാർമുകിലേറി വന്നാലും",
        "ഓളങ്ങളാഞ്ഞടിച്ചാലും",
        "കൈവിടല്ലേ എൻപ്രാണനായകനേ!",
        "കാത്തിടണേ -"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മന്നിൽ നിന്നു വിണ്ണിൽ നിൻ",
        "സന്നിധാനം ചേരും വരെ",
        "നിൻ മാർവ്വിൽ ചാരി ഞാനെന്നും",
        "സീയോനിൻ യാത്ര തുടരാൻ",
        "വിശ്വാസത്തിൻ നല്ലപോർ",
        "പൊരുതിടുവാൻ ശക്തി നൽക"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എന്നേശുവേ എന്നു നീ വന്നിടുമോ",
        "ചേർത്തിടുവാൻ",
        "കാലങ്ങൾ ദീർഘമാക്കല്ലേ നിന്നിൽ",
        "ഞാൻ നിത്യം ചേരുവാൻ",
        "സീയോനിൽ ഞാൻ മോദമായ്",
        "വാണിടുവാൻ എന്നുമെന്നും -"
      ]
    }
  ],
