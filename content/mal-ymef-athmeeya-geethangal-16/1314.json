{
  "number": 1314,
  "title": "പറ പറ പറന്നു പോകും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പറ പറ പറന്നു പോകും",
        "ചിത്ര ശലഭമേ കൊച്ചു ശലഭമേ",
        "നിനക്കിത്ര നല്ല അഴകു നല്‍കിയതാര്?",
        "നിന്റെ ചിറകുകളില്‍",
        "ചായം പൂശിയതാര്?"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മുട്ടയായിരുന്ന കാലം മുതല്‍",
        "ദൈവത്തിന്റെ കൈകളില്‍",
        "ഇരുന്നു ഞാന്‍",
        "പുഴുവായ് വെളിയില്‍ വന്നു",
        "ചിറകു മുളച്ചു വന്നു",
        "പറന്നു പറന്നു പാടിടുന്നു ഗീതങ്ങള്‍"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    }
  ],
  "meta": {
    "author": "JoyJ"
  }
}
