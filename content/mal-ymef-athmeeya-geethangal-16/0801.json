{
  "number": 801,
  "title": "ശ്രീയേശുവെന്റെ രക്ഷകൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ക്രൂശിങ്കൽ ക്രൂശിങ്കൽ",
        "സൽപ്രകാശത്തെ ഞാൻ",
        "കണ്ടു എന്റെ ഭാരങ്ങൾ നീങ്ങിപ്പോയ്",
        "കണ്ണിനും കാഴ്ച ലഭിച്ചവിടെ",
        "എന്നും ഞാൻ സന്തോഷിച്ചിടുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ശ്രീയേശുവെന്റെ രക്ഷകൻ",
        "ഈ ദോഷിയാമെന്റെ",
        "കുറ്റങ്ങളെല്ലാം മാച്ചു തൻ",
        "ശുദ്ധരക്തത്തിനാൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യേശു എൻ നല്ല സ്നേഹിതൻ",
        "വാത്സല്യത്തോടെ താൻ",
        "ആശ്വാസം നൽകിടുന്നു എൻ",
        "ക്ലേശങ്ങളിൽ സദാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തന്നാനനം കാണുന്നതു",
        "ആനന്ദമെനിക്കു",
        "തൻ സന്നിധി ഈ ഭൂമിയിൽ",
        "എൻ സ്വർഗ്ഗം സർവ്വദാ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഈ സ്നേഹമുളള രക്ഷകൻ",
        "ഇഷ്ടനാളാമിപ്പോൾ",
        "നിന്നെ വിളിക്കുന്നു ഇതാ",
        "നീയും വന്നിടുക"
      ]
    }
  ],
