{
  "number": 167,
  "title": "ഇവൻ എത്ര മഹാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഇവൻ എത്ര മഹാൻ",
        "ഇവൻ എത്ര മഹാനേശു",
        "എന്നെ തേടി വന്ന സ്നേഹിതനാം",
        "ഇവൻ എത്ര മഹാനേശു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നിത്യജീവനെ തന്ന",
        "സ്നേഹത്തെയോർത്തു",
        "ഞാൻ പാടി പുകഴ്ത്തിടുമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എനിക്കായ് മുറിവേറ്റ",
        "ദൈവകുഞ്ഞാടിനെ",
        "ഓർത്ത് ഞാൻ സ്തുതിച്ചിടുമേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ദൈവത്തിൻ മകനായി",
        "തീർത്തതിനാൽ",
        "ഞാൻ നാഥനെ വാഴ്ത്തിടുമേ"
      ]
    }
  ],
