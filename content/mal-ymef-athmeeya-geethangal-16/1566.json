{
  "number": 1566,
  "title": "കരുതുമാ കരങ്ങൾ കാണുന്നു ഞാൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കരുതുമാ കരങ്ങൾ കാണുന്നു ഞാൻ",
        "കരുണയോടെന്നെ",
        "അണയ്ക്കുമാകരങ്ങൾ",
        "കരുമനനീക്കാൻ കണ്ണുനീർ തുടയ്ക്കാൻ",
        "കരുത്തുറ്റ കരങ്ങൾ",
        "കർത്താവിൻ കരങ്ങൾ",
        "ഒരു നാളും തളരാതിരിക്കുമാ കരങ്ങൾ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നിരന്തരം കീഴെ ശാശ്വതഭുജങ്ങൾ",
        "ശിരസ്സിലോ നിത്യം",
        "അനുഗ്രഹ കരങ്ങൾ",
        "ഇരു പുറം അടച്ചെന്നെ",
        "ഭ്രദമായ് കാത്തും",
        "തിരുഹിതമെന്നിൽ",
        "തികയ്ക്കുമാ കരങ്ങൾ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ധനികരനേകർ ധരയിലുണ്ടെന്നാൽ",
        "ധനമായെന്നേശു മതിയെനിക്കെന്നും",
        "ദരിദ്രനായ് തീർന്നാലും പതറുകയില്ല",
        "പരത്തിലെ നിത്യ തേജസ്സൻ ധനമെല്ലാം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഒരുവരുമെന്നെ കരുതുവാനില്ലീ",
        "മരുവിലെന്നാലും തളരുകയില്ല",
        "അരുമയോടെന്നെന്നും",
        "കരുതുമെൻ നാഥൻ",
        "വരുമതിവേഗം ചേർക്കുവാനെന്നെ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
