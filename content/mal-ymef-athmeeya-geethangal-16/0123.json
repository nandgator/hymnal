{
  "number": 123,
  "title": "പാടും ഞാനേശുവിനു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "പാടും ഞാനേശുവിനു",
        "സ്തുതിപാടും ഞാനേശുവിന്നു",
        "പാടും ഞാൻ ജീവകാലമെന്നും",
        "നാഥന്നു സ്തോത്ര ഗാനം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "പാപിയാമെന്നെത്തേടി",
        "പാരിൽ വന്ന മഹോന്നതനെൻ",
        "പാപം പരിഹരിപ്പാൻ ചോരചിന്തി",
        "മരിച്ചു ക്രൂശിൽ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "നീച മരണം വരിച്ചേറ്റം നീചർ",
        "നടുവിൽ നാഥൻ",
        "നീചനാമെന്നെ ദൈവപൈതലാക്കി",
        "മഹാദയയാൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മൂന്നാം ദിനമുയിർത്തു",
        "എന്റെ മൃത്യുഭയമകറ്റി",
        "നിത്യ ജീവനരുളി നിത്യ -",
        "രാജ്യാവകാശിയാക്കി"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വന്നിടും താൻ മേഘത്തിൽ",
        "തന്റെ കാന്തയെച്ചേർത്തിടുവാൻ",
        "ചേർന്നിടുമന്നു ഞാനും പ്രാണ -",
        "നാഥനോടൊത്തു വാനിൽ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഹല്ലെലുയ്യാ രാജന്നു ആമേൻ",
        "ഹല്ലെലുയ്യാ കർത്തന്നു",
        "ഹല്ലെലുയ്യാ പാടി നാം ഒന്നായാ -",
        "ർത്തു ഘോഷിച്ചിടുക"
      ]
    }
  ],
