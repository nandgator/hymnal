{
  "number": 1120,
  "title": "ഞാൻ ചെയ്ത പാതകം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഞാൻ ചെയ്ത പാതകം",
        "എങ്ങനെ പോം?",
        "പാപനാശകൻ എവിടെയുണ്ട്?",
        "ശ്രീയേശു രക്ഷകൻ പാപികൾക്കായ്",
        "ക്രൂശിൽ പ്രാണനെ വിട്ടില്ലയോ?",
        "കൊടുംപാപിയെന്നെ",
        "രക്ഷിപ്പാൻ രക്ഷിപ്പാൻ",
        "കൊടുംപാപിയെന്നെ",
        "രക്ഷിപ്പാൻ ഹല്ലേലുയ്യാ",
        "തിരുതലയിലവൻ മുൾമുടി ധരിച്ചാൻ",
        "കൊടുംപാപിയെന്നെ രക്ഷിപ്പാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ലോകത്തിൻ പാപികൾ",
        "മോക്ഷം ചേരാൻ അവൻ",
        "കണ്ണീരൊഴുക്കിയല്ലോ!",
        "ദാഹിക്കുന്ന നരർ ജീവ ആറ്റിൽ",
        "ദാഹം തീർപ്പതിന്നായ് വരട്ടെ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപിയാമെന്നുടെ പാപമോർത്തു",
        "മനസ്താപത്തോടെ വന്നപ്പോൾ",
        "കല്ലുളളം നീക്കി തൻ ആത്മാവിനാൽ",
        "തന്നു മാർദ്ദവമാം ഹൃദയം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പാപികളേവർക്കും",
        "രക്ഷനൽകാൻ അവൻ",
        "പ്രാപ്തനാം കർത്തനല്ലോ",
        "പാപമുപേക്ഷിച്ചു കർത്തനിൽ നീ",
        "നമ്പു മോക്ഷം ചേരാം നിനക്കു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഇത്രഭാഗ്യം തന്ന യേശുവിന്നു - പ്രതി",
        "ഞാനെന്തുകൊടുക്കേണ്ടു - എന്റെ",
        "പൂർണ്ണശക്തിയോടെ തൻനാമത്തെ",
        "എന്നും വാഴ്ത്തിപുകഴ്ത്തിടുമേ"
      ]
    }
  ],
