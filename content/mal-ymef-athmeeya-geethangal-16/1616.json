{
  "number": 1616,
  "title": "ഒന്നും ഒന്നും രണ്ട്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഒന്നും ഒന്നും രണ്ട്",
        "കൺകൾ നിനക്ക് രണ്ട്",
        "നൽവഴി ഏത് എന്ന്",
        "കണ്ണുകളാൽ നീ കാണ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "രണ്ടും രണ്ടും നാല്",
        "സുവിശേഷങ്ങൾ നാല്",
        "വായിച്ചിടാം ദിനവും",
        "ദൈവത്തിൻ തിരുവചനം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മൂന്നും മൂന്നും ആറ്",
        "കൽപാത്രങ്ങൾ ആറ്",
        "വെളളം വീഞ്ഞായ് മാറും",
        "യേശുവിൻ അത്ഭുതം കാണ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "നാലും നാലും എട്ട്",
        "രക്ഷപ്പെട്ടവർ എട്ട്",
        "നരകത്തീയിൽ നിന്നും",
        "നീയും രക്ഷ നേട്"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "അഞ്ചും അഞ്ചും പത്ത്",
        "കല്പനകൾ പത്ത്",
        "അനുസരിക്കാം മന്നിൽ",
        "ദൈവകല്പന ദിനവും"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
