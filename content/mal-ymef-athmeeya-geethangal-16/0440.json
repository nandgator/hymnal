{
  "number": 440,
  "title": "സംജീവകമാം തിരുവചനം",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സംജീവകമാം തിരുവചനം",
        "സന്തോഷസമേതം പ്രതിദിനമെൻ",
        "ജീവിത പരമസുഖാർത്ഥമ",
        "ചഞ്ചലനായ് ഹൃദി സംഗ്രഹിക്കും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പഞ്ചാമൃതസന്നിഭമതു മമ",
        "നെഞ്ചിന്നരുളും സംതൃപ്തിയെ",
        "സംജാത സുമോദമന്വിതമെന്നധരം",
        "സ്തുതിചെയ്യുമേശുവെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പുന്തേൻ ഭ്രമരങ്ങളതീവ ശ്രമം",
        "ചെയ്താർജ്ജിപ്പതുപോൽ മമ",
        "സന്ദേഹമൊഴിഞ്ഞനിശം",
        "വചനത്തിൻ മധുരസമാസ്വദിക്കും"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ഇന്നാൾവരെയും പൊരുതവയൊടു",
        "നന്നായ് മന്നവർ നാസ്തികരും",
        "എന്നാൽ നിസ്തുലമഹിമയൊടവയിന്നും",
        "വിജയിച്ചിടുന്നു"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ദൈനംദിനമിവയുടെ സത്യത",
        "ജനസമ്മതമായി വരുന്നു",
        "നൂനം പല നൂതന തെളിവുകളൂനമൊഴി -",
        "ഞ്ഞുളവായിടുന്നു"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
