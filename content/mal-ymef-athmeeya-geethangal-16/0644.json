{
  "number": 644,
  "title": "ക്രൂശുമെടുത്തു ഞാൻ യേശു രക്ഷകനെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ക്രൂശുമെടുത്തു ഞാൻ യേശു രക്ഷകനെ",
        "ക്ലേശങ്ങൾ വന്നാലും പിൻചെല്ലുമേ",
        "എൻ ക്രൂശുമെടുത്തു ഞാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദുഃഖത്തിൻ താഴ്‌വരയിൽ",
        "കഷ്ടത്തിൻ കാരിരുളിൽ",
        "തൃക്കൈകളാൽ താങ്ങി",
        "കർത്താവുതാൻ കാത്തു",
        "എക്കാലവുമെന്നെ നടത്തുമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഉളളം കലങ്ങിടിലും ഉറ്റവർ മാറിടിലും",
        "വേണ്ടാ വിഷാദങ്ങൾ",
        "യേശുവിൻ മാറിടം",
        "ഉണ്ടെനിക്കു ചാരി വിശ്രമിപ്പാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ ജീവവഴികളിൽ",
        "ആപത്തു നാളുകളിൽ",
        "എന്നെ കരുതുവാൻ",
        "എന്നെന്നും കാക്കുവാൻ",
        "എൻ യേശു രക്ഷകൻ മതിയല്ലോ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ലോകം വെറുത്താലുമെൻ",
        "ദേഹം ക്ഷയിച്ചാലുമേ",
        "മൃത്യുവിൻ നാൾവരെ",
        "ക്രിസ്തുവിൻ ദീപമായ്",
        "ഇദ്ധരയിൽ കത്തി തീർന്നെങ്കിൽ ഞാൻ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കർത്താവിൻ സന്നിധിയിൽ എത്തും",
        "പ്രഭാതത്തിൽ ഞാൻ",
        "കണ്ണീരെല്ലാമന്നു പൂർണ്ണമായ് തീർന്നെന്നും",
        "നിത്യതയിൽ ക്രിസ്തൻ കൂടെ വാഴും"
      ]
    }
  ],
