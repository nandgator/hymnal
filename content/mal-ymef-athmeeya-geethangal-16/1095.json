{
  "number": 1095,
  "title": "വേലയ്ക്കു വേലയ്ക്കു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യത്നിക്ക, യത്നിക്ക, തേടുക, നേടുക",
        "ആശിക്ക, പ്രാർത്ഥിക്ക",
        "കർത്താവു വരും വേഗത്തിൽ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "ദൈവദാസന്മാർ നാം",
        "ക്രിസ്തൻ കാണിച്ച പാത",
        "നാം പിൻചെല്ലണം",
        "ഇങ്ങു വാഴാൻ അല്ല",
        "ശുശ്രൂഷ ചെയ്‌വാൻ",
        "ഇഹത്തിൽ പിറന്നു",
        "സ്വർഗ്ഗരാജാവു താൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "ചുറ്റും നോക്കുക നാം",
        "എങ്ങും വാഴും അസത്യത്തെ",
        "പോക്കുക നാം",
        "സർവ്വസൃഷ്ടിയും യേശുവെ",
        "കാണും വരെ",
        "ഉയർത്തിടുക നാം സത്യമാം കൊടിയെ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "ദൈവദ്രോഹങ്ങളും",
        "വ്യാജമാർഗ്ഗങ്ങൾ നാശത്തിൻ മോഹങ്ങളും",
        "ദൈവഭൂമിയിൽ വർദ്ധിക്കു -",
        "ന്നോർ സമയേ",
        "സ്വസ്ഥത യോഗ്യമോ",
        "ക്രിസ്തൻ ദാസന്മാരേ!"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "ഇന്നു രക്ഷയിൻ നാൾ",
        "എങ്കിലും നിത്യവും പാപശിക്ഷകളാൽ",
        "ആയിരം ആയിരം നശിച്ചിടുന്നിതാ",
        "രക്ഷിപ്പാൻ രക്ഷിപ്പാൻ",
        "എൻ സഹോദരാ! വാ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "ഓരോ കഷ്ടങ്ങളും പരിഹാസങ്ങൾ",
        "ഹിംസകൾ നഷ്ടങ്ങളും",
        "സഹിച്ചും വഹിച്ചും",
        "കൊണ്ടദ്ധ്വാനിക്ക നാം",
        "എന്നാൽ ക്രിസ്തുവിൻ",
        "സത്യസേവകരാം"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "വേലയ്ക്കു വേലയ്ക്കു",
        "പിന്നെ സ്വസ്ഥതയും",
        "കർത്തൻ ദാസരാം നാം",
        "നിത്യം ആസ്വദിക്കും",
        "എൻ സന്തോഷത്തിലേക്കു",
        "പ്രവേശിക്കുക",
        "എന്നു താൻ അരുളിച്ചെയ്യും",
        "ഹല്ലേലുയ്യാ"
      ]
    }
  ],
