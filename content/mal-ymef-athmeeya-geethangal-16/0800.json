{
  "number": 800,
  "title": "എത്ര നല്ല മിത്രമെനിക്കേശു",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എത്ര നല്ല മിത്രമെനിക്കേശു",
        "ഭാരമത്രയും വഹിപ്പതിന്നു",
        "പ്രാപ്തൻ എന്നെ -",
        "യെത്രയും സ്നേഹിച്ചു ശാപ",
        "മൃത്യുവെൻ പേർക്കായ് സഹിച്ച",
        "മിത്രം - ആത്മമിത്രം!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "എത്രയോ സന്തോഷം തൻ തൃപ്പാദം",
        "തത്ര അത്രയും തീരുന്നു",
        "മത്സന്താപം - ഉളളിൽ",
        "എത്രയും കൗതുകം നൽകിടുന്ന",
        "തൻ തിരുവചനം ഓർത്താൽ അതിചിത്രം!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഭക്തരുടെ യോഗമെനിക്കിമ്പം അതു",
        "ശക്തിയേറും ദൈവത്തിൻ കുടുംബം",
        "അതിൽ കർത്തൃമേശയോടണയും നേര -",
        "മുളളിൽ നിന്നൊഴിഞ്ഞു",
        "പോകും സർവ്വ തുമ്പം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സങ്കടത്താൽ ക്ഷീണിച്ചു",
        "ഞരങ്ങിടുമ്പോൾ",
        "തൻകരങ്ങൾ മൂലമെന്നെ താങ്ങി",
        "തന്റെ വൻ കൃപകളോരോന്നെന്നെ",
        "കാണിക്കും നേരമുളളിൽ",
        "സന്തോഷം തിങ്ങിടുന്നു"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
