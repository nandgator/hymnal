{
  "number": 765,
  "title": "എന്തെല്ലാം വന്നാലും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്തെല്ലാം വന്നാലും",
        "കർത്താവിൻ പിന്നാലെ",
        "സന്തോഷമായി ഞാൻ യാത്ര ചെയ്യും"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "മിസ്രയീം വിട്ടതിൽ",
        "ഖേദിപ്പാനില്ലൊന്നും",
        "ആശ്വാസദേശമെൻ മുന്നിലുണ്ട്"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കൈകൊണ്ടുതീർക്കാത്ത",
        "വീടുകൾ മേടകൾ",
        "ഒക്കെയും വാഗ്ദത്ത നാട്ടിലുണ്ട്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "അബ്രഹാമിൻ യാത്രയിൽ",
        "കൂടെയിരുന്നവൻ",
        "അവകാശം നൽകിയോൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "ഹാരാനിൽ യാക്കോബിൻ",
        "കൂടെയിരുന്നവൻ",
        "വാഗ്ദത്തം നൽകിയോൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "മിസ്രയീം ദേശത്തിൽ",
        "യൗസേപ്പിൻ കണ്ണുനീർ",
        "കണ്ടവൻ എന്നോടു കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "മിദ്യാനിൽ മോശയ്ക്കു",
        "സങ്കേതമായവൻ",
        "ഹോരേബിൽ നിന്നവൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ചെങ്കടൽതീരത്തു",
        "മോശയിൻ കണ്ണുനീർ",
        "കണ്ടവനെന്നോടു കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "ആറുനൂറായിരം",
        "ആയൊരു കൂട്ടത്തെ",
        "ചിറകിൽ വഹിച്ചവൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "സ്വർഗ്ഗീയ മന്നായെക്കൊണ്ടു",
        "തൻ ദാസരെ",
        "പോറ്റിപ്പുലർത്തിയോൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s11",
      "kind": "stanza",
      "label": "11",
      "lines": [
        "പാറയിൽ നിന്നുളള",
        "ശുദ്ധജലം കൊണ്ടു",
        "ദാഹം ശമിപ്പിച്ചോൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s12",
      "kind": "stanza",
      "label": "12",
      "lines": [
        "യെരിഹോ മതിലുകൾ തട്ടിതകർത്തവൻ",
        "ചെങ്കടൽ വറ്റിച്ചോൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s13",
      "kind": "stanza",
      "label": "13",
      "lines": [
        "ബാലിന്റെ സേവക -",
        "ന്മാരെ നശിപ്പിച്ച",
        "ഏലിയാവിൻ ദൈവമെൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s14",
      "kind": "stanza",
      "label": "14",
      "lines": [
        "കാക്കയെക്കൊണ്ടു",
        "തൻ ദാസനെ പോറ്റുവാൻ",
        "ശക്തനായ് തീർന്നവൻ കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s15",
      "kind": "stanza",
      "label": "15",
      "lines": [
        "എന്നെ വിളിച്ചവൻ",
        "എന്നെ രക്ഷിച്ചവൻ",
        "എന്നാളും എന്നോടു കൂടെയുണ്ട്"
      ]
    },
    {
      "id": "s16",
      "kind": "stanza",
      "label": "16",
      "lines": [
        "ഒരു നാളും എന്നെ",
        "ഉപേക്ഷിക്കയില്ലെന്നു",
        "പരമാർത്ഥമായവൻ ചൊല്ലീട്ടുണ്ട്"
      ]
    },
    {
      "id": "s17",
      "kind": "stanza",
      "label": "17",
      "lines": [
        "ആകാശം ഭൂമിയും",
        "ആകെ ഒഴിഞ്ഞാലും",
        "ആയവൻ വാക്കിനു ഭേദമില്ല"
      ]
    }
  ],
