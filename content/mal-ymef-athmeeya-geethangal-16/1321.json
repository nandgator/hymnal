{
  "number": 1321,
  "title": "ബാലകരെ ബാലകരെ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ബാലകരെ ബാലകരെ",
        "പാട്ടുപാടുവിന്‍",
        "പാലകനാമേശുവിനെ",
        "വാഴ്ത്തി പാടുവിന്‍"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്നേഹമുള്ള യേശു",
        "നമ്മെ തേടി വന്നല്ലോ",
        "ക്രൂശിലേറി ജീവന്‍ തന്നു",
        "വീണ്ടെടുതല്ലോ",
        "നല്ല സ്നേഹിതന്‍ താന്‍",
        "ഇല്ല ഇതുപോലെ",
        "വേറെ മന്നിലാരുമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ബാലസിംഹം പട്ടിനിയാല്‍",
        "വിശന്നിരിക്കിലും",
        "ബാലകര്‍ നാം സന്തോഷത്താല്‍",
        "പാട്ടു പാടിടും",
        "നല്ല പാലകന്‍ താന്‍ തെല്ലും ഭീതിയെന്യെ -",
        "എല്ലാനാളും നല്ലപോലെ",
        "കാത്തു പാലിക്കും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ശത്രുവായ സാത്താന്‍",
        "നമ്മെ ചുറ്റി വന്നാലും",
        "കര്‍ത്താവായ യേശു",
        "നമ്മള്‍ക്കുണ്ട് മിത്രമായ്‌",
        "ശത്രുനാണത്തോടെ തോറ്റ് മണ്ടിമാറും",
        "സ്തോത്രഗീതം പാടി",
        "നാമ്മളാര്‍ത്തു തുള്ളിടും"
      ]
    }
  ],
