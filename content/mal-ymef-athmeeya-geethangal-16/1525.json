{
  "number": 1525,
  "title": "സർവ്വശക്തനാണല്ലോ എന്റെ ദൈവം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സർവ്വശക്തനാണല്ലോ എന്റെ ദൈവം",
        "ഇല്ലില്ലസാദ്ധ്യമായൊന്നുമില്ല",
        "അഖിലാണ്ഡത്തെ നിർമ്മിച്ചവൻ",
        "എൻ പിതാവല്ലോ എന്താനന്ദം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "റാഫാ യഹോവ എന്നെ സൗഖ്യമാക്കും",
        "ശമ്മാ യഹോവ എങ്ങും അവനുണ്ട്",
        "ഈ ദൈവം എന്റെ ദൈവം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ശാലോം യഹോവ എന്റെ സമാധാനം",
        "നിസ്സി യഹോവ എന്റെ ജയക്കൊടിയായ്",
        "ഈ ദൈവം എന്റെ ദൈവം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "രോഹി യഹോവ എന്റെ നല്ല ഇടയൻ",
        "യിരേ യഹോവ എനിക്കായ് കരുതുന്നു",
        "ഈ ദൈവം എന്റെ ദൈവം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "മക്കെദേശ് യഹോവ എന്നെ ശുദ്ധനാക്കും",
        "സിക്കെനോ യഹോവ എന്റെ നീതിയായവൻ",
        "ഈ ദൈവം എന്റെ ദൈവം"
      ]
    }
  ],
