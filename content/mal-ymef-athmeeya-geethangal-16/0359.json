{
  "number": 359,
  "title": "1.യേശു മഹേശാ, നിൻ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "1.യേശു മഹേശാ, നിൻ",
        "സന്നിധിയിൽ ഞങ്ങൾ",
        "ആശയോടെ ഇതാ വന്നിടുന്നേ - ദയ",
        "ലേശമുദിക്കുവാൻ കൈ തൊഴുന്നേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ക്ഷീണരായുളേളാരി ഞങ്ങൾ",
        "തന്നുളളത്തിൻ",
        "ദീനതയത്രയും തീർത്തിടണേ - എല്ലാ",
        "ന്യൂനതയും നീക്കി കാത്തിടണേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കൂരിരുൾ ശുദ്ധ വെളിച്ചമായ് മാറ്റുന്ന",
        "വേറൊരു ശക്തിമാൻ ഭൂവിലുണ്ടോ ഇത്ര",
        "കൂറുളള നായകൻ വാനിലുണ്ടോ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തീയിനെപ്പോലും തണുപ്പിക്കും തൃക്കരം",
        "ഈയടിയാർ മേൽ നീ വയ്ക്കണമേ നിന്റെ",
        "കായപ്രദർശനം നൽകേണമേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "നിൻമൊഴി കേൾപ്പാൻ",
        "കൊതിക്കുന്നു കർണ്ണങ്ങൾ",
        "നന്മയെനിക്കതാലുണ്ടായ് വരും - സർവ്വ",
        "തിന്മയും നീങ്ങി സുഖമുയരും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "വന്നിടണേ യേശു മന്നവനേ, ഞങ്ങൾ",
        "നന്നായുണർന്നു തെളിഞ്ഞിടുവാൻ സഭ -",
        "യൊന്നായി വാനിലുയർന്നിടുവാൻ"
      ]
    }
  ],
