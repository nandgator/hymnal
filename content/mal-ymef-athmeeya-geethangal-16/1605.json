{
  "number": 1605,
  "title": "ഞാനും എനിക്കുള്ളതെല്ലാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഏകുന്നു ഏകുന്നു",
        "അവനായി ഞാനെല്ലാം",
        "നൽകുന്നു നൽകുന്നു",
        "എന്നെ തന്നെ ഞാൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഞാനും എനിക്കുള്ളതെല്ലാം",
        "യേശുവിൻെറ സ്വന്തമത്രേ",
        "സ്വന്തമായതൊന്നും ഇല്ലാ",
        "എല്ലാം നാഥൻ തന്നതല്ലോ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഞാനും എനിക്കുള്ളാരെല്ലാം",
        "യഹോവയെ സേവിക്കുമേ",
        "ഇന്നും എന്നും എന്നെന്നേക്കും",
        "ജീവനുള്ള കാലമെല്ലാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഞാൻ സ്തുതിക്കും കർത്താവിനെ",
        "അന്ത്യംവരെ സേവിക്കുമേ",
        "ലാഭം ആയി തീർന്നതെല്ലാം",
        "ചേതം എന്ന് എണ്ണിടുന്നു ഞാൻ"
      ]
    }
  ],
