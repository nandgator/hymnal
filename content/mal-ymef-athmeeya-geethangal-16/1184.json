{
  "number": 1184,
  "title": "വാവാ യേശുവിങ്കൽ വാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വാവാ യേശുവിങ്കൽ വാ",
        "കേൾ കേൾ സ്നേഹസന്ദേശം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അദ്ധ്വാനിക്കുന്നവരേ",
        "ഭാരം ചുമക്കുന്നവരേ",
        "ആശ്വാസം കൈക്കൊളളുവാൻ",
        "യേശു വിളിച്ചിടുന്നു"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "പാപത്തിൻ ചുമടുമായി",
        "മോക്ഷം തിരയുവോരെ",
        "മോക്ഷത്തിൻ മാർഗ്ഗമവൻ",
        "യേശു വിളിച്ചിടുന്നു"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "നരകമില്ലെന്നു ചൊല്ലി",
        "നരകം പൂകല്ലേ സഖേ",
        "അറിവില്ലാ കാലങ്ങളെ ദൈവം",
        "അറിയുന്നു വരിക സഖേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കുരിശിൽ നരബലിയായ്",
        "നരനേ നിന്നെക്കരുതി",
        "അറിയാതെ പോയിടെല്ലെ",
        "അണയൂ നീ യേശുവിങ്കൽ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "സംശയം വേണ്ടതെല്ലും",
        "നിശ്ചയം രക്ഷകൻ താൻ",
        "ആശയവനിൽ വെച്ചാൽ",
        "ആശ്വാസം ലഭ്യമാകും"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഇത്ര വലിയ രക്ഷ ഗണ്യ -",
        "മാക്കാതെ പോയാൽ",
        "തെറ്റി ഒഴിയാവതോ",
        "നിത്യനരകമത്"
      ]
    }
  ],
