{
  "number": 1610,
  "title": "യേശു വിളിക്കുന്നു - യേശു വിളിക്കുന്നു",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു വിളിക്കുന്നു - യേശു വിളിക്കുന്നു",
        "സ്നേഹമോടെ തൻ കരങ്ങൾ നീട്ടി",
        "യേശു വിളിക്കുന്നു - യേശു വിളിക്കുന്നു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ആകുലവേളകളിൽ",
        "ആശ്വാസം നൽകിടും താൻ",
        "എന്നറിഞ്ഞു നീയും",
        "യേശുവെ നോക്കിയാൽ",
        "എണ്ണമില്ലാ നന്മ നൽകിടും താൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കണ്ണീരെല്ലാം തുടയ്ക്കും",
        "കണ്മണിപോലെ കാക്കും",
        "കാർമേഘം പോലെ",
        "കഷ്ടങ്ങൾ വന്നാലും",
        "കനിവോടെ നിന്നെ കാത്തിടും താൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "മനക്ലേശം നേരിടുമ്പോൾ",
        "ബലം നിനക്കു നൽകും",
        "അവൻ നിൻ വെളിച്ചവും",
        "രക്ഷയുമാകയാൽ",
        "താമസമെന്യേ നീ വന്നിടുക"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "സകലവ്യാധിയേയും",
        "ഗുണമാക്കും വല്ലഭൻ താൻ",
        "ആരായിരുന്നാലും ഭേദങ്ങൾ എന്നിയേ",
        "കൃപയാലേ തന്നെ കാത്തിടും താൻ"
      ]
    }
  ],
