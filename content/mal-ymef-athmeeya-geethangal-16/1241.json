{
  "number": 1241,
  "title": "യേശുവിൽ സ്നേഹമുളള",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശുവിൽ സ്നേഹമുളള",
        "സോദരരേ വരുവിൻ",
        "കാണുവിൻ ദേവജാതൻ",
        "യോർദ്ദാൻ നദീജലത്തിൽ",
        "നിമജ്ജനം കഴിപ്പാൻ",
        "വന്ന ചരിതമോർത്തിടുവിൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "സ്നാപകയോഹന്നാനാൽ",
        "സ്നാനം പ്രതിഗ്രഹിപ്പാൻ",
        "ഗാലീല്യനാട്ടിൽ നിന്നു",
        "ദൂരത്തു വന്നു നാഥൻ",
        "നമുക്കു മാതൃകയാം തന്നെ",
        "തുടർന്നു പോകുക നാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തന്നെത്തടയുന്നിതാ സ്നാപകൻ",
        "താഴ്മയോടെ",
        "നിന്നാലടിയൻ സ്നാനമേൽ -",
        "ക്കേണ്ടതായിരിക്കെ",
        "അരുമനാഥനെ",
        "നീയെന്നരികിൽ വന്നിടുന്നോ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "യേശു പറഞ്ഞുടനെ",
        "ദൈവികനീതികൾക്കു",
        "സാഫല്യമേകിടുവാൻ",
        "ഞാനിങ്ങു വന്നിരിപ്പൂ",
        "മറുത്തുചൊന്നിടാതെ",
        "സ്നാനം കഴിക്ക സമ്മതമായ്"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "യോഹന്നാനീവചന",
        "മംഗീകരിച്ചതിനാൽ",
        "യേശു മുഴുകിയിതാ",
        "കയറി യേശുനാഥൻ",
        "ദിവ്യമഹിമ പൂണ്ടവനായ്"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "വെളളിക്കു തോൽവി നൽകും",
        "വെളളത്തിരയ്ക്കടിയിൽ",
        "കൊളളിച്ചു മുൻകഴിഞ്ഞ",
        "കൊല്ലങ്ങളാകെയവൻ",
        "പുതിയവേല ചെയ്‌വാൻ",
        "താതനരുളി തന്നെയവൻ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "ഒന്നാം മനുഷ്യനു നാം",
        "എന്നേക്കുമായ് മരിച്ചു",
        "വെന്നുളള സത്യമഹോ",
        "കാട്ടുന്നു കർമ്മമിതു",
        "പുതിയജീവനത്രേ മേലാൽ ഭരണം",
        "ചെയ്‌വു നമ്മെ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "തന്നോടുകൂടി നാമും",
        "ഒന്നായ് മരിച്ചുയിർപ്പാൻ",
        "ഒന്നാം മനുഷ്യനെ നാം",
        "യോസേഫിൻ കല്ലറയിൽ",
        "പിടിച്ചു സംസ്കരിപ്പിൻ സ്നാന -",
        "ജലത്തിലാണിടുവിൻ"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "ഭൂമിയിൽ മൂവരല്ലോ സാക്ഷ്യം",
        "പറവതോർത്താൽ",
        "ആത്മാവു വെളളമതും",
        "പിന്നീടു ശോണിതവും",
        "ഇവയിൽ വെളളമത്രെ",
        "സാക്ഷ്യം വഹിപ്പതിസ്സമയെ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "ജീർണ്ണമാം നാശജഡം",
        "ഭൗമിക കല്ലറയിൽ",
        "സംസ്കാരം ചെയ്തു നമ്മൾ",
        "ധൂളിയായ്ത്തീർന്നിടുകിൽ",
        "ഉയിർപ്പിൻകഞ്ചുകത്തെ നമ്മൾ",
        "ധരിക്കുമന്ത്യനാളിൽ"
      ]
    }
  ],
