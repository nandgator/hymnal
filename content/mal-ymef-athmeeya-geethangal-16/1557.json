{
  "number": 1557,
  "title": "ദൈവം ചെയ്ത നന്മകൾ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവം ചെയ്ത നന്മകൾ",
        "ഓർത്താൽ എത അത്ഭുതം",
        "എൻ നാവാൽ വർണ്ണ്യമല്ലത്",
        "പാടുമെൻ ജീവനാളെല്ലാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഭാരങ്ങളാൻ ജീവിതം",
        "ഈ പാരിൽ വൻ ഭീതിയാകുമ്പോൾ",
        "എൻ ഭാരങ്ങൾ തോളിലേറ്റവൻ",
        "യേശു മാത്രമെൻ രക്ഷകനവൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "സ്വന്ത സോദരർ ബന്ധു മിത്രങ്ങൾ",
        "ശത്രുവായിടും പാരിൽ പോരിനായ്",
        "കൂട്ടു സ്നേഹിതൻ യേശുവുളളതാൽ",
        "ക്ലേശമില്ലിനി ലേശമെന്നിലായ്"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
    {
      "partId": "s3"
    }
  ],
