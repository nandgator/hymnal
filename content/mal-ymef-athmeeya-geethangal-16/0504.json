{
  "number": 504,
  "title": "ഈ പാരിൽ നാം പരദേശികളാം",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഈ പാരിൽ നാം പരദേശികളാം",
        "നമ്മുടെ പൗരത്വമോ സ്വർഗ്ഗത്തിലാം",
        "നമ്മൾ സൗഭാഗ്യവാന്മാർ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മൺമയമാമീയുലകത്തിൽ",
        "മാനവൻ നേടും മഹിമകളോ",
        "മാഞ്ഞിടുന്നെന്നാൽ മരിച്ചുയിർത്ത",
        "മന്നവനെന്നും മഹാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദേശമെങ്ങും പോയിനി നമ്മൾ",
        "യേശുവിൻ നാമം ഉയർത്തിടുക",
        "കുരിശിൽ മരിച്ചു ജയം വരിച്ച",
        "ക്രിസ്തുവിൻ സേനകൾ നാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അവനിയിൽ നാമവനായിട്ടിന്നു",
        "അപമാനമേൽക്കിൽ അഭിമാനമാം",
        "ക്രിസ്തുവിലെന്നും നമുക്കു",
        "ജയം ജയം ജയം ഹല്ലേലുയ്യാ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തന്നരികിൽ വിൺപുരിയിൽ",
        "നാം ചെന്നിടുമന്നു പ്രതിഫലം താൻ",
        "തന്നിടുമൊന്നും മറന്നിടാതെ",
        "ആ നല്ല നാൾ വരുന്നു"
      ]
    }
  ],
