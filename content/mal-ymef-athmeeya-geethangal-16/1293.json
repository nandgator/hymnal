{
  "number": 1293,
  "title": "കൊച്ചു കൊച്ചു ജീവവണ്ടി",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കൊച്ചു കൊച്ചു ജീവവണ്ടി",
        "ദൈവം നിർമിച്ച ജീവവണ്ടി",
        "അത്ഭുതമാകുന്ന ജീവവണ്ടി",
        "കൈകളാൽ തീർക്കാത്ത ജീവവണ്ടി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ആശ്ചര്യമേറുമീ ജീവവണ്ടി",
        "പാദങ്ങൾ രണ്ടുകൊണ്ടോടുന്നു",
        "യേശു ഡ്രൈവർ ഇല്ലെങ്കിൽ",
        "വണ്ടിയുടനെ മറിഞ്ഞുപോം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "റെയിൽവേ സ്റ്റേഷൻ രണ്ടു മാത്രം",
        "സ്വർഗ്ഗം പിന്നെ നരകവും",
        "സ്വർഗ്ഗേ പോകാനുള്ള മാർഗ്ഗം",
        "ബൈബിൾ വ്യക്തമാക്കുന്നു"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "മരണദൂതൻ വന്നിടുമ്പോൾ",
        "ലോകയാത്ര തീരുന്നു",
        "വണ്ടി സ്വർഗ്ഗത്തെത്തുമ്പോൾ",
        "പരമഭാഗ്യം ലഭിക്കുന്നു"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
