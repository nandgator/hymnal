{
  "number": 980,
  "title": "വരുമേശു വാനിലന്നാൾ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "വരുമേശു വാനിലന്നാൾ",
        "അവനോടു ചേർന്നിടും നാം",
        "പിരിയാതെയെന്നും വാഴും",
        "അതിമോദമോടെ നമ്മൾ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "നാമിന്നു അന്യരായി",
        "പാർക്കുന്നു പാരിലെന്നാൽ",
        "നമുക്കായൊരുക്കീടുന്നു",
        "അതിരമ്യമായ ഗേഹം",
        "അതിലേശുവോടുകൂടെ",
        "അനവദ്യധന്യരായി"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "കർത്താവിലിന്നു നമ്മൾ",
        "ചെയ്യുന്ന വേലകൾക്കായ്",
        "നൽകും പ്രതിഫലങ്ങൾ",
        "ദൂതഗണസദസ്സിൽ",
        "തീരാ വിനകൾ തീർന്നു",
        "ഉല്ലാസരായി വിണ്ണിൽ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അഴിയുമീമർത്യദേഹം ആ",
        "ദിവ്യകാന്തിയാലെ",
        "അഴകുളളതായി മാറും",
        "അവനോടു തുല്യമായി",
        "തേജസ്സാലന്നു നിത്യ",
        "അവകാശ ഭാഗ്യനാട്ടിൽ",
        "അതിമോദത്തോടെ നമ്മൾ"
      ]
    }
  ],
