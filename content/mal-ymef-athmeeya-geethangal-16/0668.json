{
  "number": 668,
  "title": "എണ്ണി എണ്ണി സ്തുതിച്ചിടും ഞാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എണ്ണി എണ്ണി സ്തുതിച്ചിടും ഞാൻ",
        "നിന്റെ നന്മകളോർത്തുകൊണ്ട്",
        "നിന്റെ പ്രവൃത്തികൾ അത്ഭുതമേ",
        "നിൻക്രിയകൾ അവർണ്ണ്യമഹോ..."
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ദൈവം എന്നിൽ എന്തു കണ്ടു",
        "എന്നെ തൻ മകനാക്കിടുവാൻ",
        "പാപിയായ എന്നെയുമോർത്ത്",
        "കാൽവറിയിൽ യാഗമായ്"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഈ ലോകജീവിത യാത്രയതിൽ",
        "ശക്തമാം തിരമാല വന്നിടിലും",
        "ശാന്തമാക്കാൻ ശക്തനാം ദൈവം",
        "എന്നുമെന്റെ കൂടെയുണ്ട് -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കർത്താവു താൻ വേഗം വന്നിടുമേ",
        "നമ്മെ തൻസവിധേ ചേർത്തിടുവാൻ",
        "നിത്യസന്തോഷം ഭക്തർക്കു നൽകി",
        "നിത്യവും തന്നരികിൽ വസിച്ചിടുവാൻ"
      ]
    }
  ],
