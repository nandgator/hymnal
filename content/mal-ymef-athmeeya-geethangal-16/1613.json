{
  "number": 1613,
  "title": "ആശിഷം ചൊരിയുക നാഥാ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആശിഷം ചൊരിയുക നാഥാ",
        "ഇന്നീ വധുവരരിൽ",
        "മുപ്പിരിച്ചരടുപോൽ ഏകമായിത്തീർന്ന",
        "ഈ ദമ്പതികളെ അനുഗ്രഹിക്ക"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "രണ്ടായ് ഒഴുകിയ ജീവിത നദികൾ",
        "ഒന്നിച്ചുചേർന്നൊഴികിടുവാൻ",
        "അബ്രഹാം സാറയെപ്പോലേക",
        "കുടുംബമായ്",
        "സ്നേഹത്തിനുറവ തുറന്നിടുവാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "അനുകൂല പ്രതികൂല വേളകളിൽ",
        "ഒന്നിച്ചു പങ്കുചേരുവാൻ",
        "കുരിരുൾ തിങ്ങുമീ നീചമാം",
        "ലോകത്തിൽ",
        "ജ്യോതിസ്സുപോലെ വിളങ്ങിടുവാൻ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ക്രിസ്തുവും സഭയും പോലെയിവർ",
        "ഒന്നിച്ചു ചേർന്ന് ഏകദേഹമാകുവാൻ",
        "ഒരിക്കലും കുറയാത്ത ദിവ്യമാം",
        "സ്നേഹത്തിൽ ജീവിതകാലം",
        "വസിച്ചിടുവാൻ"
      ]
    }
  ],
