{
  "number": 320,
  "title": "എത്രയോ ശ്രേഷ്ഠനായവൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "എത്രയോ ശ്രേഷ്ഠനായവൻ",
        "ക്രിസ്തുതാനെന്നുറച്ചു പാടുവിൻ",
        "നിത്യനാശം നീക്കി ഭാഗ്യം",
        "മർത്യനേകുവാൻ കഴിഞ്ഞ ശക്തനാമവൻ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ശ്രേഷ്ഠരാം മനുജരൊക്കെ",
        "മണ്മറഞ്ഞുപോം",
        "മൃത്യുവെ ജയിച്ചുയിർ",
        "ത്തതേശുമാത്രമാം",
        "നിത്യരാജൻ നിസ്തുലാഭൻ",
        "ക്രിസ്തുനാഥനെത്രയെത്ര",
        "ശ്രേഷ്ഠനാം മഹാൻ!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഏകനായ് അതിശയങ്ങൾ",
        "ചെയ്തിടുന്നവൻ",
        "ഏവനും വണങ്ങിടേണം",
        "തന്റെ പാദത്തിൽ",
        "ഏതു നാവും ഏറ്റുചൊല്ലും",
        "യേശുക്രിസ്തു കർ",
        "ത്തനെന്നു ദൈവമഹിമയ്ക്കായ് -"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "തുല്യമായ് ഇല്ല",
        "മറ്റുനാമമൊന്നുമേ",
        "തെല്ലുമേയലസരായിടാതെ തൻ ജനം",
        "നല്ല നാമം ക്രിസ്തു നാമം",
        "ചൊല്ലണം തൻ വല്ലഭത്വം",
        "ഭൂവിലറിയട്ടെ -"
      ]
    }
  ],
