{
  "number": 299,
  "title": "യേശുവെ മാത്രം സ്നേഹിക്കും ഞാൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "യേശു എൻ ജീവൻ എൻ രക്ഷയും",
        "യേശു എൻ നിത്യ നിക്ഷേപവും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശുവെ മാത്രം സ്നേഹിക്കും ഞാൻ",
        "യേശുവെ നോക്കി ജീവിക്കും ഞാൻ",
        "യേശുവിൻ നാമം കീർത്തിക്കും ഞാൻ",
        "യേശുവിനായി പാടിടും ഞാൻ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "യേശു ഈയെന്നെ സ്നേഹിച്ചല്ലോ",
        "ക്രൂശിൽ സ്വ ജീവൻ വെച്ചുവല്ലോ!",
        "നാശ മൺപാത്രമാമെനിക്കു",
        "ശാശ്വതഭാഗ്യം തന്നുവല്ലോ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലോകസൗഭാഗ്യം തേടിയിനി",
        "പോകുകയില്ല നിർണ്ണയമായ്",
        "മാമക ജീവൻ പോവോളവും",
        "മാ മഹൽസ്നേഹം ഘോഷിക്കും ഞാൻ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "യേശുവിൻ സൗമ്യ ഭാവമെന്നിൽ",
        "എന്നും വിളങ്ങി ശോഭിക്കുവാൻ",
        "എന്നാത്മ ദേഹം ദേഹിയേയും",
        "മുറ്റും സമർപ്പിച്ചിടുന്നു ഞാൻ"
      ]
    }
  ],
