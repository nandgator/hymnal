{
  "number": 1365,
  "title": "യീശു മേരേ പ്രാണ് കേ മീത്",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യീശു മേരേ പ്രാണ് കേ മീത്",
        "ജബ് തക് ജഗ് മെം രഹതാ ഹൂം",
        "ദുഃഖ് നിരന്തർ ആതേ ഹേ",
        "തേരി ശരണ് ആതാ ഹൂം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ജബ് തക് ആംധീ ചല്തി ഹോ",
        "മുഝ്കോ അപ്നേ മെം ഛുപാ",
        "അന്ത് മെം മേരീ ആത്മാകോ",
        "അപ്നേ പാസ് വിശ്രാമ് ദിലാ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ഔർ കോഈ ശരണ് നഹീം",
        "പ്രാണോം കാ തൂ ഹീ ആധാർ",
        "മുഝ്കോ തു കഭീ ന ഛോഡ്",
        "ദേ സഹാരാ ലേ ഉബാർ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "തുഝ് പർ ഹീ മേരാ വിശ്വാസ്",
        "തൂ ഹീ ഏക് സഹായക് ഹേ",
        "അപ്നേ പംഖോം മെം ഛുപാ",
        "മേം നിർബൽ തു ബല് വന്ത് ഹേ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
    {
      "partId": "s2"
    },
