{
  "number": 1539,
  "title": "കണ്ടു ഞാൻ കാൽവറിയിൽ",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "കണ്ടു ഞാൻ കാൽവറിയിൽ",
        "നാഥൻറ രൂപം",
        "കണ്ടു ഞാൻ ക്രൂശതിൽ",
        "ആ ദിവ്യ സ്നേഹം",
        "കാരിരുമ്പാണിയാൽ",
        "കൈകാൽ തുളച്ചൊരാ",
        "കാഠിനഹൃദയരെ സ്നേഹിച്ച സ്നേഹം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "തളളിപ്പറഞ്ഞൊരാ",
        "കള്ളനെപ്പോലും",
        "തൻ മകനാക്കിയ",
        "സ്നേഹമെന്താശ്ചര്യം",
        "കളളം നിറഞ്ഞ എൻ",
        "ഉള്ളിലും വന്നതാൽ",
        "കൺകൾ നിറയുന്നു",
        "നന്ദിയാലേറ്റവും"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വർണ്ണ്യമോ നാഥനെൻ",
        "പാപത്തിൻ ഭാരമാം",
        "വൻ കുരിശേന്തുന്നു",
        "കാൽവറി മേടതിൽ",
        "വീണൊഴുകുന്നിതാ",
        "ചോരയിൻ ചാലുകൾ",
        "വാഴ്തിനായി ഞാൻ",
        "സ്വർഗീയ തേജസ്സിൽ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "പാരം തകർന്നുപോയ്",
        "പാവനനേശു താൻ",
        "പാരിതിൽ പാപിയെൻ",
        "പാതകമേറ്റതാൽ",
        "പ്രാണൻ വെടിഞ്ഞയ്യോ",
        "പ്രാണിയെൻ പേർക്കായ്",
        "പ്രാണപ്രിയനെ ഞാൻ",
        "പാടി സ്തുതിച്ചിടും"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    },
