{
  "number": 832,
  "title": "എന്റെ ജീവനാം യേശുവേ!",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "എന്റെ ജീവനാം യേശുവേ!",
        "നിന്റെ തിരുരക്തം കൊണ്ടു",
        "വീണ്ടെടുത്ത ഈ നിൻ വിശ്വാസിയെ",
        "നീ കാക്കേണമേ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ശിഷ്ടമാം നാളുകളിൽ നിൻ",
        "ഇഷ്ടത്തിനു ഞാൻ ജീവിപ്പാൻ",
        "ദുഷ്ടന്മാരിൻ ആലോചനയ്ക്കെന്നെ",
        "ഏൽപ്പിക്കരുതേ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "ലോകം തൻ വൻമായകളാൽ",
        "ആകർഷിപ്പാൻ അടുക്കുമ്പോൾ",
        "ഏകാഗ്രതയോടു എൻ മാനസം",
        "കാത്തിടണമേ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ജഡബലഹീനതയിൽ",
        "വിടരുതേ ദാസനെ നീ",
        "ഇടവിടാതുണർന്നു പ്രാർത്ഥിപ്പാൻ",
        "തുണയ്ക്കേണമേ"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "തീയമ്പുകളെ എന്റെ മേൽ",
        "എയ്യുമ്പോൾ പിശാചായവൻ",
        "നീയൻപോടു നിൻ ചിറകിൻ കീഴിൽ",
        "മറയ്ക്കയെന്നെ"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "എല്ലാ ആകുല ചിന്തയും വല്ലഭനാം",
        "നിന്മേലാക്കി",
        "നല്ലപോർ വിശ്വാസത്തിൽ",
        "പൊരുതാൻ സഹായിക്കുകേ"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "പരമാർത്ഥമറിയാത്ത നരരെന്നെ",
        "ഞെരുക്കുമ്പോൾ",
        "ശരണം നീ ആകയെൻ യേശുവേ!",
        "നിൻ സാധുവിന്നു"
      ]
    },
    {
      "id": "s8",
      "kind": "stanza",
      "label": "8",
      "lines": [
        "സ്വർണ്ണം തീയിൽ സ്ഫുടം ചെയ്യും",
        "വണ്ണം നീ പരീക്ഷിക്കുമ്പോൾ",
        "പൂർണ്ണമാം വിശ്വാസവും",
        "ക്ഷമയും നൽകിടേണമേ"
      ]
    },
    {
      "id": "s9",
      "kind": "stanza",
      "label": "9",
      "lines": [
        "ഹൃദയമാം ആലയത്തിൽ",
        "അമൃതമാം നിൻ സ്നേഹത്തിൻ",
        "മൃദുസ്വരം കർത്താ സദാ എന്നെ",
        "കേൾപ്പിക്കേണമേ"
      ]
    },
    {
      "id": "s10",
      "kind": "stanza",
      "label": "10",
      "lines": [
        "മരുഭൂമിയിൽ നാൾക്കുനാൾ",
        "കരുണയിൻ സമ്പന്നനേ!",
        "അരുൾക നിൻ മന്നയും വെളളവും",
        "എൻ ആത്മാവിന്നു"
      ]
    },
    {
      "id": "s11",
      "kind": "stanza",
      "label": "11",
      "lines": [
        "മരണം വരെ എനിക്കു",
        "തരണം നൽ വിശ്വസ്തത",
        "ശരണം അപ്പോൾ അടിയാനു താ",
        "നിൻ മാർവ്വിടത്തിൽ"
      ]
    }
  ],
