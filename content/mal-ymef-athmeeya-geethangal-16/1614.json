{
  "number": 1614,
  "title": "സ്നേഹം പകരുന്ന നൽ പുഷ്മായ്‌",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "സ്നേഹം പകരുന്ന നൽ പുഷ്മായ്‌",
        "വിടരട്ടെ ഇവർ ജീവിതം",
        "ഇമ്പം മീട്ടുന്ന നവീണയായ്",
        "വാഴട്ടെ ഇവരെന്നും"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ഭൂമിയിൽ സ്വർഗ്ഗം വിരിയും പോലെ",
        "ഇവരുടെ ജീവിതമാകണമെന്നും",
        "സന്തോഷത്താൽ കവിയും സ്ത്രോത്രം",
        "ഓ കേട്ടു സ്വർഗ്ഗം നിറയണം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ക്രിസ്തുവും സഭയും വാഴും പോലെ",
        "ഇവരുടെ ജീവിതമാകണമെന്നും",
        "സ്വാർത്ഥതയെന്യേ പകരും സ്നേഹം",
        "ഓ കണ്ടു ലോകം വാഴ്ത്തണം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "പ്രിസ്കയും അക്വിലാവും പോലെ",
        "ഇവരുടെ ജീവിതമാകണമെന്നും",
        "സുവിശേഷത്തിൻ മംഗളനാദം",
        "ഓ ഇവരിൽ നിന്നും ഉയരണം"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "ദൈവികപദ്ധതിയാകും പോലെ",
        "ഇവരുടെ ജീവിതമാകണമെന്നും",
        "ക്രിസ്തുവും തന്നുടെ രാജ്യം നീതിയും",
        "ഓ മുന്നിൽ കാണാൻ കഴിയണം"
      ]
    }
  ],
