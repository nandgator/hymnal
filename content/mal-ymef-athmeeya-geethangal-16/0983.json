{
  "number": 983,
  "title": "ആകാശത്തേരതിൽ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ആകാശത്തേരതിൽ",
        "കർത്തൻ വന്നിടാറായ്",
        "ആത്മനാഥൻ ചാരെ ചേരാൻ നേരമായ്",
        "ആത്മസന്തോഷത്താൽ",
        "പുളകിതരായ് നാം",
        "ആ സുദിനത്തിനായ് കാത്തിരുന്നിടാം"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "ക്ഷാമം മഹാവ്യാധി",
        "ഭൂകമ്പം യുധങ്ങൾ",
        "അടിക്കടി ഭുവിൽ പെരുകിടുമ്പോൾ",
        "നമുക്കുണർന്നിടാം ബലം ധരിച്ചിടാം",
        "ആ സുദിനതിനായ് കാത്തിരുന്നിടാം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഭിന്നത വെടിയാം",
        "നമുക്കൊന്നായ് കൂടാം",
        "ഭയഭക്തിയോടെ ഓട്ടം ഓടിടാം",
        "ആർത്തു പാടി സ്തുതിക്കാം",
        "ഹല്ലേലുയ്യ പാടാം"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "കഷ്ടതയിൻ നാളിൽ",
        "ശോധന വേളയിൽ",
        "കർത്തൻ കൃപ നല്കും അനുദിനവും",
        "കഷ്ടതകൾ തീരും കർത്തൻ",
        "ചാരെ ചേരും"
      ]
    }
  ],
