{
  "number": 107,
  "title": "യേശു നല്ലവൻ അവൻ വല്ലഭൻ",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "ഹാലേലുയ്യ, ഹാലേലുയ്യ",
        "മഹത്വവും ജ്ഞാനവും",
        "സ്തോത്രവും ബഹുമാനം",
        "ശക്തിയും ബലവും",
        "എൻയേശുവിനു"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "യേശു നല്ലവൻ അവൻ വല്ലഭൻ",
        "അവൻ ദയയോ എന്നുമുളളത്",
        "പെരുവെളളത്തിൽ ഇരച്ചിൽ പോലെ",
        "സ്തുതിച്ചിടുക അവന്‍റെ നാമം"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ഞാൻ യഹോവയ്ക്കായ് കാത്തുകാത്തല്ലോ",
        "അവൻ എങ്കലേക്കു ചാഞ്ഞു കേട്ടല്ലോ",
        "നാശകരമായ കുഴിയിൽനിന്നും",
        "കുഴഞ്ഞ ചേറ്റിൽ നിന്നും കയറ്റി"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "എൻ കാലുകളെ പാറമേൽ നിർത്തി",
        "എൻ ഗമനത്തെ സുസ്ഥിരമാക്കി",
        "പുതിയൊരു പാട്ടെനിക്കു തന്നു",
        "എൻ ദൈവത്തിനു സ്തുതിതന്നെ"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "എന്‍റെ കർത്താവേ! എന്‍റെ യഹോവേ!",
        "നീയൊഴികെ എനിക്കൊരു നന്മയുമില്ല",
        "ഭൂമിയിലുളള വിശുദ്ധന്മാരോ",
        "അവർ എനിക്കു ശ്രേഷ്ഠന്മാർ തന്നേ"
      ]
    }
  ],
