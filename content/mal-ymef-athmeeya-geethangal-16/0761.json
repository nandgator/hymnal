{
  "number": 761,
  "title": "വിശുദ്ധർകൂട്ടം രക്ഷകന്നു ചുറ്റും",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "വിശുദ്ധർകൂട്ടം രക്ഷകന്നു ചുറ്റും",
        "നിന്നു തങ്ങൾ സ്നേഹരത്നം ചൂടിക്കും",
        "നേരം ആ മഹാസന്തോഷസമൂഹേ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ദൈവം തൻവിശുദ്ധർ കണ്ണുനീരെല്ലാം",
        "തുടയ്ക്കും അന്നാളിൽ",
        "എനിക്കിഷ്ടരാം ചേർക്കപ്പെട്ട",
        "വിശുദ്ധരോടുകൂടെ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "വീണകളെ ധരിച്ചുടൻ തൻമുമ്പിൽ",
        "സന്തോഷപരിപൂർണ്ണരായ് ഉച്ചത്തിൽ",
        "തന്നെ എന്നും സ്തുതിക്കുന്നവരോടെ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s4",
      "kind": "stanza",
      "label": "4",
      "lines": [
        "കുഞ്ഞാടിൻ രക്തത്തിൽ കഴുകപ്പെട്ടു",
        "വെളളനിലയങ്കികളെ ധരിച്ചു",
        "മഹാശോഭിതമായുളള സമൂഹേ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s5",
      "kind": "stanza",
      "label": "5",
      "lines": [
        "കൈയിൽ കുരുത്തോലകളെ പിടിച്ചും",
        "മഹാരക്ഷ നമ്മുടെ ദൈവത്തിന്നും",
        "കൂഞ്ഞാട്ടിന്നും എന്നാർക്കും കൂട്ടരോടേ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s6",
      "kind": "stanza",
      "label": "6",
      "lines": [
        "സ്തുതി മഹത്വം ജ്ഞാനം",
        "ശക്തി സ്തോത്രം",
        "നമ്മുടെ ദേവനെന്നെല്ലാ ദൂതരും",
        "തൻമുമ്പിൽ കവിണ്ണുവീണാർക്കും കാലേ",
        "നിന്നെയും കാണുമോ?...",
        "ചൊല്ലെൻ പ്രിയനേ!"
      ]
    },
    {
      "id": "s7",
      "kind": "stanza",
      "label": "7",
      "lines": [
        "മരണത്തോളം നീ വിശ്വസ്തനായാൽ",
        "തൻ ചൊല്ലോർത്തു പ്രയാസം നീ സഹിച്ചാൽ",
        "കൂടെയിരുത്തും താൻ നിന്നെ അപ്പോഴേ",
        "തൻ വാക്കിന്നും ഭംഗം ഉണ്ടോ പ്രിയനേ?"
      ]
    }
  ],
