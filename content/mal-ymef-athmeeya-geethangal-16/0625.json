{
  "number": 625,
  "title": "നീ കരുതുകയാലൊരുവിധവും",
  "parts": [
    {
      "id": "r",
      "kind": "refrain",
      "lines": [
        "നീ കരുതുകയാലൊരുവിധവും",
        "പരിതാപമില്ല പരാ!",
        "നിൻതുണയല്ലോ തണലല്ലോ",
        "നീളെയെനിക്കഭയം...നീ"
      ]
    },
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "മനം കനിഞ്ഞെനിക്കായ്",
        "നിണം ചിന്തുകയായ്",
        "നീ കാൽവറിക്കുരിശിൽ",
        "എനിക്കൊരുവിടുതൽ",
        "ലഭിച്ചുനിൻകരുതൽ",
        "കണ്ടാശ്വസിപ്പാനായ്",
        "കൃപയരുളിയത് മറന്നിടുമോ?",
        "മാറാത്ത മഹൽ സ്നേഹം - നിൻതുണ"
      ]
    },
    {
      "id": "s2",
      "kind": "stanza",
      "label": "2",
      "lines": [
        "ധനം കുറഞ്ഞിരിക്കും",
        "മനം തളർന്നിരിക്കും",
        "ആ നേരമെൻനേരേ",
        "തവ മിഴി തിരിക്കും",
        "തിരുമൊഴിയുരയ്ക്കും",
        "സന്താപവും തീരെ",
        "മമ കരുമനയിന്നരികണയാനാ -",
        "രോമൽ സ്നേഹിതനാം - നിൻതുണ"
      ]
    },
    {
      "id": "s3",
      "kind": "stanza",
      "label": "3",
      "lines": [
        "അമിതമായ് കരുത്തുളള -",
        "മലൻ നീ വരുത്തു",
        "ന്നെൻ കാലുകൾക്കുറപ്പ്",
        "മഹിമയിൽ നിറുത്തു",
        "ന്നതുവരെ നടത്തും",
        "വീഴാതെ നീ കാത്ത്",
        "നൽവഴി നിരത്തും അതിൽ നടത്തും",
        "എൻഭീതിയുമകറ്റും - നിൻതുണ"
      ]
    }
  ],
