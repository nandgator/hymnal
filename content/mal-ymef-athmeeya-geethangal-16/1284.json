{
  "number": 1284,
  "title": "അങ്ങും ഇങ്ങും പോകാ -",
  "parts": [
    {
      "id": "s1",
      "kind": "stanza",
      "label": "1",
      "lines": [
        "അങ്ങും ഇങ്ങും പോകാ -",
        "തൊന്നിച്ചോന്നായ്‌ കൂടാം",
        "സ്നേഹത്തിന്‍ ഗാനങ്ങള്‍",
        "പാടാം കൂട്ടുകാരെ",
        "മാതാപിതാഗുരു നാട്ടുകാര്‍ക്കുമെല്ലാം",
        "നല്ലമക്കളായ്‌ തീരം കൂട്ടുകാരേ",
        "ദൈവഭയം വേണം",
        "ജ്ഞാനം പ്രാപിക്കേണം",
        "നാടിന്‍ കാവൽക്കാരായ്",
        "പോകാം കൂട്ടുകാരേ"
      ]
    }
  ],
  "sequence": [
    {
      "partId": "s1"
    }
  ],
  "meta": {
    "author": "VT"
  }
}
