{
  // Markdown linting only. Formatting is prettier's job; see .prettierrc.
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/refs/heads/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "code-block-style": {
      "style": "fenced"
    },
    "default": true,
    "first-line-heading": false,
    "line-length": {
      "tables": false
    },
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-inline-html": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "target/**",
    "db/**",
    ".svelte-kit/**",
    "**/CHANGELOG.md"
  ]
}
